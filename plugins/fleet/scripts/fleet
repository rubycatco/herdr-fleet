#!/usr/bin/env python3
"""fleet: helper CLI for the `fleet` Claude Code plugin.

Runs coding-agent lanes in Herdr panes. remuda is optional. Without it, every
lane uses the agent's own login (the caller's CLAUDE_CONFIG_DIR / CODEX_HOME
when set) and there is no account switching.

Commands:
  fleet doctor [--json]                   check the environment (onboarding)
  fleet conventions [--path]              the user's fleet conventions (or the plugin defaults)
  fleet accounts [--live]                 remuda accounts and usage (cached unless --live)
  fleet prep [DIR] [--handoff]            create <git top>/.fleet and keep it out of git
  fleet worktree BRANCH [--base REF]      herdr worktree + workspace for a lane, .fleet/ ready
  fleet spawn [options] [-- ARGS...]      open a pane and start an agent in it (an implementer waits for an
                                          approved .fleet/PLAN.md when the lane has one)
  fleet send PANE (--text T | --file F)   submit a prompt to an agent and verify it landed
  fleet watch PANE [--marker M]           wait for a file marker, or for the agent to stop or block
  fleet reset PANE [--compact [FOCUS]]    /clear (or /compact) a claude lane, then resume it
  fleet status [--workspace W] [--json]   agent panes with role, account, branch and lane files
  fleet retire PANE [--close]             exit the agent in PANE (never the calling pane)
  fleet sweep [--json]                    every lane with a cleanup verdict: ready, waiting or keep (reads only)
  fleet cleanup TARGET... [--unmerged]    remove lanes: exit agents, archive .fleet/, remove the worktree,
                                          delete the local branch when its merge holds every commit
  fleet log [PROJECT] [--sessions]        the project's event log, or its agent sessions (reads only)
  fleet orch [show|claim|release]         the project's orchestrator pane, in its project home
  fleet board [--json]                    one row per lane of this project, with its phase
  fleet digest [--peek] [--json]          phase changes and events since the last digest
  fleet follow-up list|add|take|release|done
                                          the project's follow-ups in PROJECT.md, with IDs and lane marks
  fleet approve-plan [DIR] --by orch|user approve the lane's .fleet/PLAN.md (refuses on changes or a risk;
                                          high-risk paths under ## Files need the user)
  fleet risk [DIR] [--json]               the lane's changed paths that match a high-risk pattern (reads only)
  fleet approve-risk [DIR] --by user      record the user's yes for them in .fleet/RISK.md
  fleet hook session-start|session-end    hooks: record fleet sessions; re-brief the orch, and a lane after /clear

Python 3.8+, standard library only.
"""

from __future__ import annotations

import argparse
import fcntl
import glob
import itertools
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import textwrap
import time
import uuid
from concurrent.futures import ThreadPoolExecutor
from contextlib import ExitStack, contextmanager, nullcontext
from datetime import datetime
from pathlib import Path

# The hooks count their git deadline from here, the first moment the script can read a clock. The start of the
# interpreter and the compiling of this file come before it; HOOK_BEFORE_CLOCK allows for them.
HOOK_STARTED = time.monotonic()

VERSION = "0.9.1"
PLUGIN_ROOT = Path(__file__).resolve().parent.parent
FLEET_DIR = ".fleet"
LANE_FILES = ("BRIEF.md", "STATUS.md", "HANDOFF.md", "PLAN.md")
ORCHESTRATOR_FILE = "FLEET.md"
PANES_FILE = "panes.json"  # pane id -> role record, written by `fleet spawn --role`
ROLES = ("impl", "critic", "orchestrator", "helper", "planner", "researcher")
TASK_ROLES = ("researcher", "helper")  # the roles whose re-brief points at their --task file
ORCHESTRATOR_LINE = re.compile(r"^\s*Orchestrator:\s*pane\s+([A-Za-z0-9]+:[A-Za-z0-9]+)", re.M)
SESSION_ID = re.compile(r"[0-9A-Za-z-]{8,64}")
PROMPT_MAX = 500  # longer text, or any newline, is written to a file and sent as a pointer
AGENTS = ("claude", "codex")
EXIT_COMMAND = {"claude": "/exit", "codex": "/quit"}
COMPOSER_MARK = {"claude": "❯", "codex": "›"}
REPLY_MARKS = ("⏺", "•")

# Dialogs that block a freshly started agent.
TRUST_DIALOG = re.compile(
    r"Yes, I trust this folder|Do you trust the files in this folder|"
    r"allow Codex to work in this folder|Do you trust the contents of this directory|"
    r"Trust this folder\?|Trust and continue",
    re.I,
)
TRUST_ACCEPT = re.compile(
    r"Yes, I trust this folder|Yes, allow Codex|Trust and continue|^\s*(?:[❯›>]\s*)?(?:\d+\.\s*)?Yes\b", re.I)
# A highlighted, numbered menu option: some dialog is open, even one that this file does not know.
MENU_SELECTED = re.compile(r"^\s*[❯›>]\s*\d+\.\s+\S.*$", re.M)
FULLSCREEN_PROMPT = re.compile(r"fullscreen renderer", re.I)
CODEX_UPDATE_MENU = re.compile(r"Update now", re.I)
CODEX_UPDATE_SKIP = re.compile(r"^\s*(?:[❯›>]\s*)?(?:\d+\.\s*)?Skip\b", re.I)


class FleetError(Exception):
    def __init__(self, message: str, code: int = 1):
        super().__init__(message)
        self.code = code


# --------------------------------------------------------------------------
# Process helpers


def run(cmd: list[str], timeout: float = 30, input_text: str | None = None,
        env: dict | None = None, cwd: str | None = None) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, input=input_text, env=env,
                              cwd=cwd)
    except FileNotFoundError:
        if cwd and not os.path.isdir(cwd):
            raise FleetError(f"no such directory: {cwd}")
        raise FleetError(f"{cmd[0]}: command not found")
    except subprocess.TimeoutExpired:
        raise FleetError(f"timed out after {timeout:g}s: {shlex.join(cmd)}")


def first_line(text: str) -> str:
    for line in (text or "").splitlines():
        if line.strip():
            return line.strip()
    return ""


def tool_version(path: str | None, args: tuple[str, ...] = ("--version",)) -> str | None:
    if not path:
        return None
    try:
        cp = run([path, *args], timeout=10)
    except FleetError:
        return None
    return first_line(cp.stdout or cp.stderr) or None


# --------------------------------------------------------------------------
# Herdr


def require_herdr() -> None:
    if os.environ.get("HERDR_ENV") != "1":
        raise FleetError("not running inside a Herdr pane (HERDR_ENV is not 1)")
    if not shutil.which("herdr"):
        raise FleetError("herdr not found in PATH")


def herdr(*args: str, timeout: float = 30) -> dict:
    cp = run(["herdr", *args], timeout=timeout)
    out = (cp.stdout or "").strip()
    if cp.returncode != 0:
        detail = (cp.stderr or out).strip()
        raise FleetError(f"herdr {' '.join(args[:2])} failed: {detail[:400]}")
    try:
        data = json.loads(out)
    except json.JSONDecodeError:
        raise FleetError(f"herdr {' '.join(args[:2])}: expected JSON, got: {out[:200]}")
    if isinstance(data, dict) and data.get("error"):
        raise FleetError(f"herdr {' '.join(args[:2])}: {data['error']}")
    return data.get("result", data) if isinstance(data, dict) else data


def herdr_ok(*args: str, timeout: float = 30) -> bool:
    try:
        return run(["herdr", *args], timeout=timeout).returncode == 0
    except FleetError:
        return False


def pane_info(pane: str) -> dict:
    return herdr("pane", "get", pane)["pane"]


def find_pane_id(result: dict) -> str:
    for key in ("pane", "root_pane"):
        if isinstance(result.get(key), dict) and result[key].get("pane_id"):
            return result[key]["pane_id"]
    raise FleetError(f"no pane id in herdr response: {json.dumps(result)[:300]}")


def pane_lines(pane: str, rows: int | None = None, extra: int = 200) -> list[str]:
    """Non-empty, non-rule lines of the pane's recent scrollback.

    A TUI pads its viewport with blank rows, so read viewport_rows + extra
    lines and drop the padding; a short read returns only blank padding.
    """
    if rows is None:
        rows = pane_info(pane).get("scroll", {}).get("viewport_rows", 120)
    cp = run(["herdr", "pane", "read", pane, "--source", "recent-unwrapped", "--lines", str(int(rows) + extra)])
    if cp.returncode != 0:
        raise FleetError(f"herdr pane read failed: {(cp.stderr or cp.stdout).strip()[:300]}")
    return clean_lines(cp.stdout)


def clean_lines(text: str) -> list[str]:
    lines = []
    for raw in (text or "").splitlines():
        line = raw.rstrip()
        stripped = line.strip()
        if not stripped or re.fullmatch(r"[─━═\-]+", stripped):
            continue
        lines.append(line)
    return lines


def send_keys(pane: str, *keys: str) -> None:
    run(["herdr", "pane", "send-keys", pane, *keys])


def auto_direction(rect: dict) -> str:
    """Split a visually wide pane to the right and a tall one down.

    Terminal cells are about twice as tall as they are wide.
    """
    width, height = rect.get("width", 0), rect.get("height", 0)
    return "right" if width >= 2 * height else "down"


def pane_rect(pane: str) -> dict:
    layout = herdr("pane", "layout", "--pane", pane)["layout"]
    for p in layout.get("panes", []):
        if p.get("pane_id") == pane:
            return p.get("rect", {})
    return {}


# --------------------------------------------------------------------------
# Accounts (remuda is optional)


def remuda_path() -> str | None:
    if os.environ.get("FLEET_NO_REMUDA") == "1":
        return None
    return shutil.which("remuda")


def parse_remuda_list(text: str) -> list[dict]:
    """Parse `remuda list` (columns ACCOUNT EMAIL ORG PLAN HOME, 2+ spaces apart)."""
    accounts = []
    for line in (text or "").splitlines():
        if not line.strip() or line.lstrip().startswith("ACCOUNT"):
            continue
        cols = re.split(r"\s{2,}", line.strip())
        if not cols or ":" not in cols[0]:
            continue
        provider, name = cols[0].split(":", 1)
        accounts.append({
            "account": cols[0],
            "provider": provider,
            "name": name,
            "email": cols[1] if len(cols) > 1 else "",
            "plan": cols[3] if len(cols) > 4 else "",
            "home": cols[-1] if len(cols) > 1 else "",
        })
    return accounts


def remuda_accounts(remuda: str) -> list[dict]:
    cp = run([remuda, "list"], timeout=20)
    if cp.returncode != 0:
        raise FleetError(f"remuda list failed: {(cp.stderr or cp.stdout).strip()[:300]}")
    return parse_remuda_list(cp.stdout)


def resolve_account(account: str, agent: str | None, accounts: list[dict]) -> dict:
    """Map a user-facing account name to one remuda account row."""
    if ":" in account:
        matches = [a for a in accounts if a["account"] == account]
    else:
        matches = [a for a in accounts if a["name"] == account]
        if agent:
            matches = [a for a in matches if a["provider"] == agent]
    if agent:
        wrong = [a for a in matches if a["provider"] != agent]
        if wrong:
            raise FleetError(f"account {account} is a {wrong[0]['provider']} account, not {agent}")
    if not matches:
        known = ", ".join(a["account"] for a in accounts) or "none"
        raise FleetError(f"no remuda account named {account} (known: {known})")
    if len(matches) > 1:
        names = ", ".join(a["account"] for a in matches)
        raise FleetError(f"account {account} is ambiguous ({names}); pass --agent or a provider-qualified name")
    return matches[0]


DEFAULT_HOME = {"claude": "~/.claude", "codex": "~/.codex"}
HOME_VAR = {"claude": "CLAUDE_CONFIG_DIR", "codex": "CODEX_HOME"}


def account_home(agent: str, row: dict | None) -> str:
    """Config dir of a remuda account row ("default" means the agent's own default dir)."""
    if row and row.get("home") and row["home"] != "default":
        return os.path.expanduser(row["home"])
    return os.path.expanduser(DEFAULT_HOME[agent])


def default_agent(account: str | None, accounts: list[dict] | None) -> str:
    """The agent an account name implies: its provider when only one has it, else claude."""
    if account and accounts:
        providers = {a["provider"] for a in accounts if account in (a["account"], a["name"])}
        if len(providers) == 1:
            return providers.pop()
    return "claude"


def home_matches(home: str, env_dir: str | None) -> bool:
    if home == "default":
        return not env_dir
    if not env_dir:
        return False
    try:
        return os.path.realpath(os.path.expanduser(home)) == os.path.realpath(os.path.expanduser(env_dir))
    except OSError:
        return False


def caller_account(agent: str, accounts: list[dict], env: dict) -> dict | None:
    env_dir = env.get("CLAUDE_CONFIG_DIR") if agent == "claude" else env.get("CODEX_HOME")
    for a in accounts:
        if a["provider"] == agent and home_matches(a["home"], env_dir):
            return a
    return None


EFFORT_WORD = re.compile(r"[a-z]+")


def agent_args(agent: str, model: str | None, permission_mode: str | None, name: str | None, extra: list[str],
               effort: str | None = None) -> list[str]:
    args: list[str] = []
    if model:
        args += ["--model", model]
    if effort:
        if not EFFORT_WORD.fullmatch(effort):
            raise FleetError(f"--effort takes one lowercase word such as high or max, not {effort!r}")
        if agent == "claude":
            args += ["--effort", effort]
        else:
            # Codex has no effort flag; a config override sets it for this session.
            args += ["-c", f'model_reasoning_effort="{effort}"']
    if permission_mode:
        if agent != "claude":
            raise FleetError("--permission-mode applies to claude only; pass codex approval flags after --")
        args += ["--permission-mode", permission_mode]
    if name and agent == "claude":
        args += ["-n", name]
    return args + list(extra)


def build_launch(agent: str, account: str | None, model: str | None, permission_mode: str | None,
                 name: str | None, prompt: str | None, extra: list[str],
                 remuda: str | None, accounts: list[dict] | None, env: dict, effort: str | None = None) -> dict:
    """Return the shell command that starts the agent, and how its account was chosen."""
    if agent not in AGENTS:
        raise FleetError(f"--agent must be one of {', '.join(AGENTS)}")
    args = agent_args(agent, model, permission_mode, name, extra, effort)
    tail = [prompt] if prompt else []
    var = HOME_VAR[agent]
    if not remuda:
        if account:
            raise FleetError("accounts need remuda; remuda is not installed (or FLEET_NO_REMUDA=1)")
        # Same login as the caller: carry its config dir, if it set one. An
        # assignment word must stay unquoted, so quote the value alone.
        prefix = f"{var}={shlex.quote(env[var])} " if env.get(var) else ""
        command = prefix + shlex.join([agent, *args, *tail])
        home = os.path.expanduser(env.get(var) or DEFAULT_HOME[agent])
        return {"command": command, "account": None, "account_source": "plain", "agent": agent, "home": home}
    accounts = accounts or []
    if account:
        row = resolve_account(account, agent, accounts)
        source = "explicit"
    else:
        row = caller_account(agent, accounts, env)
        source = "caller"
    if not row:
        # A new pane does not inherit the caller's config dir: bare agent = default login.
        return {"command": shlex.join([agent, *args, *tail]), "account": None,
                "account_source": "agent default", "agent": agent, "home": account_home(agent, None)}
    argv = [remuda, "run", row["account"], *args, *tail]
    return {"command": shlex.join(argv), "account": row["account"], "account_source": source, "agent": agent,
            "home": account_home(agent, row)}


def transcript_visible(home: str, session_id: str) -> bool:
    """True when a claude config dir holds the transcript of `session_id`."""
    pattern = os.path.join(glob.escape(os.path.expanduser(home)), "projects", "*", f"{glob.escape(session_id)}.jsonl")
    return bool(glob.glob(pattern))


# --------------------------------------------------------------------------
# Pane screen analysis


def composer_index(lines: list[str], agent: str) -> int | None:
    """Index of the agent's input line: the last line that starts with its prompt mark."""
    mark = COMPOSER_MARK.get(agent, "❯")
    start = max(0, len(lines) - 30)
    for i in range(len(lines) - 1, start - 1, -1):
        if lines[i].lstrip().startswith(mark):
            return i
    return None


def composer_line(lines: list[str], agent: str) -> str | None:
    """Text in the agent's input line (empty when the composer is empty)."""
    i = composer_index(lines, agent)
    if i is None:
        return None
    mark = COMPOSER_MARK.get(agent, "❯")
    return lines[i].strip()[len(mark):].strip()


def text_head(text: str, size: int = 32) -> str:
    return re.sub(r"\s+", " ", first_line(text))[:size]


def submitted_count(lines: list[str], head: str, agent: str) -> int:
    """How often the prompt's first words show above the composer (that is, as sent messages)."""
    if not head:
        return 0
    end = composer_index(lines, agent)
    if end is None:
        return 0
    return sum(1 for line in lines[:end] if head in re.sub(r"\s+", " ", line))


def selected_line(lines: list[str]) -> int | None:
    for i in range(len(lines) - 1, -1, -1):
        if re.match(r"^\s*[❯›>]\s+\S", lines[i]):
            return i
    return None


def choose_option(pane: str, target: re.Pattern, max_steps: int = 6) -> bool:
    """Move a TUI menu's highlight to the first option matching `target`, then press Enter.

    Menus sit at the bottom of the screen; look at the last lines only, so a
    `❯ prompt` line in the history is never taken for the highlight.
    """
    for _ in range(max_steps + 1):
        lines = pane_lines(pane)[-20:]
        sel = selected_line(lines)
        if sel is None:
            return False
        if target.search(lines[sel]):
            send_keys(pane, "Enter")
            return True
        hits = [i for i, l in enumerate(lines) if target.search(l)]
        if not hits:
            return False
        send_keys(pane, "Down" if hits[0] > sel else "Up")
        time.sleep(0.4)
    return False


# --------------------------------------------------------------------------
# worktree / spawn


def caller_orch(path: str | None, name: str | None = None, create: bool = False) -> tuple[Path | None, str | None]:
    """(the project home of the checkout `path`, the caller's orch there: current_orch, with `name` from --orch).
    (None, None) outside a project; a `name` that the project does not have raises."""
    home = project_for(path, create=create) if path else None
    if name and not home:
        raise FleetError(f"--orch {name}: {path} is in no fleet project")
    return home, (current_orch(home, name)[0] if home else None)


def create_worktree(branch: str, base: str | None, repo: str | None, label: str | None,
                    orch: str | None = None) -> dict:
    """herdr worktree create: a linked worktree in its own workspace, with a shell pane, and .fleet/lane.json naming
    the caller's orch in the repository's project (`orch`: --orch; null for a caller that is no orch)."""
    repo = repo or git_toplevel(os.getcwd()) or os.getcwd()
    home, owner = caller_orch(repo, orch, create=True)  # before anything is created: an unknown --orch refuses
    cmd = ["worktree", "create", "--cwd", repo, "--branch", branch, "--no-focus"]
    if base:
        cmd += ["--base", base]
    if label:
        cmd += ["--label", label]
    result = herdr(*cmd, timeout=120)
    path = (result.get("worktree") or {}).get("path") or (result.get("root_pane") or {}).get("cwd")
    out = {"pane_id": find_pane_id(result), "tab_id": (result.get("tab") or {}).get("tab_id"),
           "workspace_id": (result.get("workspace") or {}).get("workspace_id"),
           "cwd": path, "branch": branch, "placement": f"worktree {branch}"}
    if path:
        out["lane_json"] = write_lane_owner(path, home, owner, os.environ.get("HERDR_PANE_ID"))
        out["orch"] = owner
    record("worktree", path, lane=path, branch=branch, base=base, label=label, workspace=out["workspace_id"],
           pane=out["pane_id"], orch=owner)
    return out


def cmd_worktree(args: argparse.Namespace) -> int:
    require_herdr()
    target = create_worktree(args.branch, args.base, args.repo, args.name, args.orch)
    prep = prep_dir(target["cwd"])
    print(json.dumps({"ok": True, **target, **prep}, indent=2, ensure_ascii=False))
    return 0


def target_cwd(args: argparse.Namespace, info: dict | None = None) -> str | None:
    """The directory that `create_pane` will start the agent in, found before anything is created; None for a
    new worktree (it has no lane files yet) and for a split with no pane to split (`create_pane` refuses it).
    `info`: the existing pane's `pane_info`, read once by the caller."""
    if args.pane:
        return (info if info is not None else pane_info(args.pane)).get("cwd")
    if args.worktree:
        return None
    cwd = os.path.abspath(os.path.expanduser(args.cwd or os.getcwd()))
    if args.tab or args.new_workspace or args.cwd:
        return cwd
    source = args.from_pane or os.environ.get("HERDR_PANE_ID")
    if not source:
        return None
    # A split works where the pane it splits works (a critic next to its lane).
    return pane_info(source).get("cwd") or cwd


GATED_ROLES = ("impl", None)  # the roles that wait for an approved plan; the board counts no role as the implementer


def plan_gate(cwd: str | None) -> tuple[str | None, Path | None, int | None]:
    """(why an implementer may not start in `cwd` yet, the PLAN.md, its newest ready round). The reason is None
    when the checkout has no .fleet/PLAN.md, or when the newest `PLAN READY: <n>` round has its
    `PLAN APPROVED: <n>` line."""
    if not cwd or not os.path.isdir(cwd):
        return None, None, None
    top = git_toplevel(cwd)
    if not top:
        # Not a git checkout, or git failed. A PLAN.md at or above cwd means a lane: fail closed.
        for d in (Path(cwd), *Path(cwd).parents):
            if (d / FLEET_DIR / PLAN_FILE).is_file():
                return (f"git cannot tell the checkout of {cwd}, and {d / FLEET_DIR / PLAN_FILE} exists, so the plan "
                        "gate cannot be checked"), d / FLEET_DIR / PLAN_FILE, None
        return None, None, None
    plan = Path(top) / FLEET_DIR / PLAN_FILE
    if not plan.is_file():
        return None, None, None
    ready, approved = plan_rounds(read_text(plan))
    if not ready:
        return (f"{plan} has no PLAN READY line: the planner has not finished, so no implementer starts. Approve "
                "the plan first, or remove PLAN.md on purpose"), plan, None
    n = max(ready)
    if n not in approved:
        return (f"round {n} of {plan} is not approved: run approve-plan (the user approves a high-risk plan) "
                "before an implementer starts, or remove PLAN.md on purpose"), plan, n
    return None, plan, n


def create_pane(args: argparse.Namespace, cwd: str | None = None, info: dict | None = None) -> dict:
    """Create the pane the agent will run in. Returns ids and cwd. `cwd` is the directory that `target_cwd`
    found (and the plan gate checked): the returned cwd, also for an existing pane. `info` is that pane's
    snapshot, so that the pane is read once: the gate, the registry and the event use one directory."""
    if args.pane:
        info = info if info is not None else pane_info(args.pane)
        if info.get("agent"):
            raise FleetError(f"pane {args.pane} already runs {info['agent']}; pick a shell pane")
        return {"pane_id": args.pane, "tab_id": info.get("tab_id"), "workspace_id": info.get("workspace_id"),
                "cwd": cwd or info.get("cwd"), "placement": "existing pane"}
    if args.worktree:
        return create_worktree(args.worktree, args.base, args.repo, args.name, getattr(args, "orch", None))
    cwd = cwd or os.path.abspath(os.path.expanduser(args.cwd or os.getcwd()))
    if args.tab:
        cmd = ["tab", "create", "--cwd", cwd, "--no-focus"]
        workspace = args.workspace or os.environ.get("HERDR_WORKSPACE_ID")
        if workspace:
            cmd += ["--workspace", workspace]
        if args.name:
            cmd += ["--label", args.name]
        result = herdr(*cmd)
        return {"pane_id": find_pane_id(result), "tab_id": (result.get("tab") or {}).get("tab_id"),
                "workspace_id": (result.get("tab") or {}).get("workspace_id"), "cwd": cwd, "placement": "new tab"}
    if args.new_workspace:
        cmd = ["workspace", "create", "--cwd", cwd, "--no-focus"]
        if args.name:
            cmd += ["--label", args.name]
        result = herdr(*cmd)
        return {"pane_id": find_pane_id(result), "tab_id": None,
                "workspace_id": (result.get("workspace") or {}).get("workspace_id"), "cwd": cwd,
                "placement": "new workspace"}
    source = args.from_pane or os.environ.get("HERDR_PANE_ID")
    if not source:
        raise FleetError("no pane to split from: pass --from PANE or run inside Herdr")
    direction = args.split
    if direction == "auto":
        direction = auto_direction(pane_rect(source))
    result = herdr("pane", "split", source, "--direction", direction, "--cwd", cwd, "--no-focus")
    pane = find_pane_id(result)
    info = result.get("pane", {})
    return {"pane_id": pane, "tab_id": info.get("tab_id"), "workspace_id": info.get("workspace_id"),
            "cwd": cwd, "placement": f"split {direction} of {source}"}


def wait_for_start(pane: str, agent: str, prompt: str | None, accept_trust: bool, timeout: float) -> dict:
    """Clear first-run dialogs and confirm the agent is ready or working on the prompt."""
    deadline = time.time() + timeout
    notes: list[str] = []
    head = text_head(prompt) if prompt else ""
    idle_since: float | None = None
    nudged = 0
    trust_answered = False
    while time.time() < deadline:
        time.sleep(1.0)
        info = pane_info(pane)
        detected = info.get("agent")
        status = info.get("agent_status")
        if not detected:
            continue
        lines = pane_lines(pane, info.get("scroll", {}).get("viewport_rows"))
        tail = "\n".join(lines[-30:])
        # One answer only: after it, stale dialog text must never send keys
        # into a live composer.
        if (not trust_answered and status in ("blocked", "idle")
                and TRUST_DIALOG.search("\n".join(lines[-15:]))):
            if not accept_trust:
                return {"ok": False, "status": "blocked", "reason": "folder trust dialog; answer it in the pane or rerun with --accept-trust", "notes": notes}
            trust_answered = True
            if choose_option(pane, TRUST_ACCEPT):
                notes.append("accepted the folder trust dialog")
                time.sleep(1.5)
                continue
            return {"ok": False, "status": "blocked", "reason": "could not select the trust option", "notes": notes}
        if FULLSCREEN_PROMPT.search(tail) and status in ("blocked", "idle"):
            send_keys(pane, "Escape")
            notes.append("dismissed the fullscreen renderer prompt")
            time.sleep(1.0)
            continue
        if agent == "codex" and CODEX_UPDATE_MENU.search(tail) and status == "blocked":
            if choose_option(pane, CODEX_UPDATE_SKIP):
                notes.append("skipped the codex update prompt")
                time.sleep(1.5)
                continue
        if status == "blocked":
            idle_since = None
            continue
        menu = MENU_SELECTED.search("\n".join(lines[-15:]))
        if menu and status in ("idle", "done"):
            # The state hook can report idle while a startup dialog waits.
            return {"ok": False, "status": "blocked", "notes": notes,
                    "reason": f"a dialog is open in the pane ({menu.group(0).strip()}); read the pane and answer it"}
        if not prompt:
            if status in ("idle", "done"):
                return {"ok": True, "status": status, "notes": notes}
            continue
        if status == "working":
            return {"ok": True, "status": "working", "notes": notes}
        if status in ("idle", "done"):
            if submitted_count(lines, head, agent) > 0:
                # Above the composer means sent. Claude may already be done;
                # codex sits idle while its MCP servers start, then works.
                return {"ok": True, "status": status, "notes": notes + ["the prompt shows as sent"]}
            idle_since = idle_since or time.time()
            composer = composer_line(lines, agent) or ""
            stuck = "[Pasted text" in composer or (head and head[:20] in composer)
            if stuck and nudged < 2 and time.time() - idle_since > 3:
                send_keys(pane, "Enter")
                nudged += 1
                notes.append("pressed Enter to submit a prompt left in the composer")
                idle_since = None
    return {"ok": False, "status": pane_info(pane).get("agent_status"), "reason": f"agent not ready after {timeout:g}s", "notes": notes}


def adopt_on_spawn(cwd: str, name: str | None) -> dict:
    """At the first spawn into an unowned lane (the top of a linked worktree whose lane.json is missing or names no
    orch), the caller's orch adopts it, whatever the role. A lane of another orch is never taken, and a main checkout
    gets no lane.json. Returns {"adopted": name} when it wrote, {"not_adopted": why} when the project lock stayed
    busy, else {}."""
    if lane_owner(cwd) or not repo_paths(cwd).get("linked"):
        return {}
    home, owner = caller_orch(cwd, name)
    if not owner:
        return {}
    prep = lane_owner_prep(cwd)  # git, before the lock
    # The check and the write are one step under the project lock: another spawn or an adopt may have taken the
    # lane since the read above, and a cleanup may be removing it. Under the lock only lane.json is read and written.
    # A busy project does not fail the spawn: the lane stays unowned, and `fleet adopt` takes it later.
    try:
        with project_lock(home):
            if lane_owner(cwd) or lane_removal(cwd):
                return {}
            write_lane_owner(cwd, home, owner, os.environ.get("HERDR_PANE_ID"), prep)
    except FleetError as e:
        return {"not_adopted": f"{e}; `fleet adopt` takes the lane later"}
    return {"adopted": owner}


def cmd_spawn(args: argparse.Namespace) -> int:
    prompt = args.prompt
    if prompt and (len(prompt) > PROMPT_MAX or "\n" in prompt):
        raise FleetError(f"--prompt must be one line of at most {PROMPT_MAX} characters; write the task to a file and pass a pointer such as 'Read .fleet/BRIEF.md and execute it.'")
    task = None
    if args.task:
        if not args.role:
            raise FleetError("--task needs --role: the task file is kept with the pane's role in .fleet/panes.json")
        task = os.path.abspath(os.path.expanduser(args.task))
        if not os.path.isfile(task):
            raise FleetError(f"--task: no such file: {task}")
    remuda = remuda_path()
    accounts = remuda_accounts(remuda) if remuda else None
    agent = args.agent or default_agent(args.account, accounts)
    extra = list(args.agent_args)
    if args.resume:
        if agent != "claude":
            raise FleetError("--resume works with claude only")
        if not SESSION_ID.fullmatch(args.resume):
            raise FleetError(f"not a session id: {args.resume}")
        # A fork leaves the old transcript alone, so the old session may still
        # be running (a self-handoff) without two writers on one file.
        extra = ["--resume", args.resume, "--fork-session", *extra]
    launch = build_launch(agent, args.account, args.model, args.permission_mode, args.name, prompt,
                          extra, remuda, accounts, dict(os.environ), effort=args.effort)
    if args.resume and not transcript_visible(launch["home"], args.resume):
        who = launch["account"] or launch["home"]
        raise FleetError(f"{who} cannot see session {args.resume} (no transcript under {launch['home']}/projects); "
                         "hand off with a handoff file instead")
    if args.dry_run:
        print(json.dumps({"dry_run": True, **launch, **({"task": task} if task else {})}, indent=2, ensure_ascii=False))
        return 0
    require_herdr()
    info = pane_info(args.pane) if args.pane else None  # one snapshot of an existing pane
    cwd = target_cwd(args, info)
    if args.orch and cwd:
        caller_orch(cwd, args.orch)  # an unknown --orch refuses before anything is created
    top = checkout_top(os.path.abspath(cwd)) if cwd else None
    removing = lane_removal(str(top)) if top else None
    if removing:  # owned or not: no new agent in a lane that a cleanup is removing, before any pane exists
        return refuse(reason=removal_refusal(str(top), removing, "start an agent in"), role=args.role, cwd=cwd)
    if args.role in GATED_ROLES:
        if args.pane and not cwd:
            return refuse(reason=f"herdr reports no directory for pane {args.pane}, so the plan gate cannot be "
                                 "checked; pass a pane that herdr knows, or another placement", role=args.role)
        reason, plan, n = plan_gate(cwd)
        if reason:
            return refuse(reason=reason, role=args.role, cwd=cwd, plan=str(plan), round=n)
    target = create_pane(args, cwd, info)
    pane = target["pane_id"]
    if args.name:
        herdr_ok("pane", "rename", pane, args.name)
    if args.role and target.get("cwd"):
        entry = {"role": args.role, "agent": agent, "account": launch["account"], "label": args.name,
                 "spawned_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "spawned_by": os.environ.get("HERDR_PANE_ID")}
        if task:
            entry["task"] = task
        target["registry"] = register_pane(target["cwd"], pane, entry)
    if target.get("cwd") and not args.worktree:
        target.update(adopt_on_spawn(target["cwd"], args.orch))
    run(["herdr", "pane", "run", pane, launch["command"]])
    # Record the launch now: the wait can take minutes, and the caller can stop the command during it.
    cwd = target.get("cwd")
    where = {"pane": pane, "workspace": target.get("workspace_id"), "cwd": cwd,
             "branch": (git_branch(cwd) or None) if cwd else None, "agent": agent, "role": args.role}
    owner = lane_owner(cwd) if cwd else None
    record("spawn", cwd, **where, orch=owner, adopted=target.get("adopted"), placement=target.get("placement"),
           account=launch["account"], model=args.model,
           effort=args.effort, permission_mode=args.permission_mode, label=args.name, prompt=prompt,
           resume=args.resume, task=task)
    if args.no_wait:
        result = {"ok": True, "status": "launched", "notes": ["did not wait for the agent"]}
    else:
        try:
            result = wait_for_start(pane, agent, prompt, args.accept_trust, args.timeout)
        except FleetError as e:
            record("spawn_result", cwd, **where, ok=False, reason=str(e))
            raise
    out = {**result, **target, **launch, "label": args.name, "role": args.role, **({"task": task} if task else {})}
    try:
        session = session_id_of(pane_info(pane)) if result["ok"] else None
    except FleetError:
        session = None
    record("spawn_result", cwd, **where, session=session, ok=result["ok"], status=result.get("status"),
           reason=result.get("reason"))
    print(json.dumps(out, indent=2, ensure_ascii=False))
    return 0 if result["ok"] else 2


# --------------------------------------------------------------------------
# pane roles (.fleet/panes.json)


def load_panes(fleet_dir: Path) -> dict:
    try:
        data = json.loads((Path(fleet_dir) / PANES_FILE).read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def save_panes(fleet_dir: Path, data: dict) -> None:
    path = Path(fleet_dir) / PANES_FILE
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    os.replace(tmp, path)


def register_pane(cwd: str, pane: str, record: dict) -> str:
    fleet_dir = Path(prep_dir(cwd)["fleet_dir"])
    data = load_panes(fleet_dir)
    data[pane] = record
    save_panes(fleet_dir, data)
    return str(fleet_dir / PANES_FILE)


def unregister_pane(cwd: str, pane: str) -> bool:
    fleet_dir = Path(git_toplevel(cwd) or cwd) / FLEET_DIR
    data = load_panes(fleet_dir)
    if pane not in data:
        return False
    del data[pane]
    save_panes(fleet_dir, data)
    return True


# --------------------------------------------------------------------------
# send


def spill_to_file(text: str, cwd: str) -> Path:
    fleet_dir = prep_dir(cwd)["fleet_dir"]
    inbox = Path(fleet_dir) / "inbox"
    inbox.mkdir(parents=True, exist_ok=True)
    path = inbox / f"{time.strftime('%Y%m%dT%H%M%S')}-{uuid.uuid4().hex[:6]}.md"
    path.write_text(text if text.endswith("\n") else text + "\n")
    return path


def target_agent_pane(pane: str) -> dict:
    if pane == os.environ.get("HERDR_PANE_ID"):
        raise FleetError("refusing to drive the calling pane")
    info = pane_info(pane)
    if not info.get("agent"):
        raise FleetError(f"pane {pane} has no detected agent")
    return info


def wait_not_working(pane: str, timeout: float) -> bool:
    if pane_info(pane).get("agent_status") != "working":
        return True
    cp = run(["herdr", "agent", "wait", pane, "--until", "idle", "--until", "done",
              "--timeout", str(int(timeout * 1000))], timeout=timeout + 10)
    return cp.returncode == 0


def cmd_send(args: argparse.Namespace) -> int:
    require_herdr()
    pane = args.pane
    info = target_agent_pane(pane)
    sent_file = None
    if args.file:
        sent_file = Path(args.file).expanduser().resolve()
        if not sent_file.is_file():
            raise FleetError(f"no such file: {sent_file}")
        text = f"Read {sent_file} and follow it."
    else:
        text = args.text
        if len(text) > PROMPT_MAX or "\n" in text:
            sent_file = spill_to_file(text, info.get("cwd") or os.getcwd())
            text = f"Read {sent_file} and follow it."
    if not args.queue and not wait_not_working(pane, args.timeout):
        print(json.dumps({"ok": False, "pane_id": pane, "status": "working", "reason": "agent still busy; rerun later or pass --queue"}, indent=2, ensure_ascii=False))
        return 3
    out = submit_prompt(pane, info["agent"], text)
    out["file"] = str(sent_file) if sent_file else None
    record("send", info.get("cwd"), pane=pane, agent=info["agent"], **pane_lane_fields(info), text=text,
           file=out["file"], session=session_id_of(info), ok=out["ok"], status=out.get("status"),
           reason=out.get("reason"))
    print(json.dumps(out, indent=2, ensure_ascii=False))
    return 0 if out["ok"] else 2


def submit_prompt(pane: str, agent: str, text: str) -> dict:
    """Submit one line to an agent and confirm it was taken: working, or shown as sent."""
    head = text_head(text)
    before = submitted_count(pane_lines(pane), head, agent)
    attempts = 1
    cp = run(["herdr", "agent", "prompt", pane, text, "--wait", "--until", "working", "--timeout", "15000"], timeout=30)
    ok = cp.returncode == 0
    how = "working" if ok else ""
    while not ok and attempts <= 3:
        lines = pane_lines(pane)
        if submitted_count(lines, head, agent) > before:
            ok, how = True, "sent (already finished, or queued)"
            break
        composer = composer_line(lines, agent) or ""
        if "[Pasted text" in composer or (head and head[:20] in composer):
            send_keys(pane, "Enter")
            attempts += 1
            cp = run(["herdr", "agent", "wait", pane, "--until", "working", "--timeout", "10000"], timeout=20)
            if cp.returncode == 0:
                ok, how = True, "working after Enter"
            continue
        break
    out = {"ok": ok, "pane_id": pane, "agent": agent, "sent": text, "attempts": attempts,
           "status": how or pane_info(pane).get("agent_status")}
    if not ok:
        out["reason"] = "could not confirm the prompt was submitted; read the pane"
    return out


RESUME_PROMPT = ("Resume this lane: read .fleet/BRIEF.md, .fleet/STATUS.md and .fleet/HANDOFF.md (when present), "
                 "run git status and git log --oneline -15, then continue from the next step in .fleet/STATUS.md.")


def session_id_of(info: dict) -> str | None:
    return (info.get("agent_session") or {}).get("value")


def compact_line(line: str, width: int = 200) -> str:
    """Shorten a screen line for a report: TUIs pad with long rules and right-aligned text."""
    s = re.sub(r"[─━═]{3,}", "──", line.strip())
    return re.sub(r"\s{3,}", "  ", s)[:width]


def screen_tail(pane: str, n: int = 15) -> list[str]:
    try:
        return [compact_line(l) for l in pane_lines(pane)[-n:]]
    except FleetError:
        return []


def confirm_clear(pane: str, before_id: str | None, before_count: int, timeout: float = 20) -> tuple[bool, list[str]]:
    """/clear starts a new session: wait until herdr reports a new session id.

    Without a session id (no herdr agent integration), accept one more `/clear`
    shown above an empty composer.
    """
    notes: list[str] = []
    nudged = 0
    deadline = time.time() + timeout
    while time.time() < deadline:
        time.sleep(1.0)
        info = pane_info(pane)
        now_id = session_id_of(info)
        if before_id and now_id and now_id != before_id:
            return True, notes
        lines = pane_lines(pane, info.get("scroll", {}).get("viewport_rows"))
        composer = composer_line(lines, "claude") or ""
        if composer.startswith("/clear") and nudged < 2:
            send_keys(pane, "Enter")
            nudged += 1
            notes.append("pressed Enter to submit /clear")
            continue
        if not before_id and composer == "" and submitted_count(lines, "/clear", "claude") > before_count:
            notes.append("no session id from herdr; /clear shows as sent")
            return True, notes
    return False, notes


def confirm_compact(pane: str, timeout: float) -> tuple[bool, list[str]]:
    """/compact keeps the session: wait for it to start working, finish, and print `Compacted`."""
    notes: list[str] = []
    for attempt in range(2):
        run(["herdr", "agent", "wait", pane, "--until", "working", "--timeout", "15000"], timeout=25)
        if not wait_not_working(pane, timeout):
            notes.append(f"still compacting after {timeout:g}s")
            return False, notes
        lines = pane_lines(pane)
        if any(re.search(r"\bCompacted\b", l) for l in lines[-20:]):
            return True, notes
        composer = composer_line(lines, "claude") or ""
        if attempt == 0 and composer.startswith("/compact"):
            send_keys(pane, "Enter")
            notes.append("pressed Enter to submit /compact")
            continue
        break
    notes.append("no 'Compacted' line on screen")
    return False, notes


def cmd_reset(args: argparse.Namespace) -> int:
    """/clear (default) or /compact a lane, then tell it to resume from its .fleet/ files."""
    require_herdr()
    pane = args.pane
    info = target_agent_pane(pane)
    if info["agent"] != "claude":
        raise FleetError("reset supports claude panes; for codex, send /compact or /new yourself")
    top = git_toplevel(info.get("cwd") or "") or info.get("cwd") or ""
    files = lane_files(top) if top else []
    if args.compact is None and not set(files) & set(LANE_FILES):
        raise FleetError(f"no .fleet/BRIEF.md, STATUS.md or HANDOFF.md under {top}; /clear would lose the task. "
                         "Write them first, or pass --compact")
    if not wait_not_working(pane, args.timeout):
        raise FleetError("agent still busy; reset it at its next boundary", code=3)
    info = pane_info(pane)
    if args.compact is None:
        command = "/clear"
        before_count = submitted_count(pane_lines(pane), "/clear", "claude")
        run(["herdr", "pane", "run", pane, command])
        ok, notes = confirm_clear(pane, session_id_of(info), before_count)
    else:
        command = ("/compact " + args.compact).strip()
        run(["herdr", "pane", "run", pane, command])
        ok, notes = confirm_compact(pane, args.timeout)
    out = {"ok": ok, "pane_id": pane, "command": command, "lane_files": files, "notes": notes,
           "session_id": session_id_of(pane_info(pane))}
    if not ok:
        out["reason"] = f"could not confirm {command.split()[0]}; read the pane"
        out["screen"] = screen_tail(pane)
    elif not args.no_resume:
        message = args.message or (RESUME_PROMPT if set(files) & set(LANE_FILES) else "Continue the task.")
        time.sleep(1.0)
        out["resume"] = submit_prompt(pane, "claude", message)
        out["ok"] = ok = out["resume"]["ok"]
    record("reset", info.get("cwd"), pane=pane, agent="claude", **pane_lane_fields(info), command=command,
           session_before=session_id_of(info), session=out["session_id"],
           text=(out.get("resume") or {}).get("sent"), ok=ok, reason=out.get("reason"))
    print(json.dumps(out, indent=2, ensure_ascii=False))
    return 0 if ok else 2


# --------------------------------------------------------------------------
# retire


def exit_agent(pane: str, agent: str, timeout: float) -> bool:
    """Type the agent's exit command into its pane, and wait until Herdr no longer sees an agent there."""
    command = EXIT_COMMAND.get(agent)
    if not command:
        raise FleetError(f"don't know how to exit {agent}; exit it in the pane")
    run(["herdr", "pane", "run", pane, command])
    deadline = time.time() + timeout
    while time.time() < deadline:
        if not pane_info(pane).get("agent"):
            return True
        time.sleep(1)
    return not pane_info(pane).get("agent")


def cmd_retire(args: argparse.Namespace) -> int:
    require_herdr()
    pane = args.pane
    if pane == os.environ.get("HERDR_PANE_ID"):
        raise FleetError("refusing to retire the calling pane; exit it yourself")
    info = pane_info(pane)
    agent = info.get("agent")
    if agent:
        if agent not in EXIT_COMMAND:
            raise FleetError(f"don't know how to exit {agent}; exit it in the pane")
        if info.get("agent_status") == "working":
            if not args.force:
                raise FleetError(f"{agent} in {pane} is working; wait for it, or pass --force to interrupt it", code=3)
            send_keys(pane, "Escape")
            time.sleep(1.5)
        if not exit_agent(pane, agent, args.timeout):
            reason = f"{agent} still running after {EXIT_COMMAND[agent]}"
            record("retire", info.get("cwd"), pane=pane, agent=agent, **pane_lane_fields(info),
                   session=session_id_of(info), ok=False, reason=reason)
            print(json.dumps({"ok": False, "pane_id": pane, "reason": reason}, indent=2, ensure_ascii=False))
            return 2
    unregistered = bool(info.get("cwd")) and unregister_pane(info["cwd"], pane)
    fields = {"pane": pane, "agent": agent, **pane_lane_fields(info), "session": session_id_of(info), "ok": True}
    closed = False
    if args.close:
        try:
            herdr("pane", "close", pane)
        except FleetError as e:
            record("retire", info.get("cwd"), **fields, closed=False, error=str(e))
            raise
        closed = True
    record("retire", info.get("cwd"), **fields, closed=closed)
    print(json.dumps({"ok": True, "pane_id": pane, "exited": agent, "closed": closed,
                      "unregistered": unregistered}, indent=2, ensure_ascii=False))
    return 0


# --------------------------------------------------------------------------
# status


def git_toplevel(path: str) -> str | None:
    try:
        cp = run(["git", "-C", path, "rev-parse", "--show-toplevel"], timeout=3)
    except FleetError:
        return None
    return cp.stdout.strip() if cp.returncode == 0 and cp.stdout.strip() else None


def git_branch(path: str) -> str:
    try:
        cp = run(["git", "-C", path, "rev-parse", "--abbrev-ref", "HEAD"], timeout=3)
    except FleetError:
        return ""
    return cp.stdout.strip() if cp.returncode == 0 else ""


def lane_files(path: str) -> list[str]:
    top = git_toplevel(path) or path
    d = Path(top) / FLEET_DIR
    return [f for f in (*LANE_FILES, ORCHESTRATOR_FILE) if (d / f).is_file()]


def claude_home(account: dict) -> str:
    return account_home("claude", account)


def session_account(agent: str, session_id: str, accounts: list[dict]) -> str | None:
    """The account whose config dir holds this session.

    Claude homes often share projects/ through symlinks, so a transcript's
    location says nothing about the account; each home keeps its own
    sessions/<pid>.json for running sessions. Codex keeps rollouts under
    sessions/YYYY/MM/DD/. A sessions/ dir shared by several homes is skipped.
    """
    if agent not in AGENTS or not SESSION_ID.fullmatch(session_id or ""):
        return None
    homes: dict[str, list[dict]] = {}
    for a in accounts:
        if a["provider"] == agent:
            sdir = os.path.join(account_home(agent, a), "sessions")
            if os.path.isdir(sdir):
                homes.setdefault(os.path.realpath(sdir), []).append(a)
    for sdir, owners in homes.items():
        if len(owners) != 1:
            continue
        if agent == "codex":
            pattern = os.path.join(glob.escape(sdir), "*", "*", "*", f"rollout-*{glob.escape(session_id)}.jsonl")
            if glob.glob(pattern):
                return owners[0]["account"]
            continue
        for f in glob.glob(os.path.join(glob.escape(sdir), "*.json")):
            try:
                with open(f) as fh:
                    if json.load(fh).get("sessionId") == session_id:
                        return owners[0]["account"]
            except (OSError, ValueError):
                continue
    return None


def cmd_status(args: argparse.Namespace) -> int:
    require_herdr()
    agents = herdr("agent", "list").get("agents", [])
    if args.workspace:
        agents = [a for a in agents if a.get("workspace_id") == args.workspace]
    remuda = remuda_path()
    accounts = remuda_accounts(remuda) if remuda else []
    registries: dict[str, dict] = {}
    rows = []
    for a in agents:
        cwd = a.get("cwd") or ""
        pane = a.get("pane_id")
        session = (a.get("agent_session") or {}).get("value")
        account = session_account(a.get("agent") or "", session, accounts) if (accounts and session) else None
        top = (git_toplevel(cwd) or cwd) if cwd else ""
        if top and top not in registries:
            registries[top] = load_panes(Path(top) / FLEET_DIR)
        record = registries.get(top, {}).get(pane) or {}
        rows.append({
            "pane": pane, "agent": a.get("agent"), "status": a.get("agent_status"), "role": record.get("role"),
            "account": account or record.get("account"), "branch": git_branch(cwd) if cwd else "",
            "lane": lane_files(cwd) if cwd else [], "session_id": session,
            "title": a.get("terminal_title_stripped") or "", "cwd": cwd, "self": pane == os.environ.get("HERDR_PANE_ID"),
        })
    if args.json:
        print(json.dumps(rows, indent=2, ensure_ascii=False))
        return 0
    header = ["PANE", "AGENT", "STATUS", "ROLE"] + (["ACCOUNT"] if remuda else []) + ["BRANCH", "LANE", "TITLE"]
    table = [header]
    for r in rows:
        lane = ",".join(f.replace(".md", "") for f in r["lane"]) or "-"
        row = [r["pane"] + ("*" if r["self"] else ""), r["agent"] or "-", r["status"] or "-", r["role"] or "-"]
        if remuda:
            row.append(r["account"] or "-")
        row += [r["branch"] or "-", lane, r["title"][:48]]
        table.append(row)
    widths = [max(len(str(r[i])) for r in table) for i in range(len(header))]
    for r in table:
        print("  ".join(str(c).ljust(widths[i]) for i, c in enumerate(r)).rstrip())
    return 0


# --------------------------------------------------------------------------
# project home and event log
#
# A project is a repository, known by its normalized remote URL, so all its
# clones share one home: ~/.fleet/projects/<name>/ (FLEET_HOME moves the root).
# The helper and the SessionStart and SessionEnd hooks append events to
# <home>/events/YYYY-MM.jsonl; events outside a repository go to
# ~/.fleet/events/. Writing an event never fails a command.

PROJECTS_DIR = "projects"
EVENTS_DIR = "events"
PROJECT_FILE = "project.json"
LOG_EVENTS = ("worktree", "spawn", "spawn_result", "send", "reset", "retire", "cleanup", "handoff",
              "session_start", "session_end", "orch_claim", "orch_release", "orch_rename", "adopt", "phase", "plan_approved", "risk_approved",
              "follow_up_added", "follow_up_taken", "follow_up_released", "follow_up_done")
# The hooks' time. Claude Code stops a hook at its budget in hooks.json, and the hook's output is then lost, also
# what it printed before (a test checks that HOOK_BUDGET agrees with hooks.json). So the whole hook must end inside
# the budget, not only git. Each hook run (HookRun) has one end time and one git deadline, both counted from
# HOOK_STARTED, the first moment the script can read a clock:
#   end      = HOOK_STARTED + HOOK_BUDGET - HOOK_BEFORE_CLOCK - HOOK_EXIT_MARGIN   (8 s; SessionEnd 3 s)
#   deadline = end - HOOK_AFTER_GIT                                                 (6 s; SessionEnd 2 s)
# All git calls of the run share the deadline. The work after git gets the rest up to the end: the files of the
# re-brief and its output, then the session record. The record's waits (ensure_project waiting for a project.json
# that another process is writing, over all candidate names together, and record retrying a locked event log) give
# up at the end, and the record is skipped when no time is left: it is best effort, the output is not.
# Measured in the hook-git-deadline lane, on 12 cores (the worst of each):
# - before HOOK_STARTED, the start of the interpreter and the compiling of this file: 0.08 s idle, 1.5 s at load 190;
# - the three git calls of a hook: 0.06 s idle, 0.34 s at load 234 (no single call above 0.23 s);
# - after git, without waits: the re-brief's files, the record and the output, about 0.3 s at load 190.
HOOK_BUDGET = {"session-start": 10, "session-end": 5}  # seconds, as hooks.json
HOOK_BEFORE_CLOCK = 1.5  # seconds before HOOK_STARTED: interpreter start-up and compile, measured up to 1.5 s
HOOK_EXIT_MARGIN = 0.5  # seconds to write the last line and exit after the end
HOOK_AFTER_GIT = {"session-start": 2, "session-end": 1}  # seconds kept after the git deadline for the rest
HOOK_GIT_MIN = 0.25  # seconds: a hook git call that cannot get this much is not started (above the worst call seen)
HOOK_WAIT_STEP = 0.05  # seconds of each wait in ensure_project and record
# Types of the event fields that are not text. `fleet log` drops a field of another type, so one damaged
# line cannot break it. Add each new field that is not text here.
EVENT_FIELD_TYPES = {"ok": bool, "closed": bool, "removed": bool, "replace": bool, "force": bool, "by": dict,
                     "exited": list, "reasons": list, "round": int, "files": int, "high_risk": list, "matches": list,
                     "follow_ups_closed": list, "follow_ups_released": list, "switched": bool, "lanes": list}
# `orch` (text) names the orch that an event concerns: the claim's, or the owner of the event's lane.
DICT_LIST_FIELDS = ("exited", "high_risk", "matches")  # lists of objects with text fields; other lists hold text


def fleet_home() -> Path:
    return Path(os.environ.get("FLEET_HOME") or "~/.fleet").expanduser()


def ensure_home() -> Path:
    """The fleet home, which only the user can open: it holds prompts and copies of lane files."""
    home = fleet_home()
    home.mkdir(mode=0o700, parents=True, exist_ok=True)
    st = home.stat()
    if st.st_mode & 0o077 and st.st_uid == os.getuid():
        os.chmod(home, 0o700)
    return home


def now_iso() -> str:
    return datetime.now().astimezone().isoformat(timespec="seconds")


def read_json(path: Path) -> dict:
    """The JSON object in `path`; {} when the file cannot be read or parsed (any exception: a deeply nested file
    makes the parser raise RecursionError) or holds no object."""
    try:
        data = json.loads(Path(path).read_text())
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def write_json(path: Path, data: dict) -> None:
    """Replace `path` with `data`, through a temporary file that is flushed and synced first: a crash leaves the old
    file or the new one, never an empty one."""
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        with open(tmp, "w") as fh:
            fh.write(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            tmp.unlink()
        except OSError:
            pass
        raise


def text_or_none(value) -> str | None:
    return value if isinstance(value, str) and value else None


def normalize_remote(url: str) -> str | None:
    """host/path of a git remote URL in lower case, so that its SSH and HTTPS forms match. None for a local path.

    The user name, password, port, query and fragment are dropped.
    """
    url = (url or "").strip()
    m = (re.match(r"^[a-z][a-z0-9+.-]*://(?:[^/]*@)?([^/:@?#]+)(?::\d*)?(/[^?#]*)", url, re.I)
         or re.match(r"^(?:[^@/]+@)?([^/:@]{2,}):(?!//)([^?#]+)", url))
    if not m:
        return None
    path = re.sub(r"\.git$", "", m.group(2).strip("/")).strip("/")
    return f"{m.group(1)}/{path}".lower() if path else None


def repo_identity(path: str, timeout: float = 15, strict: bool = False) -> dict | None:
    """The repository at `path`: its keys, main checkout and top.

    `key` is the normalized URL of origin (else of the first remote), or local:<main checkout> without a
    remote. `keys` also holds the local key, so that a project keeps its clones when a remote is added later.
    With `strict`, a failed remote query (git config exits with another code than 1, "no remote") gives None
    instead of the local key alone.
    """
    lines = (git_out(path, "rev-parse", "--git-common-dir", "--show-toplevel", timeout=timeout) or "").splitlines()
    if len(lines) < 2:
        return None
    if strict:
        cp = run_git(path, "config", "--get-regexp", r"^remote\..*\.url$", timeout=timeout)
        if cp is None or cp.returncode not in (0, 1):
            return None
        remote_lines = cp.stdout if cp.returncode == 0 else ""
    else:
        remote_lines = git_out(path, "config", "--get-regexp", r"^remote\..*\.url$", timeout=timeout) or ""
    return identity_from(path, lines, remote_lines)


def identity_from(path: str, lines: list[str], remote_lines: str) -> dict:
    """repo_identity from the output of its two git calls: `rev-parse --git-common-dir --show-toplevel` (at least
    two lines) and `config --get-regexp` of the remote URLs."""
    common = os.path.realpath(os.path.join(path, lines[0]))
    main_root = os.path.dirname(common) if os.path.basename(common) == ".git" else common
    urls: dict[str, str] = {}
    for line in remote_lines.splitlines():
        name, _, url = line.partition(" ")
        urls.setdefault(name[len("remote."):-len(".url")], url.strip())
    remote = normalize_remote(urls.get("origin") or next(iter(urls.values()), ""))
    local = f"local:{main_root}"
    return {"key": remote or local, "keys": [remote, local] if remote else [local], "main_root": main_root,
            "top": lines[1]}


def project_dirs() -> list[Path]:
    return sorted(p.parent for p in (fleet_home() / PROJECTS_DIR).glob(f"*/{PROJECT_FILE}"))


def project_keys(data: dict) -> list[str]:
    keys = data.get("keys") or data.get("remotes") or []  # "remotes": project.json files of the first 0.4.0
    return [k for k in keys if isinstance(k, str)] if isinstance(keys, list) else []


def find_project(keys: list[str], learn: bool = False) -> Path | None:
    """The home of the project that knows one of these keys, tried in order.

    With `learn`, the project also stores the keys that it lacks: a new clone, or a remote that was added to a
    repository without one.
    """
    projects = [(d, read_json(d / PROJECT_FILE)) for d in project_dirs()]
    picked = pick_project(keys, projects)
    if picked is None:
        return None
    d, data = picked
    known = project_keys(data)
    missing = [k for k in keys if k not in known]
    if learn and missing:
        data.pop("remotes", None)
        data["keys"] = known + missing
        write_json(d / PROJECT_FILE, data)
    return d


def pick_project(keys: list[str], projects: list[tuple[Path, dict]]) -> tuple[Path, dict] | None:
    """The rule of find_project: the first (home, project.json data) of `projects` that knows a key, the keys tried in
    order."""
    for key in keys:
        for d, data in projects:
            if key in project_keys(data):
                return d, data
    return None


def project_names(key: str) -> list[str]:
    """Folder names to try for a new project: the repository's name, then owner-name, then numbered."""
    parts = [re.sub(r"[^a-z0-9._-]+", "-", p.lower()).strip("-.") for p in re.split(r"[/:]", key)]
    parts = [p for p in parts if p] or ["project"]
    names = [parts[-1]] + (["-".join(parts[-2:])] if len(parts) > 1 else [])
    return names + [f"{parts[-1]}-{i}" for i in range(2, 100)]


def ensure_project(keys: list[str], until: float | None = None) -> Path | None:
    """The home of the project with these keys; keys[0] names a new one. The first call creates it.

    With `until` (a time of hook_clock: a hook's end time), a name whose folder exists but whose project.json is not
    there yet is waited for up to that time, and then it returns None: a folder of unknown identity never lets it
    make a home under another name, which could be a second home for the same keys. Without `until`, it waits up to
    1 s for each such name, then tries the next."""
    found = find_project(keys, learn=True)
    if found:
        return found
    root = ensure_home() / PROJECTS_DIR
    root.mkdir(exist_ok=True)
    for name in project_names(keys[0]):
        d = root / name
        try:
            d.mkdir()
        except FileExistsError:
            # Another process can have created this project a moment ago: give it time to write project.json.
            known: list[str] = []
            for _ in (itertools.count() if until is not None else range(20)):
                data = read_json(d / PROJECT_FILE)
                if data:
                    known = project_keys(data)
                    break
                if until is not None and hook_clock() + HOOK_WAIT_STEP > until:
                    return None  # never on to the next name: that could make a second home for these keys
                time.sleep(HOOK_WAIT_STEP)
            if any(k in known for k in keys):
                return d
            continue
        write_json(d / PROJECT_FILE, {"name": name, "keys": list(keys), "created": now_iso()})
        return d
    return None


def project_for(path: str | None, create: bool = True, timeout: float = 15) -> Path | None:
    """The home of the project that holds `path`, or None outside a repository."""
    if not path or not os.path.isdir(path):
        return None
    ident = repo_identity(path, timeout)
    if not ident:
        return None
    return ensure_project(ident["keys"]) if create else find_project(ident["keys"])


def project_lookup(path: str) -> tuple[Path | None, str | None]:
    """(the home of the project that holds the git checkout `path`, why it cannot be told). None with no error:
    the repository has no project home yet. The gates use this strict form; a failed lookup is not "no project"."""
    ident = repo_identity(path, strict=True)
    if not ident:
        return None, f"git cannot tell the project of {path}"
    return find_project(ident["keys"]), None


def caller() -> dict:
    """Who runs this command: the Herdr pane and, inside Claude Code, the session."""
    env = os.environ
    who = {"pane": env.get("HERDR_PANE_ID"), "session": env.get("CLAUDE_CODE_SESSION_ID"),
           "agent": "claude" if env.get("CLAUDECODE") == "1" else None}
    return {k: v for k, v in who.items() if v}


def record(event: str, where: str | None, by: bool = True, home: Path | None = None, until: float | None = None,
           **fields) -> str | None:
    """Append one event to the log of the project that holds `where` (or to `home`).

    Returns the log file, or None. Never raises, and gives up after about 1 s on a locked log, or at `until` (a time
    of hook_clock: a hook's end time) when that comes first.
    """
    try:
        ensure_home()
        home = home or project_for(where)
        entry = {"event": event}
        if home:
            entry["project"] = home.name
        entry.update((k, v) for k, v in fields.items() if v is not None and v != [])
        if "orch" not in fields:
            owner = event_lane_owner(fields.get("lane") or fields.get("cwd") or where)
            if owner:
                entry["orch"] = owner  # the owner at the time of the event: digest and log route by it
        if by and caller():
            entry["by"] = caller()
        d = (home or fleet_home()) / EVENTS_DIR
        d.mkdir(parents=True, exist_ok=True)
        path = d / f"{time.strftime('%Y-%m')}.jsonl"
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        try:
            for _ in range(20):
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if until is not None and hook_clock() + HOOK_WAIT_STEP > until:
                        return None
                    time.sleep(HOOK_WAIT_STEP)
            else:
                return None
            # The time is taken under the lock, so that the order of the lines is the order of their times.
            entry = {"ts": now_iso(), **entry}
            os.write(fd, (json.dumps(entry, ensure_ascii=False, separators=(",", ":")) + "\n").encode())
        finally:
            os.close(fd)
        return str(path)
    except Exception:
        return None


def event_lane_owner(path) -> str | None:
    """The orch that owns the lane holding `path` now: the lane.json of the first directory at or above it that has
    a `.git` (the top of its checkout). No git, and a read that cannot block (read_small_json), so record() and the
    hooks can afford it: anything but a small regular file gives no owner."""
    top = checkout_top(path)
    if top is None:
        return None
    return text_or_none(read_small_json(top / FLEET_DIR / LANE_FILE, LANE_FILE_MAX).get("orch"))


def checkout_top(path) -> Path | None:
    """The first directory at or above the absolute `path` that has a `.git` (the top of its checkout), by file
    checks only; None when there is none."""
    if not isinstance(path, str) or not os.path.isabs(path):
        return None
    try:
        d = Path(path)
        for top in (d, *d.parents):
            if (top / ".git").exists():
                return top
    except OSError:
        return None
    return None


def read_small_file(path, limit: int) -> bytes:
    """The bytes of `path` when it is a regular file of at most `limit` bytes. The open does not block
    (O_NONBLOCK: a FIFO without a writer would hold a plain open for ever), fstat must say a regular file, and the
    read takes at most `limit` + 1 bytes. No thread, no timer. OSError when it cannot be opened or read, ValueError
    (with the reason) for a file that is not regular or is too large."""
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0))
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise ValueError("not a regular file")
        if info.st_size > limit:
            raise ValueError(f"larger than {limit} bytes")
        data = os.read(fd, limit + 1)
        if len(data) > limit:
            raise ValueError(f"larger than {limit} bytes")
        return data
    finally:
        os.close(fd)


def read_small_json(path: Path, limit: int) -> dict:
    """The JSON object in `path` when it is a regular file of at most `limit` bytes (read_small_file), else {}:
    a FIFO, a device or a directory gives {}."""
    try:
        parsed = json.loads(read_small_file(path, limit))
    except Exception:
        return {}
    return parsed if isinstance(parsed, dict) else {}


def pane_lane_fields(info: dict) -> dict:
    """cwd, workspace and branch of a pane, so that `fleet log --lane` finds the event."""
    cwd = info.get("cwd")
    return {"cwd": cwd, "workspace": info.get("workspace_id"), "branch": (git_branch(cwd) or None) if cwd else None}


def hook_clock() -> float:
    """The clock of the hooks' end time and git deadline (see HOOK_BUDGET), as HOOK_STARTED reads it. The tests do
    not replace this function: patient_fleet.py gives the script a fake time.monotonic (in-process its own time
    module, in a child the patched one) that moves only when the harness says that git took time, or by the
    helper's own sleeps."""
    return time.monotonic()


HOOK_NO_REPOSITORY = "git found no repository here"
HOOK_GIT_ERROR = "a git error"
HOOK_NO_ANSWER = "git did not answer in time"


class HookGitFailed(Exception):
    """A git call of a hook gave no identity. `cause` is one of HOOK_NO_REPOSITORY (exit code 128, for any reason),
    HOOK_GIT_ERROR (any other exit code, any exception, output that is not UTF-8, a failed remote query) or
    HOOK_NO_ANSWER (a timeout, or no time left)."""

    def __init__(self, cause: str, detail: str = ""):
        super().__init__(f"{cause}: {detail}" if detail else cause)
        self.cause = cause


def no_git_entry(path: str) -> bool:
    """True when nothing tells git where a repository is: GIT_DIR is not set, and no `.git` entry (a file or a
    directory) exists in `path` or in any parent. Only then does git's exit code 128 mean "no repository" in
    project_home's refusal. The hook does not use it: for a registered orch pane, every exit code 128 is the note
    (orch_decide)."""
    if os.environ.get("GIT_DIR"):
        return False
    d = os.path.realpath(path)
    while True:
        if os.path.lexists(os.path.join(d, ".git")):
            return False
        parent = os.path.dirname(d)
        if parent == d:
            return True
        d = parent


class HookRun:
    """One run of a hook (see HOOK_BUDGET): its end time and its git deadline, both counted from `start`, and what
    git has told it. `start` is HOOK_STARTED in the hook command; a hook function called without a run starts one
    now."""

    def __init__(self, event: str = "session-start", start: float | None = None):
        start = hook_clock() if start is None else start
        self.end = start + HOOK_BUDGET[event] - HOOK_BEFORE_CLOCK - HOOK_EXIT_MARGIN
        self.deadline = self.end - HOOK_AFTER_GIT[event]
        self.identities: dict[str, dict] = {}
        self.tops: dict[str, str] = {}  # the checkout top that rev-parse confirmed, also when the remote query failed

    def git(self, path: str, *args: str) -> subprocess.CompletedProcess:
        """`git -C path args` with the time left until the deadline as its limit, its output decoded strictly as
        UTF-8. An exit code >= 0 comes back for the caller to judge. HookGitFailed: HOOK_NO_ANSWER when less than
        HOOK_GIT_MIN is left (git does not start) or on a timeout; HOOK_GIT_ERROR for every other exception (git
        cannot start, output that is not UTF-8, anything else) and for a signal."""
        left = self.deadline - hook_clock()
        if left < HOOK_GIT_MIN:
            raise HookGitFailed(HOOK_NO_ANSWER, f"no time was left for git {args[0]}")
        try:
            cp = subprocess.run(["git", "-C", path, *args], capture_output=True, timeout=left)
            out, err = cp.stdout.decode(), cp.stderr.decode(errors="replace")
        except subprocess.TimeoutExpired:
            raise HookGitFailed(HOOK_NO_ANSWER, f"git {args[0]} timed out after {left:.2f}s")
        except Exception as e:
            raise HookGitFailed(HOOK_GIT_ERROR, f"git {args[0]}: {type(e).__name__}: {e}")
        if cp.returncode < 0:
            raise HookGitFailed(HOOK_GIT_ERROR, f"git {args[0]} was ended by signal {-cp.returncode}")
        return subprocess.CompletedProcess(cp.args, cp.returncode, out, err)

    def identity(self, path: str) -> dict:
        """repo_identity(path) within the deadline: the top and the remotes. HookGitFailed for every failure: exit
        code 128 of rev-parse is HOOK_NO_REPOSITORY (whatever its reason), any other failure, also of the remote
        query, is HOOK_GIT_ERROR (without the remotes the local key alone could name another project). A found
        identity is kept for the run; a failure is not, so a later caller asks git again while time is left."""
        if path not in self.identities:
            cp = self.git(path, "rev-parse", "--git-common-dir", "--show-toplevel")
            lines = cp.stdout.strip().splitlines()
            if cp.returncode == 128:
                raise HookGitFailed(HOOK_NO_REPOSITORY, (cp.stderr.strip().splitlines() or [""])[0])
            if cp.returncode != 0 or len(lines) < 2:
                raise HookGitFailed(HOOK_GIT_ERROR, f"git rev-parse failed with exit code {cp.returncode}")
            self.tops[path] = lines[1]
            remotes = self.git(path, "config", "--get-regexp", r"^remote\..*\.url$")
            if remotes.returncode not in (0, 1):  # 1: no remote
                raise HookGitFailed(HOOK_GIT_ERROR, f"git config failed with exit code {remotes.returncode}")
            self.identities[path] = identity_from(path, lines, remotes.stdout if remotes.returncode == 0 else "")
        return self.identities[path]

    def top(self, path: str) -> str | None:
        """The checkout top of `path` within the deadline, for the lane files of a pane that is no orch candidate:
        from the identity, or from the rev-parse that confirmed it when only the remote query failed. None when git
        gives none."""
        try:
            return self.identity(path)["top"]
        except HookGitFailed:
            return self.tops.get(path)


def hook_session_event(event: str, data: dict, env: dict | None = None, run: HookRun | None = None) -> str | None:
    """Record a Claude session that starts or ends in a Herdr pane, in a checkout that has .fleet/.

    Its git calls share the deadline of `run`, and it reuses the repository that the re-brief found in the same
    run; after an earlier failure it asks git again while time is left. Without an answer from git it records
    nothing; the branch is left out when no time is left for it. Its waits end at the run's end time, and it records
    nothing when that has come: the record is best effort.
    """
    env = os.environ if env is None else env
    pane = text_or_none(env.get("HERDR_PANE_ID"))
    if not pane:
        return None
    run = run or HookRun("session-start" if event == "session_start" else "session-end")
    cwd = text_or_none(data.get("cwd")) or os.getcwd()
    try:
        ident = run.identity(cwd)
    except HookGitFailed:
        return None
    if not (Path(ident["top"]) / FLEET_DIR).is_dir():
        return None
    top = ident["top"]
    try:
        cp = run.git(top, "rev-parse", "--abbrev-ref", "HEAD")
        branch = cp.stdout.strip() if cp.returncode == 0 else None
    except HookGitFailed:
        branch = None
    if hook_clock() >= run.end:
        return None
    try:
        home = ensure_project(ident["keys"], until=run.end)
    except OSError:
        return None
    if not home:
        return None
    role = (load_panes(Path(top) / FLEET_DIR).get(pane) or {}).get("role")
    model = data.get("model")
    model = model.get("id") if isinstance(model, dict) else model
    return record(event, top, by=False, home=home, until=run.end, pane=pane,
                  workspace=text_or_none(env.get("HERDR_WORKSPACE_ID")), cwd=cwd, branch=branch,
                  agent="claude", role=text_or_none(role), session=text_or_none(data.get("session_id")),
                  transcript=text_or_none(data.get("transcript_path")), source=text_or_none(data.get("source")),
                  reason=text_or_none(data.get("reason")), model=text_or_none(model),
                  config_dir=text_or_none(env.get("CLAUDE_CONFIG_DIR")),
                  entrypoint=text_or_none(env.get("CLAUDE_CODE_ENTRYPOINT")))


def event_time(e: dict) -> float:
    try:
        return datetime.fromisoformat(e.get("ts") or "").timestamp()
    except (TypeError, ValueError):
        return 0.0


def parse_since(text: str) -> float:
    m = re.fullmatch(r"\s*(\d+)\s*([mhdw])\s*", text or "")
    if m:
        return time.time() - int(m.group(1)) * {"m": 60, "h": 3600, "d": 86400, "w": 604800}[m.group(2)]
    try:
        return datetime.fromisoformat((text or "").strip()).timestamp()
    except ValueError:
        raise FleetError(f"--since takes a duration (30m, 12h, 7d, 2w) or a date such as 2026-11-01, not {text!r}")


def clean_event(e: dict) -> dict:
    """The event without the fields whose type is wrong (see EVENT_FIELD_TYPES; other fields are text)."""
    out = {}
    for key, value in e.items():
        want = EVENT_FIELD_TYPES.get(key, str)
        if not isinstance(value, want):
            continue
        if want is dict:
            value = {k: v for k, v in value.items() if isinstance(v, str)}
        elif want is list:
            value = ([{k: v for k, v in x.items() if isinstance(v, str)} for x in value if isinstance(x, dict)]
                     if key in DICT_LIST_FIELDS else [x for x in value if isinstance(x, str)])
        out[key] = value
    return out


def jsonl_events(data: bytes) -> list[dict]:
    """The events in JSONL bytes. Records end at LF bytes only: a JSON string can hold U+2028, U+2029 or U+0085,
    which `str.splitlines()` would take for line ends. A damaged record or field is skipped."""
    events = []
    for line in data.split(b"\n"):
        try:
            e = json.loads(line.decode("utf-8", errors="replace"))
        except ValueError:
            continue
        if isinstance(e, dict):
            events.append(clean_event(e))
    return events


def read_events(dirs: list[Path]) -> list[dict]:
    """Every event in these homes, oldest first. A damaged line or field is skipped."""
    events = []
    for d in dirs:
        for f in sorted((Path(d) / EVENTS_DIR).glob("*.jsonl")):
            try:
                data = f.read_bytes()
            except OSError:
                continue
            events += jsonl_events(data)
    events.sort(key=event_time)
    return events


def lane_matches(e: dict, lane: str) -> bool:
    """LANE is a branch, a workspace id, a label, or a path at or above the lane's checkout."""
    if lane in (e.get("branch"), e.get("workspace"), e.get("label")):
        return True
    want = os.path.expanduser(lane)
    return any(isinstance(p, str) and inside(os.path.expanduser(p), want) for p in (e.get("lane"), e.get("cwd")))


def lane_events(events: list[dict], lane: str) -> list[dict]:
    """The events of one lane. A label is recorded only at worktree and spawn, so it also selects their branch."""
    branches = {e["branch"] for e in events if e.get("label") == lane and e.get("branch")}
    return [e for e in events if lane_matches(e, lane) or e.get("branch") in branches]


def pane_matches(e: dict, pane: str) -> bool:
    exited = [x for x in e.get("exited") or [] if isinstance(x, dict)]
    return pane in (e.get("pane"), (e.get("by") or {}).get("pane")) or any(x.get("pane") == pane for x in exited)


def short_id(session: str | None) -> str:
    return (session or "")[:8] or "-"


def describe_event(e: dict) -> str:
    kind = e.get("event")
    if kind == "worktree":
        text = f"{e.get('branch')} from {e.get('base') or '-'} at {short_path(e.get('lane') or '')}"
    elif kind == "spawn":
        setup = "/".join(x for x in (e.get("agent"), e.get("model"), e.get("effort")) if x)
        text = " ".join(x for x in (e.get("role"), setup, e.get("account"),
                                    f"session {short_id(e.get('session'))}" if e.get("session") else None) if x)
        text += f'  "{e["prompt"]}"' if e.get("prompt") else ""
    elif kind == "spawn_result":
        text = f"started, session {short_id(e.get('session'))}" if e.get("ok") else "did not start"
    elif kind == "send":
        text = f'"{e.get("text") or ""}"'
    elif kind == "reset":
        text = f"{e.get('command')}  session {short_id(e.get('session_before'))} -> {short_id(e.get('session'))}"
    elif kind == "retire":
        text = (f"exited {e.get('agent') or 'no agent'} (session {short_id(e.get('session'))})"
                + (", closed the pane" if e.get("closed") else "")
                + (f"; could not close the pane: {e['error']}" if e.get("error") and e.get("ok") else ""))
    elif kind == "cleanup":
        text = (f"{short_path(e.get('lane') or '')} " + ("removed" if e.get("removed") else "kept")
                + f"; branch: {e.get('branch_result') or '-'}"
                + (f"; archive {short_path(e['archive'])}" if e.get("archive") else "")
                + (f"; follow-ups closed {', '.join(e['follow_ups_closed'])}" if e.get("follow_ups_closed") else "")
                + (f"; follow-ups released {', '.join(e['follow_ups_released'])}" if e.get("follow_ups_released") else "")
                + (f"; follow-ups: {e['follow_up_error']}" if e.get("follow_up_error") else ""))
    elif kind == "follow_up_added":
        text = (f'{e.get("id") or "?"} "{e.get("text") or ""}"'
                + (" (ID given to a hand-written line)" if e.get("assigned") else ""))
    elif kind == "follow_up_taken":
        text = f'{e.get("id") or "?"} taken by {e.get("branch") or "?"}: "{e.get("text") or ""}"'
    elif kind == "follow_up_released":
        text = f'{e.get("id") or "?"} released from {e.get("branch") or "?"}: "{e.get("text") or ""}"'
    elif kind == "follow_up_done":
        text = (f'{e.get("id") or "?"} done' + (f" in {e['branch']}" if e.get("branch") else "")
                + (f": {e['reason']}" if e.get("reason") else "") + f'  "{e.get("text") or ""}"')
    elif kind == "handoff":
        text = f"handoff file {short_path(e.get('path') or '')}"
    elif kind == "orch_claim":
        text = (f"orch {e['orch'] + ' ' if e.get('orch') else ''}pane {e.get('old') or '-'} -> {e.get('pane') or '-'}"
                + (" (replace)" if e.get("replace") else "") + ("; orch.json now holds several orchs (format 2)"
                                                                if e.get("switched") else ""))
    elif kind == "orch_release":
        text = (f"released orch {e['orch'] + ' ' if e.get('orch') else ''}pane {e.get('pane') or '-'}"
                + (" (force)" if e.get("force") else ""))
    elif kind == "orch_rename":
        text = (f"renamed orch {e.get('old') or '?'} to {e.get('orch') or '?'}"
                + (f"; {plural(len(e['lanes']), 'lane')} moved with it" if e.get("lanes") else "")
                + ("; orch.json now holds several orchs (format 2)" if e.get("switched") else ""))
    elif kind == "adopt":
        text = (f"{short_path(e.get('lane') or '')}: orch {e.get('old') or 'none'} -> {e.get('orch') or '?'}")
    elif kind == "plan_approved":
        text = f"plan round {e.get('round', '?')} approved by {e.get('approved_by') or '?'}, risk {e.get('risk') or '?'}"
        text += f"; high-risk paths: {event_matches(e.get('high_risk'))}" if e.get("high_risk") else ""
    elif kind == "risk_approved":
        text = f"risky diff approved by user: {event_matches(e.get('matches'))}"
    elif kind == "phase":
        text = f"{e.get('name') or e.get('branch') or short_path(e.get('lane') or '')}: {e.get('old') or 'new'} -> {e.get('new')}"
    elif kind in ("session_start", "session_end"):
        text = " ".join(x for x in (e.get("source") or e.get("reason"), e.get("agent"), e.get("role"),
                                    f"session {e.get('session') or '-'}") if x)
    else:
        text = json.dumps({k: v for k, v in e.items() if k not in ("ts", "event", "project", "by")}, ensure_ascii=False)
    if e.get("ok") is False:
        text += f"  FAILED: {e.get('reason') or e.get('error') or e.get('status') or 'see --json'}"
    return text


def event_matches(items, limit: int = 3) -> str:
    """`migration db/migrate/1.sql, +2` from the `{category, path}` list of an event; a damaged item counts as `?`."""
    items = items if isinstance(items, list) else []
    words = [f"{i.get('category') or '?'} {i.get('path') or '?'}" if isinstance(i, dict) else "?" for i in items]
    return ", ".join(words[:limit] + ([f"+{len(words) - limit}"] if len(words) > limit else []))


def clock(e: dict) -> str:
    t = event_time(e)
    return datetime.fromtimestamp(t).strftime("%m-%d %H:%M") if t else "?"


def session_rows(events: list[dict]) -> list[dict]:
    """One row per agent session that the events name, in the order the sessions first appear."""
    rows: dict[str, dict] = {}

    def touch(sid: str | None, e: dict, **known) -> dict | None:
        if not sid:
            return None
        r = rows.setdefault(sid, {"session": sid, "first": e.get("ts"), "ended": None, "transcript": None})
        r["last"] = e.get("ts")
        for key in ("project", "agent", "pane", "role", "branch"):
            value = known.get(key) or e.get(key)
            if value and not r.get(key):
                r[key] = value
        if not r.get("lane") and (e.get("lane") or e.get("cwd")):
            r["lane"] = e.get("lane") or e.get("cwd")
        return r

    for e in events:
        kind = e.get("event")
        r = touch(e.get("session"), e)
        if r and e.get("transcript"):
            r["transcript"] = e["transcript"]
        if r and kind == "session_start":
            r["ended"] = None  # resumed
        if r and kind == "session_end":
            r["ended"] = e.get("reason") or "ended"
        if r and kind == "retire" and e.get("ok") is not False:
            r["ended"] = "retired"
        if kind == "reset":
            before = touch(e.get("session_before"), e)
            if before and e.get("session_before") != e.get("session"):
                before["ended"] = before["ended"] or "clear"
        if kind == "cleanup":
            for x in e.get("exited") or []:
                if isinstance(x, dict):
                    done = touch(x.get("session"), e, pane=x.get("pane"), agent=x.get("agent"))
                    if done:
                        done["ended"] = done["ended"] or "cleanup"
    return list(rows.values())


def agent_homes() -> dict[str, list[str]]:
    """Config dirs to search for transcripts: remuda's accounts, the caller's, and the defaults."""
    homes: dict[str, list[str]] = {a: [] for a in AGENTS}
    remuda = remuda_path()
    try:
        accounts = remuda_accounts(remuda) if remuda else []
    except FleetError:
        accounts = []
    candidates = [(a["provider"], account_home(a["provider"], a)) for a in accounts if a["provider"] in AGENTS]
    for agent in AGENTS:
        candidates += [(agent, os.environ.get(HOME_VAR[agent]) or ""), (agent, os.path.expanduser(DEFAULT_HOME[agent]))]
    seen: set[str] = set()
    for agent, home in candidates:
        if home and os.path.isdir(home) and os.path.realpath(home) not in seen:
            seen.add(os.path.realpath(home))
            homes[agent].append(home)
    return homes


def find_transcript(agent: str | None, session: str, homes: dict[str, list[str]]) -> str | None:
    if agent not in AGENTS or not SESSION_ID.fullmatch(session or ""):
        return None
    for home in homes.get(agent, []):
        if agent == "claude":
            pattern = os.path.join(glob.escape(home), "projects", "*", f"{glob.escape(session)}.jsonl")
        else:
            pattern = os.path.join(glob.escape(home), "sessions", "*", "*", "*", f"rollout-*{glob.escape(session)}.jsonl")
        hits = glob.glob(pattern)
        if hits:
            return hits[0]
    return None


OWNING_EVENTS = ("worktree", "adopt", "cleanup")  # events whose `orch` names the owner of their lane


def adopt_old_owner(e: dict) -> str | None:
    """The orch that an `adopt` event took the lane from (its `old`); None for any other event. The adopt goes to
    that orch too (view_shows, orch_events), so that it sees its lane leave; the lane is the new orch's after it."""
    return text_or_none(e.get("old")) if e.get("event") == "adopt" else None


def owning_event(e: dict) -> bool:
    """An event that sets the owner of its lane: worktree, adopt, cleanup, and a spawn that adopted the lane."""
    return e.get("event") in OWNING_EVENTS or (e.get("event") == "spawn" and bool(e.get("adopted")))


def orch_events(events: list[dict], name: str, aliases: dict[str, dict[str, str]] | None = None,
                shown: list[dict] | None = None) -> list[dict]:
    """Of `shown` (default: `events`), the events of orch `name`. `events` is the whole log, oldest first: the owner
    of each lane comes from it, before any other filter. An event that names its orch goes to that orch (through
    `aliases`, by project: a rename's old name goes to the orch that has it now). An event without one goes to the
    orch that owned its lane (by path, else by branch) at the time of the event, by the owning events before it.
    An `adopt` also goes to the orch that it took the lane from (adopt_old_owner); the owners do not change for
    that: after the adopt, the lane is the new orch's. Reads the log only."""
    aliases = aliases or {}
    owners: dict[tuple, str] = {}  # (project, "path" or "branch", value) -> owner, as the log goes
    keep: set[int] = set()
    for e in events:
        names = aliases.get(e.get("project"), {})
        owner = text_or_none(e.get("orch"))
        owner = names.get(owner, owner) if owner else None
        where = e.get("lane") or e.get("cwd")
        if owner is None:
            hits = [o for (proj, kind, v), o in owners.items() if proj == e.get("project") and kind == "path"
                    and isinstance(where, str) and inside(where, v)]
            owner = hits[-1] if hits else owners.get((e.get("project"), "branch", e.get("branch")))
        old = adopt_old_owner(e)
        if owner == name or (old and names.get(old, old) == name):
            keep.add(id(e))
        if owning_event(e) and text_or_none(e.get("orch")):
            if isinstance(where, str):
                owners[(e.get("project"), "path", where)] = owner
            if e.get("branch"):
                owners[(e.get("project"), "branch", e["branch"])] = owner
    return [e for e in (events if shown is None else shown) if id(e) in keep]


def log_dirs(args: argparse.Namespace) -> list[Path]:
    known = ", ".join(p.name for p in project_dirs()) or "none yet"
    if args.all:
        return project_dirs() + [fleet_home()]
    if args.project:
        d = fleet_home() / PROJECTS_DIR / args.project
        if not (d / PROJECT_FILE).is_file():
            raise FleetError(f"no project {args.project!r}. Projects: {known}")
        return [d]
    d = project_for(os.getcwd(), create=False)
    if not d:
        raise FleetError(f"this directory is in no fleet project; pass a project name or --all. Projects: {known}")
    return [d]


def cmd_log(args: argparse.Namespace) -> int:
    dirs = log_dirs(args)
    events = whole = read_events(dirs)
    if args.since:
        since = parse_since(args.since)
        events = [e for e in events if event_time(e) >= since]
    if args.event:
        kinds = {k.strip() for k in args.event.split(",") if k.strip()}
        events = [e for e in events if e.get("event") in kinds]
    if args.lane:
        events = lane_events(events, args.lane)
    if args.orch:  # the owners come from the whole log, before --since, --event and --lane cut it
        aliases = {d.name: orch_aliases(read_orchs(d)) for d in dirs if (d / ORCH_FILE).exists()}
        events = orch_events(whole, args.orch, aliases, shown=events)
    if args.pane:
        events = [e for e in events if pane_matches(e, args.pane)]
    if args.sessions:
        rows = session_rows(events)
        rows = rows[-args.limit:] if args.limit > 0 else rows
        homes = agent_homes() if any(not r.get("transcript") for r in rows) else {}
        for r in rows:
            r["transcript"] = r.get("transcript") or find_transcript(r.get("agent"), r["session"], homes)
        if args.json:
            print(json.dumps(rows, indent=2, ensure_ascii=False))
            return 0
        table = [["STARTED", "PANE", "ROLE", "AGENT", "SESSION", "ENDED", "TRANSCRIPT"]]
        table += [[clock({"ts": r["first"]}), r.get("pane") or "-", r.get("role") or "-", r.get("agent") or "-",
                   r["session"], r.get("ended") or "-", short_path(r["transcript"]) if r.get("transcript") else "-"]
                  for r in rows]
    else:
        events = events[-args.limit:] if args.limit > 0 else events
        if args.json:
            print(json.dumps(events, indent=2, ensure_ascii=False))
            return 0
        table = [["TIME"] + (["PROJECT"] if args.all else []) + ["EVENT", "PANE", "WHAT"]]
        table += [[clock(e)] + ([e.get("project") or "-"] if args.all else [])
                  + [e.get("event") or "?", e.get("pane") or "-", describe_event(e)] for e in events]
    if len(table) == 1:
        print("no events")
        return 0
    widths = [max(len(str(r[i])) for r in table) for i in range(len(table[0]) - 1)]
    for r in table:
        print("  ".join([str(c).ljust(widths[i]) for i, c in enumerate(r[:-1])] + [str(r[-1])]).rstrip())
    return 0


# --------------------------------------------------------------------------
# sweep / cleanup
#
# A lane is a linked worktree that is open as a Herdr workspace, sits in Herdr's
# worktrees directory, or has a .fleet/ folder. sweep only reads. cleanup acts
# only on lanes that the user picked, and checks each of them again first.


ACTIVE_STATUSES = ("working", "blocked")
# Linked worktrees that other tools manage: sweep counts them, cleanup never touches them.
OTHER_KINDS = (("/.codex/worktrees/", "Codex app"), ("/.claude/worktrees/", "Claude Code agents"))
PR_FIELDS = "number,state,headRefOid,mergedAt,url"
GH_COMMITS_PAGE = 100  # gh pr view --json commits: at most this many, the oldest first
VERDICTS = (("ready", "READY: `fleet cleanup` removes these"),
            ("waiting", "WAITING: pull request open; the worktree stays"),
            ("keep", "KEEP"))


def plural(n: int, word: str) -> str:
    return f"{n} {word}" + ("" if n == 1 else "s")


def run_git(path: str, *args: str, timeout: float = 15) -> subprocess.CompletedProcess | None:
    try:
        return run(["git", "-C", path, *args], timeout=timeout)
    except FleetError:
        return None


def git_out(path: str, *args: str, timeout: float = 15) -> str | None:
    """Stripped stdout of a git command, or None when it fails."""
    cp = run_git(path, *args, timeout=timeout)
    return cp.stdout.strip() if cp is not None and cp.returncode == 0 else None


def git_ok(path: str, *args: str) -> bool:
    cp = run_git(path, *args)
    return cp is not None and cp.returncode == 0


def count_out(text: str | None) -> int | None:
    return int(text) if text is not None and text.isdigit() else None


def inside(path: str, root: str) -> bool:
    path, root = os.path.realpath(path), os.path.realpath(root)
    return path == root or path.startswith(root.rstrip(os.sep) + os.sep)


def short_path(path: str) -> str:
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path == home or path.startswith(home + os.sep) else path


def worktrees_dir_from_config(text: str) -> str | None:
    """`directory` in the [worktrees] table of Herdr's config.toml."""
    table = None
    for line in text.splitlines():
        header = re.match(r"^\s*\[([^\[\]]+)\]\s*(?:#.*)?$", line)
        if header:
            table = header.group(1).strip()
        elif table == "worktrees":
            m = TOML_STRING_KEY.match(line)
            if m and m.group(1) == "directory":
                return m.group(2) if m.group(2) is not None else m.group(3)
    return None


def herdr_worktrees_dir() -> Path:
    """Where `herdr worktree create` puts checkouts, as <directory>/<repo>/<branch-slug>."""
    config = Path(os.environ.get("XDG_CONFIG_HOME") or "~/.config").expanduser() / "herdr" / "config.toml"
    try:
        configured = worktrees_dir_from_config(config.read_text())
    except OSError:
        configured = None
    return Path(configured or "~/.herdr/worktrees").expanduser()


def parse_worktree_porcelain(text: str) -> list[dict]:
    """`git worktree list --porcelain`: one dict per worktree, the main checkout first."""
    entries: list[dict] = []
    current: dict | None = None
    for line in (text or "").splitlines():
        if line.startswith("worktree "):
            current = {"path": line[len("worktree "):], "branch": None, "locked": False, "prunable": False}
            entries.append(current)
        elif current is None:
            continue
        elif line.startswith("branch "):
            ref = line[len("branch "):]
            current["branch"] = ref[len("refs/heads/"):] if ref.startswith("refs/heads/") else ref
        elif line.split(" ", 1)[0] in ("locked", "prunable"):
            current[line.split(" ", 1)[0]] = True
    return entries


def other_kind(path: str) -> str:
    return next((kind for marker, kind in OTHER_KINDS if marker in path), "other")


def repo_paths(path: str) -> dict:
    """Whether `path` is the top of a linked worktree, and the main checkout of its repository."""
    if not os.path.isdir(path):
        return {"exists": False, "git": False, "linked": False}
    lines = (git_out(path, "rev-parse", "--git-dir", "--git-common-dir", "--show-toplevel") or "").splitlines()
    if len(lines) < 3 or os.path.realpath(lines[2]) != os.path.realpath(path):
        return {"exists": True, "git": False, "linked": False}
    git_dir, common = (os.path.realpath(os.path.join(path, p)) for p in lines[:2])
    main_root = os.path.dirname(common) if os.path.basename(common) == ".git" else common
    return {"exists": True, "git": True, "linked": git_dir != common,
            "main_root": main_root, "repo": os.path.basename(main_root)}


# Global git options for the checks that gate a lane (sweep, cleanup, approve-plan, risk): no file system monitor
# and no untracked cache may let git skip its scan of the worktree, and the check never writes the index.
SCAN_OPTIONS = ("--no-optional-locks", "-c", "core.fsmonitor=false", "-c", "core.untrackedCache=false")


def in_fleet_dir(path: str) -> bool:
    """A path under the lane's .fleet/ directory. A file or symlink named .fleet is not: only the directory holds
    the lane's records, and only the directory is archived."""
    return path.startswith(FLEET_DIR + "/")


def count_dirty(entries: list[list[str]] | None) -> int | None:
    """The changes in `status_entries`, not counting the lane's .fleet/ directory: one for each entry with a path
    outside it. A rename stays one change, and a rename out of .fleet/ counts."""
    if entries is None:
        return None
    return sum(1 for paths in entries if not all(in_fleet_dir(p) for p in paths))


def dirty_count(path: str) -> int | None:
    """The uncommitted changes of the lane at `path`, for sweep and cleanup: each untracked directory counts as one,
    whatever the user's settings for untracked files, the file system monitor or the untracked cache say. None
    when git status fails."""
    return count_dirty(status_entries(path, "normal", scan=True))


def flagged_count(path: str) -> int | None:
    """Paths outside .fleet/ that the index marks assume-unchanged (a lowercase tag in `git ls-files -v`) or
    skip-worktree (`S`) and that exist in the worktree. git status does not look at them, so nobody can tell
    whether they hold work. A skip-worktree path that is absent (a sparse checkout) holds none. Reads only; None
    when git fails."""
    out = git_text(path, "ls-files", "-v", "-z", errors="surrogateescape", options=SCAN_OPTIONS)
    if out is None:
        return None
    count = 0
    for entry in out.split("\0"):
        if len(entry) < 3:
            continue
        tag, name = entry[0], entry[2:]
        if (tag.islower() or tag == "S") and not in_fleet_dir(name) and os.path.lexists(os.path.join(path, name)):
            count += 1
    return count


def flagged_reason(n: int) -> str:
    return f"{plural(n, 'path')} marked assume-unchanged or skip-worktree"


def base_refs(path: str) -> list[str]:
    """The branches that a merged lane is in: the remote's default branch, and a local main or master."""
    refs = []
    remote = git_out(path, "rev-parse", "--abbrev-ref", "origin/HEAD")
    if remote and remote != "origin/HEAD":
        refs.append(remote)
    local = next((name for name in ("main", "master")
                  if git_ok(path, "rev-parse", "--verify", "--quiet", f"refs/heads/{name}")), None)
    if local:
        refs.append(local)
    return refs


def pick_pr(prs: list[dict]) -> dict | None:
    """The pull request that decides a lane: an open one, else the newest merged one, else the newest closed one."""
    for state in ("OPEN", "MERGED", "CLOSED"):
        hits = [p for p in prs if p.get("state") == state]
        if hits:
            return max(hits, key=lambda p: (p.get("mergedAt") or "", p.get("number") or 0))
    return None


def pr_for_branch(path: str, branch: str) -> tuple[dict | None, str | None]:
    """(pull request, error). gh runs in the lane, so it finds the repository from the lane's remote."""
    if not shutil.which("gh"):
        return None, "gh not installed"
    try:
        cp = run(["gh", "pr", "list", "--head", branch, "--state", "all", "--limit", "20", "--json", PR_FIELDS],
                 timeout=30, cwd=path)
    except FleetError as e:
        return None, str(e)
    if cp.returncode != 0:
        return None, first_line(cp.stderr or cp.stdout) or "gh pr list failed"
    try:
        prs = json.loads(cp.stdout or "[]")
    except ValueError:
        return None, "gh pr list printed no JSON"
    return pick_pr(prs if isinstance(prs, list) else []), None


def pr_commit_oids(path: str, pr: dict) -> list[str] | None:
    """The commits that gh lists for a pull request, or None when gh fails.

    gh lists at most GH_COMMITS_PAGE commits, the oldest first, and does not say when it stops early.
    """
    if not shutil.which("gh"):
        return None
    try:
        cp = run(["gh", "pr", "view", pr.get("url") or str(pr["number"]), "--json", "commits",
                  "--jq", ".commits[].oid"], timeout=30, cwd=path)
    except FleetError:
        return None
    return cp.stdout.split() if cp.returncode == 0 else None


def commits_ahead(path: str, head: str | None, pr: dict | None, merged_into: str | None,
                  commits_lookup=None) -> tuple[int | None, str]:
    """Commits on HEAD that the pull request's head lacks.

    Without that head in the clone: for a merged pull request, the commits that GitHub lists for it;
    else the base, or every remote.
    """
    oid = (pr or {}).get("headRefOid")
    if oid and git_ok(path, "cat-file", "-e", f"{oid}^{{commit}}"):
        return count_out(git_out(path, "rev-list", "--count", f"{oid}..HEAD")), f"PR #{pr['number']}"
    if merged_into:
        return 0, merged_into
    out = git_out(path, "rev-list", "HEAD", "--not", "--remotes")
    if out is None:
        return None, "remotes"
    unpushed = out.split()
    if pr and pr.get("state") == "MERGED":
        # The head can be a commit that this clone never fetched (a merge of the base made on GitHub or in
        # another clone), and the remote deletes a merged branch. Then GitHub's list of the pull request's
        # commits decides. Each listed commit is in the head, so when HEAD is listed, the head holds every
        # commit of the branch. A full page that does not list HEAD can be cut short: then nobody can tell.
        listed = (commits_lookup or pr_commit_oids)(path, pr)
        if listed is not None:
            if head and head in listed:
                return 0, f"PR #{pr['number']}"
            if len(listed) >= GH_COMMITS_PAGE:
                return None, "remotes"
            listed = set(listed)
            unpushed = [c for c in unpushed if c not in listed]
    return len(unpushed), "remotes"


def busy_from_process_info(info: dict) -> str | None:
    """The program in the foreground of a shell pane, unless it is the shell itself."""
    group, shell = info.get("foreground_process_group_id"), info.get("shell_pid")
    if group is None or shell is None or group == shell:
        return None
    procs = info.get("foreground_processes") or [{}]
    return procs[0].get("name") or procs[0].get("cmdline") or "a program"


def foreground_program(pane: str) -> str | None:
    try:
        info = herdr("pane", "process-info", "--pane", pane).get("process_info") or {}
    except FleetError:
        return "an unknown program"
    return busy_from_process_info(info)


def lane_facts(stub: dict, caller_pane: str | None, caller_cwd: str, pr_lookup=None, commits_lookup=None) -> dict:
    """What sweep and cleanup decide on, for one lane. Reads only."""
    f = dict(stub)
    path = f["path"]
    f["orch"] = lane_owner(path)
    f["panes"] = [{"pane": p.get("pane_id"), "agent": p.get("agent"), "status": p.get("agent_status")}
                  for p in stub.get("panes") or []]
    f["self"] = inside(caller_cwd, path) or any(p["pane"] == caller_pane for p in f["panes"])
    for p in f["panes"]:
        if not p["agent"]:
            p["busy"] = foreground_program(p["pane"])
    if not (f.get("exists") and f.get("git") and f.get("linked")):
        return f
    f["branch"] = git_out(path, "symbolic-ref", "--quiet", "--short", "HEAD") or None
    f["head"] = git_out(path, "rev-parse", "HEAD")
    f["dirty"] = dirty_count(path)
    f["flagged"] = flagged_count(path)
    if f["branch"] is None:
        # A detached checkout (a review at one commit, say) loses nothing when a branch, remote or tag holds HEAD.
        f["unreachable"] = count_out(git_out(path, "rev-list", "--count", "HEAD", "--not", "--branches",
                                             "--remotes", "--tags"))
        f.update(pr=None, pr_error=None, merged_into=None, ahead=f["unreachable"], ahead_of="branches")
        return f
    bases = base_refs(path)
    f["default_branch"] = f["branch"] is not None and any(f["branch"] == b.split("/", 1)[-1] for b in bases)
    f["merged_into"] = next((b for b in bases if git_ok(path, "merge-base", "--is-ancestor", "HEAD", b)), None)
    f["pr"], f["pr_error"] = (pr_lookup or pr_for_branch)(path, f["branch"]) if f["branch"] else (None, None)
    f["ahead"], f["ahead_of"] = commits_ahead(path, f["head"], f["pr"], f["merged_into"], commits_lookup)
    f["branch_moved"] = branch_moved(path, f["branch"], f["head"])
    return f


def branch_moved(path: str, branch: str, head: str | None) -> bool | None:
    """Whether the branch moved since it was created: the oldest entry of its reflog, `branch: Created from ...`,
    is not HEAD. None when that cannot be told: no reflog, no entry, or the creation entry expired."""
    out = git_out(path, "reflog", "show", "--format=%H %gs", f"refs/heads/{branch}", "--")
    oldest = (out or "").splitlines()[-1:]
    if not oldest or not head:
        return None
    oid, _, subject = oldest[0].partition(" ")
    if not subject.startswith("branch: Created from"):
        return None
    return oid != head


def lane_blockers(f: dict) -> list[str]:
    """Reasons that forbid removing the lane's worktree at all, merged or not."""
    if not f.get("exists"):
        return ["checkout missing; close its workspace with herdr workspace close" if f.get("workspace")
                else "checkout missing"]
    if not f.get("git"):
        return ["not a git worktree; its repository may be gone. Remove the folder yourself"]
    if not f.get("linked"):
        return ["the repository's main checkout"]
    out = []
    if f.get("self"):
        out.append("this session runs here")
    if f.get("locked"):
        out.append("worktree is locked")
    if not f.get("branch"):
        lost = f.get("unreachable")
        if lost is None:
            out.append("detached HEAD; cannot tell whether a branch holds its commits")
        elif lost:
            out.append(f"detached HEAD with {plural(lost, 'commit')} on no branch")
    elif f.get("default_branch"):
        out.append(f"on the default branch {f['branch']}")
    for p in f.get("panes") or []:
        agent, status = p.get("agent"), p.get("status")
        if agent and status in ACTIVE_STATUSES:
            out.append(f"{agent} {status} in {p['pane']}")
        elif agent and agent not in EXIT_COMMAND:
            out.append(f"{agent} in {p['pane']}: exit it yourself")
        elif not agent and p.get("busy"):
            out.append(f"{p['busy']} running in {p['pane']}")
    dirty = f.get("dirty")
    if dirty is None:
        out.append("git status failed")
    elif dirty:
        out.append(plural(dirty, "uncommitted change"))
    flagged = f.get("flagged", 0)  # lane_facts sets it for every linked worktree
    if flagged is None:
        out.append("git ls-files failed")
    elif flagged:
        out.append(flagged_reason(flagged))
    return out


def classify(f: dict) -> tuple[str, list[str]]:
    """'ready' (cleanup removes it), 'waiting' (its pull request is open) or 'keep', with the reasons."""
    pr = f.get("pr") or None
    state = pr.get("state") if pr else None
    label = f"PR #{pr['number']}" if pr else ""
    pr_note = [f"{label} {str(state).lower()}"] if pr else []
    blockers = lane_blockers(f)
    if blockers:
        return "keep", blockers + pr_note
    if not f.get("branch"):
        return "ready", ["detached HEAD; a branch or remote holds its commit"]
    ahead, ahead_of = f.get("ahead"), f.get("ahead_of") or ""
    if state == "OPEN":
        return "waiting", pr_note + ([f"{plural(ahead, 'commit')} not pushed"] if ahead else [])
    if state == "MERGED" or f.get("merged_into"):
        merge_note = [f"in {f['merged_into']}"] if f.get("merged_into") and state != "MERGED" else []
        if ahead is None:
            return "keep", pr_note + merge_note + ["cannot tell whether every commit is pushed"]
        if ahead:
            where = "not in it" if ahead_of.startswith("PR #") else "not pushed"
            return "keep", pr_note + merge_note + [f"{plural(ahead, 'commit')} {where}"]
        return "ready", merge_note + pr_note
    if state == "CLOSED":
        return "keep", [f"{label} closed without merging"]
    return "keep", ["no pull request" + (f" (gh: {f['pr_error']})" if f.get("pr_error") else "")]


def branch_plan(f: dict) -> tuple[bool, str]:
    """Whether cleanup deletes the lane's local branch, and why."""
    if not f.get("branch"):
        return False, "detached HEAD"
    verdict = f.get("verdict") or classify(f)[0]
    if verdict != "ready":
        return False, "not merged"
    if (f.get("ahead_of") or "").startswith("PR #") or f.get("merged_into"):
        return True, "merged"
    return False, "the pull request's head commit is not in this clone"


def finish_lane(f: dict) -> dict:
    f["blockers"] = lane_blockers(f)
    f["verdict"], f["reasons"] = classify(f)
    f["delete_branch"], f["branch_note"] = branch_plan(f)
    f["target"] = f.get("workspace") or short_path(f["path"])
    return f


def enumerate_lanes() -> tuple[list[dict], list[str]]:
    """Lane stubs (worktree workspaces, then checkouts in Herdr's worktrees directory) and the main checkouts open in Herdr."""
    workspaces = herdr("workspace", "list").get("workspaces", [])
    by_workspace: dict[str, list[dict]] = {}
    for p in herdr("pane", "list").get("panes", []):
        by_workspace.setdefault(p.get("workspace_id"), []).append(p)
    stubs: list[dict] = []
    checkouts: list[str] = []
    for w in workspaces:
        tree = w.get("worktree") or {}
        path = tree.get("checkout_path")
        if not path:
            continue
        if tree.get("is_linked_worktree"):
            stubs.append({"workspace": w.get("workspace_id"), "label": w.get("label"), "path": path,
                          "panes": by_workspace.get(w.get("workspace_id"), [])})
        else:
            checkouts.append(path)
    open_paths = {os.path.realpath(s["path"]) for s in stubs}
    root = str(herdr_worktrees_dir())
    for d in sorted(glob.glob(os.path.join(glob.escape(root), "*", "*"))):
        if os.path.isdir(d) and os.path.realpath(d) not in open_paths:
            stubs.append({"workspace": None, "label": None, "path": d, "panes": []})
    return stubs, checkouts


def match_target(target: str, stubs: list[dict]) -> dict | None:
    for s in stubs:
        if s.get("workspace") and s["workspace"] == target:
            return s
    path = os.path.realpath(os.path.expanduser(target))
    return next((s for s in stubs if os.path.realpath(s["path"]) == path), None)


def lane_stubs(others: bool = True) -> tuple[list[dict], list[dict]]:
    """(lane stubs, other worktrees): herdr's worktree workspaces and the checkouts in its worktrees directory, then
    each linked worktree with a .fleet/ folder that the `git worktree list` of a clone shows. Each stub has its
    repo_paths and `locked`. Runs herdr and git, never gh.

    A clone made by copying another clone's folder lists the first clone's worktrees as its own, from stale copies
    of their entries, while each such worktree's own .git file names the first clone. So a worktree belongs to the
    main checkout that its own .git names (repo_paths), never to the clone whose listing showed it; it is listed once,
    and its `locked` comes from the listing of its own main checkout. A listed folder that is gone (prunable) has no
    .git to ask: it stays with the listing that shows it. `others=False` skips the other worktrees (their
    attribution costs a git call each), for callers that only need the lanes."""
    stubs, checkouts = enumerate_lanes()
    for s in stubs:
        s.update(repo_paths(s["path"]))
    repos: dict[str, str] = {}
    for root in [s["main_root"] for s in stubs if s.get("main_root")] + checkouts:
        repos.setdefault(os.path.realpath(root), root)
    known = {os.path.realpath(s["path"]): s for s in stubs}
    listings: dict[str, dict[str, dict]] = {}

    def listing(root: str) -> dict[str, dict]:
        """The linked worktrees that `git worktree list` in `root` shows, by real path, in order (read once)."""
        key = os.path.realpath(root)
        if key not in listings:
            cp = run_git(root, "worktree", "list", "--porcelain")
            entries = parse_worktree_porcelain(cp.stdout if cp is not None and cp.returncode == 0 else "")
            listings[key] = {os.path.realpath(e["path"]): e for e in entries[1:]}
        return listings[key]
    found: list[dict] = []
    seen: set[str] = set()
    for _, root in sorted(repos.items()):
        for real, e in listing(root).items():
            if real in seen:
                continue  # listed once, also when several clones show it
            seen.add(real)
            stub = known.get(real)
            has_fleet = stub is None and os.path.isdir(os.path.join(e["path"], FLEET_DIR))
            if stub is None and not has_fleet and not others:
                continue
            info = stub if stub is not None else repo_paths(e["path"]) if os.path.isdir(e["path"]) else {}
            own = info.get("main_root") if info.get("git") else root
            locked = listing(own).get(real, e)["locked"]
            if stub is not None:
                stub["locked"] = locked
            elif has_fleet:
                s = {"workspace": None, "label": None, "path": e["path"], "panes": [], "locked": locked, **info}
                stubs.append(s)
                known[real] = s
            else:
                found.append({"repo": os.path.basename(own), "path": e["path"], "branch": e["branch"],
                              "kind": other_kind(e["path"]), "prunable": e["prunable"]})
    return stubs, found


def collect_lanes(targets: list[str] | None = None, pr_lookup=None,
                  select=None, others: bool = True) -> tuple[list[dict], list[dict], list[str]]:
    """(lanes with their verdicts, other worktrees, targets that name no lane). Only `targets`, when given.

    `select` (a stub -> bool) keeps only some lanes before their facts are read, so that `board` looks up the
    pull requests of its own project only. `others=False`: no other worktrees (lane_stubs).
    """
    stubs, others = lane_stubs(others)
    missing: list[str] = []
    if targets is not None:
        chosen: list[dict] = []
        for t in targets:
            s = match_target(t, stubs)
            if s is None:
                missing.append(t)
            elif all(s is not c for c in chosen):
                chosen.append(s)
        stubs = chosen
    if select is not None:
        stubs = [s for s in stubs if select(s)]
    caller_pane, caller_cwd = os.environ.get("HERDR_PANE_ID"), os.getcwd()
    with ThreadPoolExecutor(max_workers=8) as pool:
        lanes = list(pool.map(lambda s: finish_lane(lane_facts(s, caller_pane, caller_cwd, pr_lookup)), stubs))
    return lanes, others, missing


def lane_why(f: dict) -> str:
    named = " ".join(f["reasons"])
    agents = [f"{p['pane'].rsplit(':', 1)[-1]} {p['agent']} {p['status']}" for p in f.get("panes") or []
              if p.get("agent") and not re.search(re.escape(p["pane"]) + r"\b", named)]
    return "; ".join(f["reasons"] + agents)


def print_sweep(lanes: list[dict], others: list[dict]) -> None:
    groups = [(title, sorted((l for l in lanes if l["verdict"] == verdict),
                             key=lambda l: (l.get("repo") or "", l.get("branch") or l["path"])))
              for verdict, title in VERDICTS]
    owned = any(l.get("orch") for l in lanes)

    def cells(l: dict) -> list[str]:
        return [l["target"], l.get("repo") or "-", l.get("branch") or "-"] + (
            [f"orch {l['orch']}" if l.get("orch") else "unowned"] if owned else [])
    rows = [cells(l) for _, group in groups for l in group]
    widths = [max([len(r[i]) for r in rows] or [0]) for i in range(len(rows[0]) if rows else 3)]
    if not lanes:
        print("No lanes: no worktree workspace is open in Herdr, and its worktrees directory is empty.\n")
    for title, group in groups:
        if not group:
            continue
        print(f"{title} ({len(group)})")
        for l in group:
            print("  " + "  ".join(c.ljust(widths[i]) for i, c in enumerate(cells(l))) + "  " + lane_why(l))
        print()
    if others:
        counts: dict[str, dict[str, int]] = {}
        for o in others:
            kinds = counts.setdefault(o["repo"], {})
            kinds[o["kind"]] = kinds.get(o["kind"], 0) + 1
        print("OTHER WORKTREES: not lanes; fleet never touches them")
        for repo in sorted(counts):
            print(f"  {repo}: " + ", ".join(f"{n} {kind}" for kind, n in sorted(counts[repo].items())))
        prunable = sum(1 for o in others if o.get("prunable"))
        if prunable:
            print(f"  {prunable} of them have no folder any more (git worktree prune)")
        print()
    print("`fleet cleanup TARGET...` removes ready lanes. With --unmerged it also removes a clean lane without a merge,"
          " and keeps its branch." + (" A lane of another orch needs --other-orch." if owned else ""))


def cmd_sweep(args: argparse.Namespace) -> int:
    require_herdr()
    lanes, others, _ = collect_lanes()
    if args.json:
        print(json.dumps({"lanes": lanes, "others": others}, indent=2, ensure_ascii=False))
    else:
        print_sweep(lanes, others)
    return 0


def archive_lane_files(path: str, repo: str | None, branch: str | None) -> str | None:
    """Copy the lane's .fleet/ records (not panes.json) to its project's lanes/: removing the worktree deletes them."""
    src = Path(path) / FLEET_DIR
    files = [p for p in sorted(src.rglob("*")) if p.is_file() and p.name != PANES_FILE] if src.is_dir() else []
    if not files:
        return None
    slug = re.sub(r"[^A-Za-z0-9._-]+", "-", branch or Path(path).name).strip("-.") or "lane"
    home = project_for(path)
    base = home / "lanes" if home else fleet_home() / "archive" / (repo or "unknown")
    dest = base / f"{slug}-{time.strftime('%Y%m%d-%H%M%S')}"
    for f in files:
        target = dest / f.relative_to(src)
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(f, target)
    return str(dest)


def cleanup_plan(f: dict) -> dict:
    return {"target": f["target"], "path": f["path"], "verdict": f["verdict"], "reasons": f["reasons"],
            "exit": [f"{p['pane']} {p['agent']}" for p in f["panes"] if p.get("agent")],
            "archive": (Path(f["path"]) / FLEET_DIR).is_dir(),
            "remove": "herdr worktree remove" if f.get("workspace") else "git worktree remove",
            "branch": (f"delete {f['branch']}" if f["delete_branch"] else
                       f"keep {f['branch']}: {f['branch_note']}" if f.get("branch") else "none: detached HEAD"),
            "follow_ups": planned_follow_ups(f)}


def planned_follow_ups(f: dict) -> dict:
    """What cleanup would do with the follow-ups that the lane's branch holds: {close: [{id, text}], release: [...]},
    or {error}, by the same rule as the cleanup (lane_work_merged). Reads only (no lock): a line without an ID shows with id None and gets one at the
    cleanup."""
    branch = f.get("branch")
    if not branch:
        return {}
    home = project_for(f.get("main_root"), create=False)
    held, error = lane_follow_ups(home)
    if error:
        return {"error": error}
    items = held.get(branch) or []
    return {("close" if lane_work_merged(f) else "release"): items} if items else {}


def finish_branch(f: dict) -> str:
    """Delete the lane's local branch when the plan says so and the branch has not moved since the facts."""
    branch = f.get("branch")
    if not branch:
        return "none: detached HEAD"
    if not f.get("delete_branch"):
        return f"kept {branch}: {f.get('branch_note')}"
    tip = git_out(f["main_root"], "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}")
    if tip != f.get("head"):
        return f"kept {branch}: it moved after the check"
    cp = run_git(f["main_root"], "branch", "-D", branch)
    if cp is None or cp.returncode != 0:
        return f"kept {branch}: " + (first_line(cp.stderr or cp.stdout) if cp is not None else "git branch -D failed")
    return f"deleted {branch}"


def clean_lane(f: dict, timeout: float) -> dict:
    """Exit the lane's agents, archive its .fleet/, count its changes again, remove its worktree when there are
    none, then delete its branch when merged."""
    out: dict = {"target": f["target"], "path": f["path"], "ok": False, "exited": []}
    sessions: list[dict] = []
    owner = f["orch"] if "orch" in f else lane_owner(f["path"])  # the owner that the checks saw
    marked = None  # whether mark_lane_removal created .fleet/, once the lane is marked
    try:
        if "home" not in f:  # a caller other than cmd_cleanup: resolve it now, before anything changes
            refused = carry_lane_homes([f])
            if refused:
                out["error"] = refused[0]["reasons"][0]
                return out
        for p in f["panes"]:
            if not p.get("agent"):
                continue
            info = pane_info(p["pane"])
            status = info.get("agent_status")
            if status in ACTIVE_STATUSES:
                out["error"] = f"{p['agent']} in {p['pane']} is {status} now; the worktree stays"
                return out
            if not exit_agent(p["pane"], p["agent"], timeout):
                out["error"] = f"{p['agent']} in {p['pane']} did not exit; the worktree stays"
                return out
            out["exited"].append(p["pane"])
            sessions.append({"pane": p["pane"], "agent": p["agent"], "session": session_id_of(info)})
        try:
            out["archive"] = archive_lane_files(f["path"], f.get("repo"), f.get("branch"))
        except OSError as e:
            out["error"] = f"could not archive .fleet/ ({e}); the worktree stays"
            return out
        # The owner again, after the agents exited: an adopt may have moved the lane to another orch meanwhile.
        # The mark keeps any adopt or spawn from moving it until the removal ends.
        marked = mark_lane_removal(f, owner)
        # Check again, right before the removal: an agent can write a file or flag a path while it exits, and
        # neither removal command sees an untracked file that the user's git settings hide. Never --force.
        flagged = flagged_count(f["path"])
        if flagged is None:
            out["error"] = "git ls-files failed; the worktree stays"
            return out
        if flagged:
            out["error"] = f"{flagged_reason(flagged)}; the worktree stays"
            return out
        dirty = dirty_count(f["path"])
        if dirty is None:
            out["error"] = "git status failed; the worktree stays"
            return out
        if dirty:
            out["error"] = f"{plural(dirty, 'uncommitted change')} appeared after the check; the worktree stays"
            return out
        # git honors status.showUntrackedFiles when it removes a worktree: with `no`, it deletes untracked files.
        # `-c status.showUntrackedFiles=all` makes it refuse a worktree with an untracked file at the moment of the
        # removal, whatever the user's configuration.
        remove = ["git", "-C", f["main_root"], "-c", "status.showUntrackedFiles=all", "worktree", "remove", f["path"]]
        if f.get("workspace"):
            try:
                herdr("worktree", "remove", "--workspace", f["workspace"], "--json", timeout=120)
            except FleetError as e:
                # The worktree and the branch stay, as in 0.8.3: no second removal after a wait that new work may
                # have used. The user can remove it by hand.
                out["error"] = f"{e}; the worktree stays"
                out["by_hand"] = (f"{shlex.join(remove)}, then `herdr workspace close {f['workspace']}`")
                return out
        else:
            cp = run(remove, timeout=120)
            if cp.returncode != 0:
                out["error"] = first_line(cp.stderr or cp.stdout) or "git worktree remove failed"
                return out
        out["removed"] = True
        parent = os.path.dirname(os.path.realpath(f["path"]))
        if os.path.dirname(parent) == os.path.realpath(herdr_worktrees_dir()):
            try:
                os.rmdir(parent)  # Herdr's <directory>/<repo>/ folder, only when this was its last checkout
            except OSError:
                pass
        out["branch"] = finish_branch(f)
        out.update(close_lane_follow_ups(f))  # after the removal and the branch step; it never fails the cleanup
        out["ok"] = True
    except FleetError as e:
        out["error"] = str(e)
    finally:
        if marked is not None and not out.get("removed"):
            unmark_lane_removal(f, marked)
        record("cleanup", f.get("main_root"), lane=f["path"], workspace=f.get("workspace"), branch=f.get("branch"),
               orch=owner, by_hand=out.get("by_hand"), verdict=f.get("verdict"), reasons=f.get("reasons"), exited=sessions, archive=out.get("archive"),
               removed=bool(out.get("removed")), branch_result=out.get("branch"), ok=out["ok"],
               error=out.get("error"), follow_ups_closed=out.get("follow_ups_closed"),
               follow_ups_released=out.get("follow_ups_released"), follow_up_error=out.get("follow_up_error"))
    return out


def other_orch_refusals(lanes: list[dict], name: str | None, allowed: bool, verb: str) -> list[dict]:
    """The `--other-orch` guard of cleanup and adopt: a lane whose lane.json names an orch other than the caller's
    (current_orch in the lane's project, `name` from --orch) is refused unless `allowed`. An unowned lane, and a lane
    of the caller's own orch, pass. A caller with no orch treats every owned lane as another orch's. An unknown
    --orch raises."""
    if allowed:
        return []
    out, mine = [], {}
    for f in lanes:
        owner = f["orch"] if "orch" in f else lane_owner(f["path"])
        if not owner:
            continue
        if "home" not in f:
            continue  # its project lookup failed: carry_lane_homes refused it
        root = os.path.realpath(f.get("main_root") or f["path"])
        if root not in mine:
            home = carried_home(f)
            if name and not home:
                raise FleetError(f"--orch {name}: {f['path']} is in no fleet project")
            mine[root] = current_orch(home, name)[0] if home else None
        if owner != mine[root]:
            out.append({"target": f.get("target") or f["path"], "owner": owner, "orch": mine[root],
                        "reasons": [other_orch_reason(f["path"], owner, verb)]})
    return out


def other_orch_reason(path: str, owner: str, verb: str) -> str:
    return f"lane {path} belongs to orch {owner}; pass --other-orch to {verb} it"


def cmd_cleanup(args: argparse.Namespace) -> int:
    require_herdr()
    lanes, _, missing = collect_lanes(targets=args.targets, others=False)
    if missing:
        raise FleetError(f"not a lane: {', '.join(missing)}. `fleet sweep` lists the lanes")
    refused = carry_lane_homes(lanes)  # once, for the guard, the mark and the unmark
    refused += other_orch_refusals(lanes, args.orch, args.other_orch, "remove")
    refused += [{"target": f["target"], "verdict": f["verdict"], "reasons": f["reasons"]}
                for f in lanes if not (f["verdict"] == "ready" or (args.unmerged and not f["blockers"]))]
    if refused:
        print(json.dumps({"ok": False, "changed": "nothing", "refused": refused}, indent=2, ensure_ascii=False))
        return 2
    if args.dry_run:
        print(json.dumps({"ok": True, "dry_run": True, "plan": [cleanup_plan(f) for f in lanes]},
                         indent=2, ensure_ascii=False))
        return 0
    results = [clean_lane(f, args.timeout) for f in lanes]
    ok = all(r["ok"] for r in results)
    print(json.dumps({"ok": ok, "lanes": results}, indent=2, ensure_ascii=False))
    return 0 if ok else 2


def cmd_adopt(args: argparse.Namespace) -> int:
    """Set or move the orch that owns each target lane, in its .fleet/lane.json. A target is a lane as sweep prints
    it, or the top of any linked worktree (a hand-made one gets its .fleet/). Every check runs before any write: an
    unknown orch, a lane outside a project, and a lane of another orch without --other-orch refuse the whole
    command. The owner checks run before the preparation (.fleet/ and its exclude entry, the branch) and again
    under the locks; a refusal there removes the empty .fleet/ that the preparation made."""
    require_herdr()
    stubs, _ = lane_stubs(others=False)
    me = os.environ.get("HERDR_PANE_ID") or None
    chosen, refused = [], []
    for t in args.targets:
        s = match_target(t, stubs)
        if s is None:
            path = os.path.realpath(os.path.expanduser(t))
            info = repo_paths(path)
            if not info.get("linked"):
                refused.append({"target": t, "reasons": [f"not a lane and not the top of a linked worktree: {t}; "
                                                         "`fleet sweep` lists the lanes"]})
                continue
            s = {"workspace": None, "label": None, "path": path, "panes": [], **info}
        if any(os.path.realpath(c["path"]) == os.path.realpath(s["path"]) for c, _, _ in chosen):
            continue
        home = project_for(s.get("main_root"), create=False) if s.get("main_root") else None
        if not home:
            refused.append({"target": t, "reasons": [f"{s['path']} is in no fleet project; `fleet orch claim` in "
                                                     "its repository makes one"]})
            continue
        orchs = read_orchs(home)
        try:
            name, _ = current_orch(home, args.orch, orchs)
        except FleetError as e:
            refused.append({"target": t, "reasons": [str(e)]})
            continue
        if not name:
            refused.append({"target": t, "reasons": [f"no orch to adopt it for in project {home.name}: run this from "
                                                     "an orch's pane, or pass --orch NAME"]})
            continue
        chosen.append((s, home, name))
    def owner_refusals() -> list[dict]:
        out = []
        for s, _, name in chosen:
            target = s.get("workspace") or short_path(s["path"])
            pid = lane_removal(s["path"])
            if pid:
                out.append({"target": target, "reasons": [removal_refusal(s["path"], pid, "adopt")]})
                continue
            owner = lane_owner(s["path"])
            if owner and owner != name and not args.other_orch:
                out.append({"target": target, "owner": owner, "orch": name,
                            "reasons": [other_orch_reason(s["path"], owner, "adopt")]})
        return out
    refused += owner_refusals()  # read-only (lane.json files): a batch refused here changes no lane
    if refused:
        return refuse(refused=refused)
    made = [s["path"] for s, _, _ in chosen if not os.path.lexists(Path(s["path"]) / FLEET_DIR)]
    preps = {s["path"]: lane_owner_prep(s["path"]) for s, _, _ in chosen}  # git, before the locks
    done = []
    # Every check and every write under the lock of each project, taken in one order: an adopt or a spawn that
    # ran since the reads above is seen, and a refusal of one target still changes no target. Files only under it.
    with ExitStack() as locks:
        for home in sorted({os.path.realpath(h) for _, h, _ in chosen}):
            locks.enter_context(project_lock(Path(home)))
        refused = owner_refusals()
        if refused:
            for path in made:  # the .fleet/ that the preparation made, while it is still empty
                try:
                    (Path(path) / FLEET_DIR).rmdir()
                except OSError:
                    pass
            return refuse(refused=refused)
        for s, home, name in chosen:
            old = lane_owner(s["path"])
            if old == name:
                done.append({"lane": s["path"], "orch": name, "changed": False})
                continue
            path = write_lane_owner(s["path"], home, name, me, preps[s["path"]])
            record("adopt", s["path"], home=home, lane=s["path"], workspace=s.get("workspace"),
                   branch=preps[s["path"]]["branch"], orch=name, old=old)
            done.append({"lane": s["path"], "orch": name, "old": old, "changed": True, "lane_json": path})
    print(json.dumps({"ok": True, "lanes": done}, indent=2, ensure_ascii=False))
    return 0


# --------------------------------------------------------------------------
# orchestrator: orch, board, digest
#
# A project has orchestrators (orchs), one for each theme, each known by its name and its Herdr pane in
# <home>/orch.json. The helper derives the lane table (`board`) and what changed since an orch last looked
# (`digest`); the orchs write only decisions, follow-ups and rules: in <home>/PROJECT.md what the whole project
# shares, in <home>/orchs/<name>/ORCH.md the decisions and notes of one theme. board.json caches an orch's newest
# board for the SessionStart re-brief and never consumes a change. digest.json holds an orch's digest baseline: its
# cursor (a time), the byte offset that it read each monthly log up to, and the phase of each lane; only digest
# moves it. <home>/.lock serializes claim, release, rename, adopt, a digest that consumes, board.json writes and
# follow-up writes. --peek and the SessionStart hook never take it.
#
# orch.json has two shapes. The legacy one (0.8.x), one record with its `pane` at the top level, stays while the
# only orch of the project is `default`: that record is the orch `default`, and the root digest.json and board.json
# are its files. Format 2, {"format": 2, "orchs": {<name>: record}}, begins at the first claim of another name or
# at a rename (the root files then move into orchs/<name>/), and the file never goes back. read_orchs and
# write_orchs are the only way in and out; orch_files names an orch's files for either shape.

ORCH_FILE = "orch.json"
BOARD_FILE = "board.json"
DIGEST_FILE = "digest.json"
PROJECT_MD = "PROJECT.md"
ORCHS_DIR = "orchs"
ORCH_MD = "ORCH.md"
DEFAULT_ORCH = "default"
# Also a folder name under orchs/, so lowercase only: on a file system that ignores case, two names that differ only
# in case would share one folder, and so one ORCH.md, digest cursor and board.
ORCH_NAME = re.compile(r"[a-z0-9][a-z0-9._-]{0,39}")
LANE_FILE = "lane.json"  # <lane>/.fleet/lane.json: the orch that owns the lane, by name
LANE_FILE_MAX = 64 * 1024  # bytes of a lane.json that event_lane_owner reads at most
LANE_REMOVING = "removing"  # lane.json key: a cleanup is removing the lane ({"pid", "since"}); see mark_lane_removal
LOCK_FILE = ".lock"
LOCK_WAIT = 30  # seconds to wait for the project lock
DIGEST_EVENTS_MAX = 30
REBRIEF_LINES_MAX = 60
REBRIEF_READ_BUDGET = 1_000_000  # bytes of unread log that the SessionStart re-brief reads at most
PROJECT_TEMPLATE = """\
# Project: {name}

The orchestrator's memory for this project. `fleet board` and the event log keep the lanes; this file keeps
what nothing else knows. Keep each entry to one line.

## Rules
- none

## Decisions
- none

## Follow-ups
- none

## Notes
- none

## High-risk paths
- none
"""
ORCH_TEMPLATE = """\
# Orch: {name} (project {project})

The memory of orch {name}: the decisions and notes of its theme. The rules, the high-risk paths, the follow-ups
and what concerns the whole project stay in PROJECT.md. Keep each entry to one line.

## Decisions
- none

## Notes
- none
"""
REVIEW_REQUEST_FILE = re.compile(r"^REVIEW-REQUEST-(\d+)\.md$")
REVIEW_FILE = re.compile(r"^REVIEW-(\d+)(?:-[^/]+)?\.md$")  # REVIEW-<n>.md, or REVIEW-<n>-<critic>.md
VERDICT_LINE = re.compile(r"^[^\w\n]*VERDICT:[ \t]*(.*)$", re.M)


def marker_line(marker: str) -> str:
    """A regex for a marker at the start of a line, after optional non-word characters (a list dash, `**`, a
    backtick, `>`). A mention inside a sentence does not count. Compile it with re.M."""
    return r"^[^\w\n]*" + marker + r"(?!\w)"


# A round number has at most 9 digits; with the marker's (?!\w), a longer one is no marker. int() then never meets
# a number too long to convert.
READY_LINE = re.compile(marker_line(r"READY FOR REVIEW: round (\d{1,9})"), re.M)
PLAN_FILE = "PLAN.md"
PLAN_READY_LINE = re.compile(marker_line(r"PLAN READY: (\d{1,9})"), re.M)
PLAN_APPROVED_LINE = re.compile(marker_line(r"PLAN APPROVED: (\d{1,9})"), re.M)
PLAN_APPROVED_BY = re.compile(marker_line(r"PLAN APPROVED: (\d{1,9})") + r"(?:[ \t]+by[ \t]+(\w+))?", re.M)
RESEARCH_DIR = "research"
RESEARCH_DONE_LINE = re.compile(marker_line("RESEARCH DONE"), re.M)
RISK_LINE = re.compile(r"^[^\w\n]*Risk[*_`]*:[*_`]*[ \t]*(.*)$", re.M)
RISKS = ("none", "migration", "auth-payments", "deletion", "hotfix")  # only `none` is low risk
RISK_CATEGORIES = RISKS[1:]
# Built in, for every project: common migration directories. Project-specific paths go in PROJECT.md.
BUILTIN_RISK_PATTERNS = (("migration", "**/migrations/**"), ("migration", "**/migration/**"),
                         ("migration", "**/migrate/**"), ("migration", "**/alembic/**"))
RISK_SECTION = "High-risk paths"
RISK_PATTERN_LINE = re.compile(r"^[-*+]\s+([A-Za-z-]+):\s*(.*?)\s*$")
EMPTY_NOTE = re.compile(r"^(?:[-*]\s*)?(?:none\.?|<[^>]*>)?$", re.I)  # "-", "none", "- none", a template "<...>"
HEADING = re.compile(r"^(#{1,6})\s+(.*?)\s*#*\s*$")


def section_lines(text: str, title: str, every: bool = False) -> list[str]:
    """The lines under a `## <title>` heading (the title is a regex), up to the next heading of level 1 or 2.
    With `every`, the lines of every section with that title, in order; else of the first one."""
    lines: list[str] = []
    inside_section = False
    for line in (text or "").splitlines():
        m = HEADING.match(line)
        if m and len(m.group(1)) <= 2:
            if inside_section and not every:
                break
            inside_section = len(m.group(1)) == 2 and re.fullmatch(title, m.group(2), re.I) is not None
            continue
        if inside_section:
            lines.append(line)
    return lines


def section_text(text: str, title: str) -> list[str]:
    """The lines of a section that say something: not empty, `-`, `none`, `- none` or a template `<...>`."""
    return [l.rstrip() for l in section_lines(text, title)
            if l.strip() and not EMPTY_NOTE.match(l.strip()) and not READY_LINE.search(l)]


def first_note(text: str, title: str) -> str | None:
    lines = section_text(text, title)
    return re.sub(r"^[-*]\s+", "", lines[0].strip()) if lines else None


def read_text(path: Path) -> str:
    try:
        return Path(path).read_text(errors="replace")
    except OSError:
        return ""


# --------------------------------------------------------------------------
# follow-ups
#
# The orchestrator's open work: list items under `## Follow-ups` in PROJECT.md, `- [F7] <text>`, which end with
# ` (lane: <branch>)` once a lane took them. Only `fleet follow-up` writes IDs and lane marks; the orchestrator may
# still edit the section by hand, and a line without an ID gets the next one at the next write. A write changes
# only the lines that it must and keeps every other byte, runs under the project lock, and replaces the file
# atomically. IDs come from the counter in <home>/follow-ups.json, which only goes up, so an ID that `done`
# removed is never used again. The event log keeps each follow-up's history (best effort, as for every event).

FOLLOW_UPS_SECTION = r"Follow-?ups?"
FOLLOW_UPS_FILE = "follow-ups.json"
FOLLOW_UP_EVENTS = ("follow_up_added", "follow_up_taken", "follow_up_released", "follow_up_done")
FOLLOW_UP_MAX = 999_999_999  # IDs have at most 9 digits, like every number that the helper parses
# A list item at the start of a line: the bullet, an optional [Fn] ID, the text, an optional lane mark, and the
# trailing blanks, which a rewrite keeps.
FOLLOW_UP_ITEM = re.compile(r"^([-*+][ \t]+)(?:\[[Ff](\d{1,9})\](?:[ \t]+|(?=[ \t\r]*$)))?(.*?)"
                            r"(?:[ \t]+\(lane:[ \t]*([^()\s][^()]*?)[ \t]*\))?([ \t\r]*)$")
FOLLOW_UP_ID_ANYWHERE = re.compile(r"^[ \t]*[-*+][ \t]+\[[Ff](\d{1,9})\]", re.M)  # every ID in the file counts
FOLLOW_UP_ID_ARG = re.compile(r"[Ff]?(\d{1,9})")
EVENT_FOLLOW_UP_ID = re.compile(rb'"id"\s*:\s*"[Ff](\d{1,9})"')
INDENTED = re.compile(r"^[ \t]+\S")
BRANCH_MARK = re.compile(r"[^()\s]+")
NO_PROJECT_MD = "no PROJECT.md: `fleet orch claim` creates it"


class FollowUpRefused(Exception):
    """A follow-up action that changes nothing. The command exits 2; cleanup reports it."""

    def __init__(self, reason: str, **fields):
        super().__init__(reason)
        self.fields = fields


def split_lines(text: str) -> list[list[str]]:
    """[content, terminator] per line. Lines end at LF only (a CR before it goes to the terminator); the last line
    has the terminator "" when the file does not end with one. `"".join(c + t ...)` gives the text back."""
    parts = text.split("\n")
    lines = [[p[:-1], "\r\n"] if p.endswith("\r") else [p, "\n"] for p in parts[:-1]]
    if parts[-1]:
        lines.append([parts[-1], ""])
    return lines


def join_lines(lines: list[list[str]], final_newline: bool, eol: str) -> str:
    """The text of `lines`. A line that is no longer the last gets `eol`, and the last line ends as the file did."""
    for line in lines[:-1]:
        line[1] = line[1] or eol
    if lines:
        lines[-1][1] = (lines[-1][1] or eol) if final_newline else ""
    return "".join(c + t for c, t in lines)


def parse_follow_ups(text: str) -> dict:
    """The follow-ups of a PROJECT.md text, by line index.

    `sections`: the (first, end) line ranges of every `## Follow-ups` section, `end` exclusive. `items`: in file
    order, each with its ID (or None), text, lane mark, and its lines: the item line and its continuation, the
    lines indented under it, also across blank lines (the blank lines after its last indented line are not its).
    `placeholders`: the `- none`-style lines of the first section. `other_lines`: the lines under a Follow-ups
    heading that are no list item. `max_id`: the highest [Fn] number of any list item in the file.
    """
    lines = split_lines(text)
    contents = [c for c, _ in lines]
    sections: list[tuple[int, int]] = []
    start = None
    for i, line in enumerate(contents):
        m = HEADING.match(line)
        if m and len(m.group(1)) <= 2:
            if start is not None:
                sections.append((start, i))
                start = None
            if len(m.group(1)) == 2 and re.fullmatch(FOLLOW_UPS_SECTION, m.group(2), re.I):
                start = i + 1
    if start is not None:
        sections.append((start, len(contents)))
    items: list[dict] = []
    placeholders: list[int] = []
    other = 0
    for s, (first, end) in enumerate(sections):
        item, blanks = None, []
        for i in range(first, end):
            line = contents[i]
            if item is not None:
                if not line.strip():
                    blanks.append(i)
                    continue
                if INDENTED.match(line):
                    item["lines"] += blanks + [i]
                    blanks = []
                    continue
            item, blanks = None, []
            if not line.strip():
                continue
            if EMPTY_NOTE.match(line.strip()):
                if s == 0:
                    placeholders.append(i)
                continue
            m = FOLLOW_UP_ITEM.match(line)
            if not m:
                other += 1
                continue
            item = {"id": f"F{int(m.group(2))}" if m.group(2) else None,
                    "number": int(m.group(2)) if m.group(2) else None, "text": m.group(3), "lane": m.group(4),
                    "line": i, "lines": [i], "section": s, "match": m}
            items.append(item)
    numbers = [int(m.group(1)) for m in FOLLOW_UP_ID_ANYWHERE.finditer(text)]
    return {"lines": lines, "contents": contents, "sections": sections, "items": items,
            "placeholders": placeholders, "other_lines": other, "max_id": max(numbers, default=0),
            "eol": next((t for _, t in lines if t), "\n"), "final_newline": not text or text.endswith("\n")}


def follow_up_raw_detail(doc: dict, item: dict) -> list[str]:
    """The item's continuation lines as written, without their line terminators."""
    return [doc["contents"][i] for i in item["lines"][1:]]


def follow_up_view(doc: dict, item: dict) -> dict:
    """An item as the commands print it: ID, text, lane, and its continuation lines without their common
    indentation, when it has any."""
    out = {"id": item["id"], "text": item["text"], "lane": item["lane"]}
    raw = follow_up_raw_detail(doc, item)
    if raw:
        out["detail"] = textwrap.dedent("\n".join(raw)).split("\n")
    return out


def follow_up_listing(text: str) -> dict:
    doc = parse_follow_ups(text)
    return {"follow_ups": [follow_up_view(doc, it) for it in doc["items"]], "sections": len(doc["sections"]),
            "other_lines": doc["other_lines"]}


def logged_follow_up_numbers(home: Path) -> list[int]:
    """Every follow-up ID in the project's event log, also in a damaged line. Refuses when a log file cannot be
    read: the IDs that it holds would be missed."""
    d = home / EVENTS_DIR
    try:
        names = sorted(n for n in os.listdir(d) if n.endswith(".jsonl"))
    except FileNotFoundError:
        return []
    except OSError as e:
        raise FollowUpRefused(f"cannot read the event log {d} ({e.strerror or e}), so the next follow-up ID "
                              "cannot be told")
    numbers = []
    for name in names:
        try:
            data = (d / name).read_bytes()
        except OSError as e:
            raise FollowUpRefused(f"cannot read the event log {d / name} ({e.strerror or e}), so the next "
                                  "follow-up ID cannot be told")
        for line in data.split(b"\n"):
            if b"follow_up_" in line:
                numbers += [int(m.group(1)) for m in EVENT_FOLLOW_UP_ID.finditer(line)]
    return numbers


def read_follow_up_counter(home: Path) -> int | None:
    """The next follow-up number from <home>/follow-ups.json, or None when the file does not exist."""
    path = home / FOLLOW_UPS_FILE
    try:
        data = path.read_bytes()
    except FileNotFoundError:
        return None
    except OSError as e:
        raise FollowUpRefused(f"cannot read {path} ({e.strerror or e}); fix it by hand")
    try:
        value = json.loads(data.decode("utf-8")).get("next")
    except (ValueError, AttributeError):
        value = None
    if not isinstance(value, int) or isinstance(value, bool) or value < 1:
        raise FollowUpRefused(f'{path} does not hold {{"next": <number>}}; fix it by hand')
    return value


def next_follow_up_number(home: Path, doc: dict) -> int:
    """The next free number: the counter, or 1 + the highest in PROJECT.md and the event log when there is no
    counter yet. Never below 1 + the highest number in PROJECT.md (a line written by hand)."""
    counter = read_follow_up_counter(home)
    if counter is None:
        return max([doc["max_id"]] + logged_follow_up_numbers(home)) + 1
    return max(counter, doc["max_id"] + 1)


def read_project_md(home: Path) -> str | None:
    """PROJECT.md as text, or None when it does not exist. A file that is not UTF-8 is not read: a write could not
    keep its bytes."""
    path = home / PROJECT_MD
    try:
        data = path.read_bytes()
    except FileNotFoundError:
        return None
    except OSError as e:
        raise FleetError(f"cannot read {path}: {e.strerror or e}")
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        raise FleetError(f"{path} is not UTF-8; fix it by hand")


def write_project_md(home: Path, text: str) -> None:
    """Replace PROJECT.md atomically (a temporary file in its folder, then a rename), keeping its mode. A symlinked
    PROJECT.md stays a symlink: the file that it points to is replaced."""
    path = Path(os.path.realpath(home / PROJECT_MD))
    try:
        mode = path.stat().st_mode & 0o7777
    except FileNotFoundError:
        mode = 0o600
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        with open(tmp, "wb") as fh:
            fh.write(text.encode("utf-8"))
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            tmp.unlink()
        except OSError:
            pass
        raise


def parse_follow_up_id(value: str) -> int | None:
    m = FOLLOW_UP_ID_ARG.fullmatch((value or "").strip())
    return int(m.group(1)) if m else None


def with_lane_mark(content: str, m: re.Match, branch: str | None) -> str:
    """The item line with its ` (lane: <branch>)` mark added, replaced or (with None) removed; the rest stays."""
    return content[:m.end(3)] + (f" (lane: {branch})" if branch else "") + content[m.start(5):]


def follow_up_apply(home: Path, action: str, number: int | None = None, body: str | None = None,
                    branch: str | None = None, reason: str | None = None, source: str | None = None,
                    close: bool = False, wait: float | None = None) -> dict:
    """Run one follow-up action on PROJECT.md under the project lock.

    `action`: list (only give IDs), add, take, release, done, or lane (cleanup: every item whose lane mark is
    `branch`: closed as done with `close`, else released). Every refusal and every
    action that needs no change come first and write nothing. Then the counter moves (every write), the items
    without an ID get theirs, PROJECT.md is written once, and the events are recorded. Returns the result: `ok` False with `refused`
    for a refusal (`missing` when there is no PROJECT.md). Raises FleetError when the lock or PROJECT.md cannot be
    had, and OSError when a write fails.
    """
    with project_lock(home, wait):
        try:
            return follow_up_locked(home, action, number, body, branch, reason, source, close)
        except FollowUpRefused as e:
            return {"ok": False, "refused": str(e), **e.fields}


def follow_up_locked(home: Path, action: str, number, body, branch, reason, source, close) -> dict:
    text = read_project_md(home)
    if text is None:
        raise FollowUpRefused(NO_PROJECT_MD, missing=True)
    doc = parse_follow_ups(text)
    result: dict = {"ok": True}
    nothing = {"changed": "nothing", **follow_up_listing(text)}
    target = None
    selected: list[dict] = []
    # 1. Refusals, and the actions that need no change.
    if action in ("take", "release", "done"):
        found = [it for it in doc["items"] if it["number"] == number]
        if not found:
            raise FollowUpRefused(f"no follow-up F{number} in {home / PROJECT_MD}", id=f"F{number}")
        if len(found) > 1:
            raise FollowUpRefused(f"F{number} is on {len(found)} lines of {home / PROJECT_MD}; fix it by hand",
                                  id=f"F{number}")
        target = found[0]
        result.update(id=target["id"], text=target["text"], lane=target["lane"])
        if action == "take" and target["lane"] and target["lane"] != branch:
            raise FollowUpRefused(f"{target['id']} is held by lane {target['lane']}; `fleet follow-up release "
                                  f"{target['id']}` frees it", id=target["id"], text=target["text"],
                                  held_by=target["lane"])
        if (action == "take" and target["lane"] == branch) or (action == "release" and not target["lane"]):
            return {**result, **nothing}
    elif action == "lane":
        selected = [it for it in doc["items"] if it["lane"] == branch]
        result.update(closed=[], released=[])
        if not selected:
            return {**result, **nothing}
        counts: dict[int, int] = {}
        for it in doc["items"]:
            if it["number"] is not None:
                counts[it["number"]] = counts.get(it["number"], 0) + 1
        twice = sorted({it["id"] for it in selected if it["number"] is not None and counts[it["number"]] > 1},
                       key=lambda x: int(x[1:]))
        if twice:
            raise FollowUpRefused(f"{', '.join(twice)} {'is' if len(twice) == 1 else 'are'} on more than one line "
                                  f"of {home / PROJECT_MD}; fix it by hand, then close or release them")
    unnumbered = [it for it in doc["items"] if it["number"] is None]
    if action == "list" and not unnumbered:
        return {**result, **nothing}
    # 2. The counter, for every write: at least 1 + the highest ID in PROJECT.md before this change, then past the
    # IDs that this write gives (every item without one, then the new item). It is written before PROJECT.md, so
    # that an ID that this write removes or gives stays used, whatever happens to its event.
    lines = doc["lines"]
    need = len(unnumbered) + (action == "add")
    events: list[tuple[str, dict]] = []
    assigned = []
    first = next_follow_up_number(home, doc)
    if need and first + need - 1 > FOLLOW_UP_MAX:
        raise FollowUpRefused(f"the next follow-up ID would be past F{FOLLOW_UP_MAX}")
    write_json(home / FOLLOW_UPS_FILE, {"next": first + need})
    if need:
        n = first
        for it in unnumbered:
            content, m = lines[it["line"]][0], it["match"]
            lines[it["line"]][0] = content[:m.end(1)] + f"[F{n}] " + content[m.end(1):]
            assigned.append(f"F{n}")
            events.append(("follow_up_added", {"id": f"F{n}", "text": it["text"], "assigned": "list"}))
            n += 1
        new_number = n
        # Line indices stay the same: only the content of the numbered lines changed.
        doc = parse_follow_ups(join_lines([list(l) for l in lines], doc["final_newline"], doc["eol"]))
        lines = doc["lines"]
    by_line = {it["line"]: it for it in doc["items"]}
    eol, final_newline = doc["eol"], doc["final_newline"]
    removed: set[int] = set()
    drop_placeholders = False
    insert_after = replace_at = None
    entry = None
    appended: list[list[str]] = []
    # 3. The action.
    if action == "add":
        entry = f"- [F{new_number}] {body}"
        result.update(id=f"F{new_number}", text=body, lane=None, changed="added")
        events.append(("follow_up_added", {"id": f"F{new_number}", "text": body, "source": source}))
        if not doc["sections"]:
            appended = ([["", eol]] if lines else []) + [["## Follow-ups", eol], [entry, eol]]
        else:
            first_line, end = doc["sections"][0]
            items0 = [it for it in doc["items"] if it["section"] == 0]
            drop_placeholders = True
            if items0:
                insert_after = items0[-1]["lines"][-1]
            elif doc["placeholders"]:
                replace_at = doc["placeholders"][0]
            else:
                insert_after = next((i for i in range(end - 1, first_line - 1, -1) if doc["contents"][i].strip()),
                                    first_line - 1)
    elif action in ("take", "release"):
        item = by_line[target["line"]]
        mark = branch if action == "take" else None
        lines[item["line"]][0] = with_lane_mark(lines[item["line"]][0], item["match"], mark)
        result.update(lane=mark, changed="taken" if action == "take" else "released")
        events.append((f"follow_up_{'taken' if action == 'take' else 'released'}",
                       {"id": item["id"], "text": item["text"], "branch": branch if mark else item["lane"]}))
    elif action == "done":
        item = by_line[target["line"]]
        removed.update(item["lines"])
        result.update(changed="done")
        events.append(("follow_up_done", {"id": item["id"], "text": item["text"], "branch": item["lane"],
                                          "detail": "\n".join(follow_up_raw_detail(doc, item)) or None,
                                          "reason": reason}))
    elif action == "lane":
        for old in selected:
            item = by_line[old["line"]]
            if close:
                removed.update(item["lines"])
                result["closed"].append(item["id"])
                events.append(("follow_up_done", {"id": item["id"], "text": item["text"], "branch": branch,
                                                  "detail": "\n".join(follow_up_raw_detail(doc, item)) or None,
                                                  "reason": reason}))
            else:
                lines[item["line"]][0] = with_lane_mark(lines[item["line"]][0], item["match"], None)
                result["released"].append(item["id"])
                events.append(("follow_up_released", {"id": item["id"], "text": item["text"], "branch": branch}))
        result["changed"] = "closed" if result["closed"] else "released"
    # `- none` comes back in place of the first removed item when the first section has no item left.
    restore_at = None
    gone0 = [it for it in doc["items"] if it["section"] == 0 and it["line"] in removed]
    if gone0 and not doc["placeholders"] and all(it["line"] in removed for it in doc["items"] if it["section"] == 0):
        restore_at = gone0[0]["line"]
    out: list[list[str]] = []
    for i, (content, term) in enumerate(lines):
        if drop_placeholders and i in doc["placeholders"]:
            if i == replace_at:
                out.append([entry, term])
            continue
        if i in removed:
            if i == restore_at:
                out.append(["- none", term])
            continue
        out.append([content, term])
        if i == insert_after:
            out.append([entry, eol])
    new = join_lines(out + appended, final_newline, eol)
    write_project_md(home, new)
    for kind, fields in events:
        record(kind, None, home=home, **fields)
    result.setdefault("changed", "ids")
    if assigned:
        result["assigned"] = assigned
    result.update(follow_up_listing(new))
    return result


def lane_follow_ups(home: Path | None) -> tuple[dict[str, list[dict]], str | None]:
    """{branch: [{id, text}]} of the taken follow-ups, read without the lock, and why PROJECT.md cannot be read.
    No project and no PROJECT.md are no error: there is nothing to read."""
    if home is None:
        return {}, None
    try:
        text = read_project_md(home)
    except FleetError as e:
        return {}, str(e)
    out: dict[str, list[dict]] = {}
    for it in parse_follow_ups(text or "")["items"]:
        if it["lane"]:
            out.setdefault(it["lane"], []).append({"id": it["id"], "text": it["text"]})
    return out, None


def lane_work_merged(f: dict) -> bool:
    """Whether cleanup closes the follow-ups of lane `f` as done (else it releases them): its pull request merged,
    or it is merged and its branch moved since the lane was created (`branch_moved` in the facts). An error, or a
    reflog that lost the branch's creation, turns a close into a release, never the reverse."""
    if f.get("verdict") != "ready":
        return False
    if (f.get("pr") or {}).get("state") == "MERGED":
        return True
    return bool(f.get("merged_into")) and f.get("branch_moved") is True


def close_lane_follow_ups(f: dict) -> dict:
    """After cleanup removed a lane: close or release the follow-ups that its branch holds (see lane_work_merged).
    Never raises: a failure is reported in `follow_up_error`. No project and no PROJECT.md are no failure."""
    out: dict = {"follow_ups_closed": [], "follow_ups_released": [], "follow_up_error": None}
    branch = f.get("branch")
    if not branch:
        return out
    try:
        home = project_for(f.get("main_root"), create=False)
        if home is None:
            return out
        res = follow_up_apply(home, "lane", branch=branch, close=lane_work_merged(f),
                              reason=f"closed by fleet cleanup: lane {branch} merged and removed")
        if res["ok"]:
            out.update(follow_ups_closed=res["closed"], follow_ups_released=res["released"])
        elif not res.get("missing"):
            out["follow_up_error"] = res["refused"]
    except (FleetError, OSError, ValueError) as e:
        out["follow_up_error"] = str(e) or type(e).__name__
    return out


def follow_up_text(value: str | None) -> str:
    return " ".join((value or "").split())


def cmd_follow_up(args: argparse.Namespace) -> int:
    if getattr(args, "project", None):
        home = project_home(args, create=False)  # a wrong name is an error, as in board and orch
    else:
        try:
            home = project_home(args, create=False)
        except FleetError as e:
            return refuse(refused=str(e))
    base = {"project": home.name, "project_md": str(home / PROJECT_MD)}
    action = args.action
    if action == "list":
        text = read_project_md(home)  # a file that cannot be read is an error (exit 1), as for every action
        if text is None:
            res = {"ok": True, "changed": "nothing", "follow_ups": [], "sections": 0, "other_lines": 0,
                   "note": NO_PROJECT_MD}
        elif any(not it["id"] for it in parse_follow_ups(text)["items"]):
            res = follow_up_apply(home, "list")  # gives the lines without an ID their IDs, under the lock
        else:
            res = {"ok": True, "changed": "nothing", **follow_up_listing(text)}
        if not res["ok"]:
            return refuse(**base, **{k: v for k, v in res.items() if k not in ("ok", "missing")})
        res = {"ok": True, **base, **{k: v for k, v in res.items() if k != "ok"}}
        if args.json:
            print(json.dumps(res, indent=2, ensure_ascii=False))
            return 0
        for it in res["follow_ups"]:
            print(f"{it['id']}  {it['text']}" + (f"  (lane: {it['lane']})" if it["lane"] else ""))
            for more in it.get("detail") or []:
                print(f"      {more}".rstrip())
        if not res["follow_ups"]:
            print("no follow-ups" + (f" ({res['note']})" if res.get("note") else ""))
        if res.get("assigned"):
            print(f"gave IDs to {plural(len(res['assigned']), 'line')} without one: {', '.join(res['assigned'])}")
        if res["sections"] > 1:
            print(f"note: PROJECT.md has {res['sections']} ## Follow-ups sections; add writes to the first")
        if res["other_lines"]:
            print(f"note: {plural(res['other_lines'], 'line')} under ## Follow-ups "
                  f"{'is' if res['other_lines'] == 1 else 'are'} no list item and no follow-up")
        return 0
    fields: dict = {}
    if action == "add":
        body = follow_up_text(args.text)
        if not body:
            return refuse(**base, refused="the follow-up text is empty")
        source = follow_up_text(args.source) or None
        if source:
            body += f" (from {source})"
        m = FOLLOW_UP_ITEM.match(f"- [F1] {body}")
        if not m or m.group(3) != body:
            return refuse(**base, refused="the text cannot end with a lane mark `(lane: ...)`: only take writes it")
        fields = {"body": body, "source": source}
    else:
        number = parse_follow_up_id(args.id)
        if number is None:
            return refuse(**base, refused=f"not a follow-up ID: {args.id!r} (F7, f7 or 7)")
        fields = {"number": number}
        if action == "take":
            if not BRANCH_MARK.fullmatch(args.lane or ""):
                return refuse(**base, refused=f"not a branch for a lane mark: {args.lane!r}")
            fields["branch"] = args.lane
        elif action == "done":
            fields["reason"] = follow_up_text(args.reason) or None
    res = follow_up_apply(home, action, **fields)
    if not res["ok"]:
        return refuse(**base, **{k: v for k, v in res.items() if k not in ("ok", "missing")})
    res = {"ok": True, **base, **{k: v for k, v in res.items() if k != "ok"}}
    print(json.dumps(res, indent=2, ensure_ascii=False))
    return 0


def review_rounds(d: Path) -> tuple[dict[int, Path], dict[int, list[Path]]]:
    """The review requests and the review files in a lane's .fleet/, by round."""
    requests: dict[int, Path] = {}
    reviews: dict[int, list[Path]] = {}
    try:
        names = sorted(p.name for p in Path(d).iterdir() if p.is_file())
    except OSError:
        return requests, reviews
    for name in names:
        m = REVIEW_REQUEST_FILE.match(name)
        if m:
            requests[int(m.group(1))] = Path(d) / name
            continue
        m = REVIEW_FILE.match(name)
        if m:
            reviews.setdefault(int(m.group(1)), []).append(Path(d) / name)
    return requests, reviews


def review_verdict(path: Path, read=read_text) -> str | None:
    """`APPROVE`, `CHANGES REQUESTED` (or the text that follows) on the last `VERDICT:` line; None without one
    (also for a missing file). `read`: how the file is read."""
    hits = VERDICT_LINE.findall(read(path))
    if not hits:
        return None
    text = re.sub(r"[*_`]", "", hits[-1]).strip().upper()
    if "CHANGES" in text:
        return "CHANGES REQUESTED"
    if "APPROVE" in text:
        return "APPROVE"
    return text or "?"


def round_files(d: Path, n: int, requests: dict[int, Path], reviews: dict[int, list[Path]],
                read=read_text) -> list[Path]:
    """The review files that round n expects: the ones its request names (REVIEW-<n>.md, REVIEW-<n>-<name>.md),
    else the ones that exist. A named file can be missing: its critic has not written yet. `read`: how the
    request is read."""
    names: list[str] = []
    if n in requests:
        for name in re.findall(rf"\bREVIEW-{n}(?:-[A-Za-z0-9._-]+?)?\.md\b", read(requests[n])):
            if name not in names:
                names.append(name)
    return [Path(d) / name for name in names] if names else reviews.get(n) or []


REVIEW_FILE_MAX = 1024 * 1024  # bytes of a review file or request that newest_round_approved reads at most


def bounded_text(path: Path, limit: int = REVIEW_FILE_MAX) -> str:
    """The text of a regular file of at most `limit` bytes (read_small_file), else ''."""
    try:
        return read_small_file(path, limit).decode("utf-8", errors="replace")
    except (OSError, ValueError):
        return ""


def newest_round_approved(d: Path, rounds: tuple[dict[int, Path], dict[int, list[Path]]]) -> bool:
    """True when the newest round that has review files is approved: no later round was requested, and each file
    that the round expects (round_files) has `VERDICT: APPROVE`, as `reviewed <n>: APPROVE` says. Reads the
    round's request and review files bounded (bounded_text), whatever the lane's phase."""
    requests, reviews = rounds
    if not reviews:
        return False
    n = max(reviews)
    if requests and max(requests) > n:
        return False
    files = round_files(Path(d), n, requests, reviews, read=bounded_text)
    return bool(files) and all(review_verdict(p, read=bounded_text) == "APPROVE" for p in files)


def implementer_pane(panes: list[dict]) -> dict | None:
    """The lane's implementer: the agent pane with role impl, else the first that is not a critic, else any.
    A planner or researcher pane never counts."""
    agents = [p for p in panes if p.get("agent") and p.get("role") not in ("planner", "researcher")]
    return (next((p for p in agents if p.get("role") == "impl"), None)
            or next((p for p in agents if p.get("role") != "critic"), None)
            or (agents[0] if agents else None))


def plan_phase(panes: list[dict], fleet_dir: Path, status_md: str) -> str | None:
    """`planning`, `plan ready <n>` or `plan approved <n>` for a lane with a PLAN.md, while no implementer runs
    (an agent pane with role impl, or with no role) and STATUS.md has no READY FOR REVIEW line; else None."""
    path = Path(fleet_dir) / PLAN_FILE
    if not path.is_file() or READY_LINE.search(status_md):
        return None
    if any(p.get("agent") and p.get("role") in ("impl", None) for p in panes):
        return None
    ready, approved = plan_rounds(read_text(path))
    planner_works = any(p.get("agent") and p.get("role") == "planner" and p.get("status") == "working" for p in panes)
    if planner_works or not ready:
        return "planning"
    n = max(ready)
    return f"plan approved {n}" if n in approved else f"plan ready {n}"


def lane_phase(f: dict, fleet_dir: Path, removed: bool = False,
               rounds: tuple[dict[int, Path], dict[int, list[Path]]] | None = None) -> str:
    """The lane's phase; the first rule that matches wins. `f` holds the lane facts and panes with roles. `rounds`:
    review_rounds of the lane's .fleet/, when the caller has listed it already."""
    if removed:
        return "removed"
    state = (f.get("pr") or {}).get("state")
    if state == "MERGED":
        return "merged"
    if state == "OPEN":
        return "pr open"
    panes = f.get("panes") or []
    status_md = read_text(Path(fleet_dir) / "STATUS.md")
    if any(p.get("agent") and p.get("status") == "blocked" for p in panes) or section_text(status_md, "Blocked"):
        return "blocked"
    planned = plan_phase(panes, fleet_dir, status_md)
    if planned:
        return planned
    requests, reviews = rounds if rounds is not None else review_rounds(Path(fleet_dir))
    ready = max((int(n) for n in READY_LINE.findall(status_md)), default=None)
    if requests or reviews:
        n = max(requests) if requests else max(reviews)
        files = round_files(Path(fleet_dir), n, requests, reviews)
        verdicts = [review_verdict(p) for p in files]
        if n in requests and (not files or not all(verdicts)):
            return f"review {n}"
        if files and all(verdicts) and not (ready is not None and ready > n):
            verdict = "CHANGES REQUESTED" if "CHANGES REQUESTED" in verdicts else (
                "APPROVE" if all(v == "APPROVE" for v in verdicts) else verdicts[-1])
            return f"reviewed {n}: {verdict}"
    if ready is not None and ready not in requests:
        return f"ready {ready}"
    impl = implementer_pane(panes)
    if impl:
        return "working" if impl.get("status") == "working" else "idle"
    return "no agent"


def lane_name(f: dict) -> str:
    return f.get("label") or f.get("branch") or os.path.basename(f.get("path") or "") or "?"


def newest_lane_event(events: list[dict], path: str, branch: str | None) -> dict | None:
    """Time and kind of the lane's newest event. `phase` events only echo the board, so they do not count."""
    for e in reversed(events):
        if e.get("event") == "phase":
            continue
        if (branch and e.get("branch") == branch) or lane_matches(e, path):
            return {"ts": e.get("ts"), "event": e.get("event")}
    return None


RISK_SKIP_PHASES = ("removed", "merged", "planning")  # and `plan ready <n>`, `plan approved <n>`: no code yet


def board_risk(path: str, phase: str, home: Path | None, is_git: bool = False) -> dict | None:
    """The board's view of `risk_state` for a lane: `{matches, needs_user}`, with `needs_user` the text
    `cannot be told: <why>` when the changes cannot be told; None without a match, and for a lane that is not
    a git checkout or whose phase has no code to check. `is_git`: the lane's facts say it is a git checkout,
    so a failed top-level lookup cannot be told, not "no git"."""
    if phase in RISK_SKIP_PHASES or phase.startswith("plan "):
        return None
    top = git_toplevel(path) if os.path.isdir(path) else None
    if not top:
        return {"matches": [], "needs_user": "cannot be told: git cannot find the top of the lane's checkout"} \
            if is_git else None
    state = risk_state(top, home)

    def pair(m: dict) -> dict:
        return {"category": m["category"], "path": m["path"]}
    if state["error"]:
        return {"matches": [], "needs_user": f"cannot be told: {state['error']}"}
    if not state["matches"]:
        return None
    return {"matches": [pair(m) for m in state["matches"]], "needs_user": [pair(m) for m in state["needs_user"]]}


def risk_note(risk) -> str:
    """The NOTE of a lane whose changes need the user's yes, or ''."""
    need = as_dict(risk).get("needs_user")
    if isinstance(need, str) and need:
        return f"risky diff {need}"
    items = [m for m in need if isinstance(m, dict)] if isinstance(need, list) else []
    if not items:
        return ""
    first = f"{as_text(items[0].get('category')) or '?'} {as_text(items[0].get('path')) or '?'}"
    return f"risky diff needs the user ({len(items)}): {first}"


def board_record(f: dict, events: list[dict], home: Path | None = None,
                 follow_ups: dict[str, list[dict]] | None = None, roots: dict[str, str | None] | None = None,
                 viewer: str | None = None, compactions: dict[str, int] | None = None,
                 review_limit: int = 0) -> dict:
    """The board's record of a lane. `orch` is its owner (lane.json), `checkout` its main checkout. `clone`, the
    lane's main checkout, when that is not the main checkout of its orch's recorded checkout (the owner's, else the
    viewer's for an unowned lane; `roots`, orch_roots): the lane sits in another clone of the project.
    `compactions`: the lane's count per pane (compaction_counts); `compactions` in the record sums those of its
    implementer and planner panes, and `compacted_pane` names the one with the most. `review_rounds` counts the
    round numbers of its review files; `review_limit` is the limit of the conventions (review_round_limit);
    `review_approved`, at the limit only (else None, nothing read), whether the newest round is approved
    (newest_round_approved), also when the phase does not show it (`pr open`)."""
    d = Path(f["path"]) / FLEET_DIR
    roles = load_panes(d)
    panes = [{"pane": p.get("pane"), "role": (roles.get(p.get("pane") or "") or {}).get("role"),
              "agent": p.get("agent"), "status": p.get("status")} for p in f.get("panes") or []]
    status_md = read_text(d / "STATUS.md")
    pr = f.get("pr") or None
    rounds = review_rounds(d)
    phase = lane_phase({**f, "panes": panes}, d, rounds=rounds)
    counted = [(p["pane"], (compactions or {}).get(p["pane"], 0)) for p in panes
               if p.get("agent") and p.get("pane") and p.get("role") in COMPACTION_ROLES]
    top = max(counted, key=lambda x: x[1], default=(None, 0))
    out = {"lane": lane_name(f), "path": f["path"], "branch": f.get("branch"), "workspace": f.get("workspace"),
           "panes": panes, "pr": {"number": pr.get("number"), "state": pr.get("state")} if pr else None,
           "phase": phase, "last_event": newest_lane_event(events, f["path"], f.get("branch")),
           "blocked": first_note(status_md, "Blocked"), "next": first_note(status_md, r"Next steps?"),
           "risk": board_risk(f["path"], phase, home, bool(f.get("git"))),
           "follow_ups": [x["id"] for x in (follow_ups or {}).get(f.get("branch") or "", []) if x["id"]],
           "orch": lane_owner(f["path"]), "checkout": f.get("main_root"),
           "compactions": sum(n for _, n in counted), "compacted_pane": top[0] if top[1] else None,
           "review_rounds": len(rounds[1]), "review_limit": review_limit,
           "review_approved": (newest_round_approved(d, rounds)
                               if review_limit >= 1 and len(rounds[1]) >= review_limit else None)}
    root = (roots or {}).get(out["orch"] or viewer)
    if root and f.get("main_root") and os.path.realpath(f["main_root"]) != os.path.realpath(root):
        out["clone"] = f["main_root"]
    if phase.startswith("plan ready"):
        warning = plan_gate_note(f["path"])
        if warning:
            out["warning"] = warning
    return out


COMPACTION_ROLES = ("impl", None, "planner")  # the panes whose compactions the board counts: implementers, planners


def compaction_counts(events: list[dict], lanes: list[dict]) -> dict[str, dict[str, int]]:
    """For each lane (by path), the compactions of each of its panes now on the board, in one pass over the log:
    `session_start` events with `source: compact` since the pane's last fresh context. A `spawn` in the pane, a
    `reset` of it that succeeded (`ok`), or a `session_start` with `source` `clear` or `startup` (a /clear by hand,
    a new agent) sets it back to 0; a resumed session keeps its count. An event counts for a lane when its `pane`
    is one of the lane's panes and it is the lane's (its branch, or a path in the lane's checkout, as
    newest_lane_event). Reads no file."""
    wanted: dict[str, list[dict]] = {}
    for f in lanes:
        for p in f.get("panes") or []:
            if p.get("pane"):
                wanted.setdefault(p["pane"], []).append(f)
    counts: dict[str, dict[str, int]] = {}
    for e in events:
        kind, pane = e.get("event"), e.get("pane")
        if kind not in ("spawn", "reset", "session_start") or pane not in wanted:
            continue
        source = e.get("source")
        fresh = (kind == "spawn" or (kind == "reset" and e.get("ok") is True)
                 or (kind == "session_start" and source in ("clear", "startup")))
        if not fresh and not (kind == "session_start" and source == "compact"):
            continue
        for f in wanted[pane]:
            if not ((f.get("branch") and e.get("branch") == f["branch"]) or lane_matches(e, f["path"])):
                continue
            lane = counts.setdefault(f["path"], {})
            lane[pane] = 0 if fresh else lane.get(pane, 0) + 1
    return counts


REVIEW_LIMIT_DEFAULT = 4
CONVENTIONS_MAX = 256 * 1024  # bytes of the conventions file that the board reads at most
HTML_COMMENT = re.compile(r"<!--.*?(?:-->|\Z)", re.S)
REVIEW_LIMIT_KEY = re.compile(r"^[ \t]*[-*][ \t]+[*_`]*review round limit\b", re.I)
REVIEW_LIMIT_LINE = re.compile(r"^[ \t]*[-*][ \t]+review round limit:[ \t]*(\d{1,9})(?:[.,;:]?(?=[ \t]|$))", re.I)


def parse_review_limit(text: str) -> tuple[int, str | None]:
    """(the review round limit of a conventions text, why it cannot be read). The limit is one list item of a fixed
    form, `- Review round limit: <n>` with a whole number n >= 1, followed by the end of the line, or by `.`, `,`,
    `;`, `:` or a blank and free text. Text in HTML comments does not count. No such line: the default. A line
    whose item starts with the key in another form (`4.5`, `four`, `**Review round limit**`), a limit below 1, or
    lines that give different numbers: the default, and the reason."""
    values: list[int] = []
    for line in HTML_COMMENT.sub("", text).splitlines():
        if not REVIEW_LIMIT_KEY.match(line):
            continue
        m = REVIEW_LIMIT_LINE.match(line)
        if not m:
            return REVIEW_LIMIT_DEFAULT, f"{line.strip()!r} is not '- Review round limit: <n>' with a whole number"
        if int(m.group(1)) < 1:
            return REVIEW_LIMIT_DEFAULT, f"{line.strip()!r}: the limit must be 1 or more"
        values.append(int(m.group(1)))
    if len(set(values)) > 1:
        return REVIEW_LIMIT_DEFAULT, f"the review round limit lines disagree: {', '.join(map(str, values))}"
    return (values[0] if values else REVIEW_LIMIT_DEFAULT), None


def review_round_limit() -> dict:
    """`{limit, source, error?}`: the review round limit of the user's conventions file, or of the plugin defaults
    while that file does not exist. The file is read once, bounded (read_small_file): a file that cannot be read,
    is not a regular file or is too large gives the default and the reason, as a line that cannot be read does."""
    path = conventions_path()
    if not os.path.lexists(path):
        path = PLUGIN_ROOT / "defaults" / "conventions.md"
    out = {"limit": REVIEW_LIMIT_DEFAULT, "source": str(path)}
    try:
        text = read_small_file(path, CONVENTIONS_MAX).decode("utf-8", errors="replace")
    except (OSError, ValueError) as e:
        return {**out, "error": f"{path} cannot be read: {getattr(e, 'strerror', None) or e}"}
    limit, error = parse_review_limit(text)
    return {**out, "limit": limit, **({"error": f"{path}: {error}"} if error else {})}


def as_count(value) -> int | None:
    """An int of a cached record (not a bool), else None."""
    return value if isinstance(value, int) and not isinstance(value, bool) else None


def signal_notes(r: dict) -> tuple[str, str]:
    """(the review limit note, the compaction note) of a board record, or '' for each. Only the record's own fields
    count, so a cached board gives the same notes. None for a lane that merged or was removed; no review note once
    the newest round is approved (`review_approved` is true)."""
    phase = as_text(r.get("phase"))
    if phase in ("merged", "removed"):
        return "", ""
    rounds, limit = as_count(r.get("review_rounds")), as_count(r.get("review_limit"))
    review = (f"{rounds} review rounds (limit {limit}): ask the user first"
              if rounds is not None and limit and limit >= 1 and rounds >= limit
              and r.get("review_approved") is not True else "")
    n, pane = as_count(r.get("compactions")), as_text(r.get("compacted_pane"))
    compact = f"compacted {n}x: fleet reset {pane} at the next commit" if n and n > 0 and pane else ""
    return review, compact


def plan_gate_note(path: str) -> str | None:
    """What makes `approve-plan` refuse in this lane, from the same checks in the same order, or None. Only for
    `plan ready`."""
    paths = status_paths(path)
    flagged = flagged_count(path)
    commits, why = lane_commits(path)
    parts = []
    if paths is None:
        parts.append("git status failed")
    elif outside_fleet(paths):
        parts.append(f"{plural(len(outside_fleet(paths)), 'changed path')} outside {FLEET_DIR}/")
    if flagged is None:
        parts.append("git ls-files failed")
    elif flagged:
        parts.append(flagged_reason(flagged))
    if commits is None:
        parts.append("the lane's own commits cannot be counted" + (" (HEAD is detached)" if "detached" in why else ""))
    elif commits:
        parts.append(plural(len(commits), "lane commit"))
    return f"{', '.join(parts)}: approve-plan refuses" if parts else None


def open_research(home: Path) -> list[dict]:
    """The research files of the project, <home>/research/*.md, that have no RESEARCH DONE line yet."""
    out = []
    for path in sorted((home / RESEARCH_DIR).glob("*.md")):
        text = read_text(path)
        if RESEARCH_DONE_LINE.search(text):
            continue
        title = next((m.group(2) for m in map(HEADING.match, text.splitlines()) if m and len(m.group(1)) == 1), None)
        out.append({"file": str(path), "title": title})
    return out


def removed_records(events: list[dict], since: float | None, on_board: set[str], names: dict[str, str],
                    view: dict | None = None) -> list[dict]:
    """The lanes that a cleanup event removed at or after `since` (none without it), and that are gone now. A view
    that filters keeps those of its orch and the unowned ones (the cleanup event names the lane's orch).

    A lane that is on the board again was made anew at the same path after its cleanup.
    """
    if since is None:
        return []
    found: dict[str, dict] = {}
    for e in events:
        path = e.get("lane")
        if e.get("event") != "cleanup" or not e.get("removed") or not path or event_time(e) < since:
            continue
        if os.path.realpath(path) in on_board:
            continue
        owner = text_or_none(e.get("orch"))
        owner = (view.get("aliases") or {}).get(owner, owner) if view and owner else owner  # a renamed orch's old name
        if view and view.get("filtered") and owner not in (None, view.get("name")):
            continue
        found[path] = {"lane": names.get(path) or e.get("branch") or os.path.basename(path), "path": path,
                       "branch": e.get("branch"), "workspace": e.get("workspace"), "panes": [], "pr": None,
                       "phase": "removed", "last_event": {"ts": e.get("ts"), "event": "cleanup"},
                       "blocked": None, "next": None, "risk": None, "follow_ups": [], "orch": owner}
    return list(found.values())


def lane_owner(path: str) -> str | None:
    """The orch that owns the lane at `path`, by name, from its .fleet/lane.json; None: unowned (no file, or no name)."""
    return text_or_none(read_json(Path(path) / FLEET_DIR / LANE_FILE).get("orch"))


def pid_alive(pid) -> bool:
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    return True


def lane_removal(path: str) -> int | None:
    """The process of a cleanup that is removing the lane at `path` (the `removing` mark that it wrote into
    lane.json under the project lock), while that process lives; None otherwise. A mark whose process is gone (a
    cleanup that crashed) does not count."""
    mark = read_json(Path(path) / FLEET_DIR / LANE_FILE).get(LANE_REMOVING)
    pid = mark.get("pid") if isinstance(mark, dict) else None
    return pid if pid_alive(pid) else None


def removal_refusal(path: str, pid: int, verb: str) -> str:
    return (f"lane {path} is being removed by a cleanup (process {pid}); {verb} it after that cleanup ends. When no "
            f"cleanup runs (process {pid} is another program now), remove the `{LANE_REMOVING}` key from "
            f"{Path(path) / FLEET_DIR / LANE_FILE}")


def carry_lane_homes(lanes: list[dict]) -> list[dict]:
    """Resolve the project home of each lane once, for cleanup, and carry it in the lane: f["home"] is its path, or
    None when the repository has no project (then no lock, as in 0.8.3). The guard, the mark and the unmark read
    it; none looks it up again, so a later git failure cannot stand in for "no project". A lookup that fails (a git
    error or a timeout) gives no "home" and a refusal: the lane stays. Returns the refusals."""
    found: dict[str, tuple] = {}
    refused = []
    for f in lanes:
        where = f.get("main_root") or f["path"]
        key = os.path.realpath(where)
        if key not in found:
            found[key] = project_lookup(where)
        home, error = found[key]
        if error:
            f.pop("home", None)
            refused.append({"target": f.get("target") or f["path"], "reasons": [f"{error}; the worktree stays"]})
            continue
        f["home"] = str(home) if home else None
    return refused


def carried_home(f: dict) -> Path | None:
    """The project home that carry_lane_homes resolved for the lane; FleetError when it was not resolved."""
    if "home" not in f:
        raise FleetError(f"the project of lane {f['path']} is not known; the worktree stays")
    return Path(f["home"]) if f["home"] else None


def mark_lane_removal(f: dict, owner: str | None) -> bool:
    """For cleanup, right before the removal: under the project lock, read the lane's owner again; when it is not
    `owner` (the owner that the checks saw), raise; else write the `removing` mark into its lane.json, so that no
    adopt or spawn moves the lane while it goes. Returns whether this created .fleet/ (unmark removes it again).
    The lock is the one of the home carried from the guard (carried_home), held only for reading and writing
    lane.json: no git under it, and never across the removal."""
    home = carried_home(f)
    fleet_dir = Path(f["path"]) / FLEET_DIR
    created = not fleet_dir.is_dir()
    # Before the lock (git): .fleet/ exists and git excludes it, so the mark is no untracked file that would make
    # the removal refuse the lane.
    prep_dir(f["path"])
    with (project_lock(home) if home else nullcontext()):
        now = lane_owner(f["path"])
        if now != owner:
            raise FleetError(f"the orch of lane {f['path']} changed from {owner or 'none'} to {now or 'none'} since "
                             "the check; the worktree stays: sweep again")
        pid = lane_removal(f["path"])
        if pid and pid != os.getpid():
            raise FleetError(removal_refusal(f["path"], pid, "clean") + "; the worktree stays")
        data = read_json(fleet_dir / LANE_FILE)
        write_json(fleet_dir / LANE_FILE, {**data, LANE_REMOVING: {"pid": os.getpid(), "since": now_iso()}})
    return created


def unmark_lane_removal(f: dict, created: bool) -> None:
    """Remove the `removing` mark of a lane that stays (the removal did not happen), under the project lock. Best
    effort: a mark that stays is ignored once this process ends."""
    try:
        home = carried_home(f)
        with (project_lock(home) if home else nullcontext()):
            fleet_dir = Path(f["path"]) / FLEET_DIR
            path = fleet_dir / LANE_FILE
            data = {k: v for k, v in read_json(path).items() if k != LANE_REMOVING}
            if data:
                write_json(path, data)
            else:
                path.unlink(missing_ok=True)
                if created:
                    try:
                        fleet_dir.rmdir()
                    except OSError:
                        pass
    except (FleetError, OSError):
        pass


def lane_owner_prep(cwd: str) -> dict:
    """The git part of write_lane_owner, run before the project lock: the lane's .fleet/ (made, and excluded from
    git) and its branch."""
    return {"fleet_dir": prep_dir(cwd)["fleet_dir"], "branch": git_branch(cwd) or None}


def write_lane_owner(cwd: str, home: Path | None, name: str | None, pane: str | None, prep: dict | None = None) -> str:
    """Record the orch that owns the lane at `cwd` (by name, never by pane: panes change at every handoff) in its
    .fleet/lane.json, atomically. Returns the file. With `prep` (lane_owner_prep, taken before the lock) it only
    writes the file: adopt and spawn call it so under the project lock, where no git may run."""
    prep = prep or lane_owner_prep(cwd)
    path = Path(prep["fleet_dir"]) / LANE_FILE
    write_json(path, {"orch": name, "project": home.name if home else None,
                      "branch": prep["branch"], "since": now_iso(), "by": pane})
    return str(path)


def lane_selector(home: Path, view: dict | None = None):
    """A `collect_lanes` filter for the lanes of the project at `home`, with the project cached per main checkout.
    With a `view` that filters (orch_view), it keeps only the view's orch's own lanes and the unowned ones, by each
    lane's .fleet/lane.json (one small file), so that gh is asked for those alone. `select.lanes` maps the real path
    of each lane of the project that it saw, on the view or not, to its owner (None: unowned); `select.branches`
    maps the branches that lane.json files name to their owners."""
    cache: dict[str, bool] = {}
    want = os.path.realpath(home)

    def select(stub: dict) -> bool:
        root = stub.get("main_root")
        if not root:
            return False
        key = os.path.realpath(root)
        if key not in cache:
            ident = repo_identity(root)
            found = find_project(ident["keys"]) if ident else None
            cache[key] = found is not None and os.path.realpath(found) == want
        if not cache[key]:
            return False
        rec = read_json(Path(stub["path"]) / FLEET_DIR / LANE_FILE)
        owner = text_or_none(rec.get("orch"))
        select.lanes[os.path.realpath(stub["path"])] = owner
        if text_or_none(rec.get("branch")):
            select.branches[rec["branch"]] = owner
        return not (view and view.get("filtered")) or owner in (None, view.get("name"))
    select.lanes, select.branches = {}, {}
    return select


def orch_view(home: Path, name: str | None = None, all_lanes: bool = False) -> dict:
    """What `board` and `digest` show the caller: its orch (current_orch; `name` is --orch), that orch's files, and
    whether the board is filtered to that orch's own and unowned lanes (a project with several orchs and a resolved
    orch, without --all) or shows every lane with its orch (--all, or several orchs and none resolved)."""
    orchs, is2 = orch_registry(home)
    name, rec = current_orch(home, name, orchs)
    several = len(orchs) > 1
    return {"name": name, "record": rec, "orchs": orchs, "is2": is2, "several": several, "aliases": orch_aliases(orchs),
            "filtered": several and name is not None and not all_lanes,
            "all": all_lanes or (several and name is None), "files": orch_files(home, name, is2)}


def orch_roots(home: Path, orchs: dict[str, dict]) -> dict[str, str | None]:
    """The main checkout of each orch's recorded checkout, by name; None when it is not a checkout of this project
    (an orch pane can sit in another project's checkout) or git cannot tell."""
    roots: dict[str, str | None] = {}
    for name, rec in orchs.items():
        checkout = text_or_none(rec.get("checkout"))
        ident = repo_identity(checkout) if checkout and os.path.isdir(checkout) else None
        found = find_project(ident["keys"]) if ident else None
        roots[name] = ident["main_root"] if found and os.path.realpath(found) == os.path.realpath(home) else None
    return roots


def make_board(home: Path, since: float | None, names: dict[str, str], view: dict | None = None,
               limit: dict | None = None) -> list[dict]:
    """A fresh board of the project's lanes (of the view's lanes, for a view that filters), with the lanes removed
    since `since`. Runs herdr, git and gh. It puts the lanes that it saw, with their owners, in view["lanes"] and
    view["branches"] (lane_selector), for the digest's event filter. `limit`: review_round_limit, read here when
    the caller did not."""
    if not shutil.which("herdr"):
        raise FleetError("herdr not found in PATH")
    select = lane_selector(home, view)
    lanes, _, _ = collect_lanes(select=select, others=False)
    events = read_events([home])
    held, _ = lane_follow_ups(home)  # PROJECT.md, read once per board
    roots = orch_roots(home, view["orchs"]) if view else {}
    viewer = view.get("name") if view else None
    compacted = compaction_counts(events, lanes)
    review_limit = (limit or review_round_limit())["limit"]
    records = [board_record(f, events, home, held, roots, viewer, compacted.get(f["path"]), review_limit)
               for f in lanes]
    for r in removed_records(events, since, {os.path.realpath(r["path"]) for r in records}, names, view):
        records.append({**r, "compactions": 0, "compacted_pane": None, "review_rounds": 0,
                        "review_limit": review_limit, "review_approved": None})
    if view is not None:
        view["lanes"], view["branches"] = dict(select.lanes), dict(select.branches)
        for r in records:
            if r.get("branch"):
                view["branches"].setdefault(r["branch"], r.get("orch"))
    return sorted(records, key=lambda r: (r["phase"] == "removed", r["lane"], r["path"]))


def precise_now() -> str:
    return datetime.now().astimezone().isoformat(timespec="microseconds")


def save_board(home: Path, records: list[dict], made: str, path: Path | None = None) -> bool:
    """Write board.json (`path`: an orch's own, orch_files; default the root one) unless it already holds a board made
    later. `made` is when the board collection began. The caller holds the project lock."""
    path = path or home / BOARD_FILE
    path.parent.mkdir(parents=True, exist_ok=True)
    if event_time({"ts": read_json(path).get("made")}) > event_time({"ts": made}):
        return False
    write_json(path, {"made": made, "project": home.name, "lanes": records})
    return True


@contextmanager
def project_lock(home: Path, wait: float | None = None):
    """The project's lock, <home>/.lock. Waits up to LOCK_WAIT seconds for it."""
    wait = LOCK_WAIT if wait is None else wait
    path = home / LOCK_FILE
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        deadline = time.monotonic() + wait
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise FleetError(f"project {home.name} is busy: another fleet command has held {path} for "
                                     f"{wait:g}s; try again")
                time.sleep(0.1)
        yield
    finally:
        os.close(fd)


def clip(text: str, width: int) -> str:
    text = re.sub(r"\s+", " ", text or "").strip()
    return text if len(text) <= width else text[:width - 1] + "…"


def age_text(seconds: float) -> str:
    seconds = max(0, int(seconds))
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= size:
            return f"{seconds // size}{unit}"
    return f"{seconds}s"


def as_text(value) -> str:
    return value if isinstance(value, str) else ""


def as_dict(value) -> dict:
    return value if isinstance(value, dict) else {}


def board_lines(records: list, owners: bool = False, column: bool = False) -> list[str]:
    """The board as a compact text table: one line per lane. A damaged record in board.json shows as blanks. NOTE is
    the first that applies: the plan warning, a risky diff, the blocked line, the review limit, the compactions
    (signal_notes), the next step, the follow-ups, another clone, unowned. `owners` (a project with several
    orchs): an unowned lane gets the note `unowned: adopt it`, last of the notes. `column` (every lane, --all): an
    ORCH column, and LANE clipped to 24."""
    records = [r for r in records if isinstance(r, dict)] if isinstance(records, list) else []
    if not records:
        return ["no lanes"]
    table = [["LANE"] + (["ORCH"] if column else []) + ["PHASE", "PR", "PANES", "LAST", "NOTE"]]
    for r in records:
        pr = as_dict(r.get("pr"))
        panes = r.get("panes") if isinstance(r.get("panes"), list) else []
        panes = " ".join(f"{as_text(p.get('role')) or as_text(p.get('agent'))}:{as_text(p.get('status')) or '-'}"
                         for p in panes if isinstance(p, dict) and p.get("agent"))
        last = as_dict(r.get("last_event"))
        blocked, nxt, warning = as_text(r.get("blocked")), as_text(r.get("next")), as_text(r.get("warning"))
        risky = risk_note(r.get("risk"))
        held = [x for x in r.get("follow_ups") or [] if isinstance(x, str)] if isinstance(r.get("follow_ups"), list) else []
        clone = as_text(r.get("clone"))
        unowned = owners and "orch" in r and r.get("orch") is None and r.get("phase") != "removed"
        review, compact = signal_notes(r)
        note = (warning if warning else risky if risky else f"blocked: {blocked}" if blocked
                else review if review else compact if compact else f"next: {nxt}" if nxt else f"follow-ups: {', '.join(held)}" if held
                else f"in another clone: {short_path(clone)}" if clone else "unowned: adopt it" if unowned else "")
        number = pr.get("number")
        table.append([clip(as_text(r.get("lane")) or "?", 24 if column else 28)]
                     + ([clip(as_text(r.get("orch")) or "-", 12)] if column else []) + [as_text(r.get("phase")) or "?",
                      f"#{number} {as_text(pr.get('state')).lower()}".strip() if isinstance(number, int) else "-",
                      panes or "-", f"{clock(last)} {as_text(last.get('event'))}".strip() if last else "-",
                      clip(note, 60)])
    widths = [max(len(row[i]) for row in table) for i in range(len(table[0]) - 1)]
    return ["  ".join([c.ljust(widths[i]) for i, c in enumerate(row[:-1])] + [row[-1]]).rstrip() for row in table]


def project_home(args: argparse.Namespace, create: bool = True) -> Path:
    """The home of the project that --project names, else of the project that holds the current directory."""
    if getattr(args, "project", None):
        d = fleet_home() / PROJECTS_DIR / args.project
        if not (d / PROJECT_FILE).is_file():
            known = ", ".join(p.name for p in project_dirs()) or "none yet"
            raise FleetError(f"no project {args.project!r}. Projects: {known}")
        return d
    cwd = os.getcwd()
    d = project_for(cwd, create=create)
    if d:
        return d
    # Why there is none. Short limits, as in git_toplevel: project_for may have waited for git already.
    cp = run_git(cwd, "rev-parse", "--is-inside-work-tree", timeout=3)
    inside = cp.stdout.strip() if cp is not None and cp.returncode == 0 else None
    if inside == "false":
        raise FleetError("this directory is in a git repository but not in a working tree (a bare repository, or "
                         "inside .git); run this in a checkout of the project, or pass --project NAME")
    if cp is not None and cp.returncode == 128 and no_git_entry(cwd):
        raise FleetError("this directory is in no git repository, so it is in no fleet project; run this in a "
                         "checkout of the project, or pass --project NAME")
    # In a working tree: "no home yet" only when git tells the whole identity (remotes too) and no home knows it.
    ident = repo_identity(cwd, timeout=3, strict=True) if inside == "true" and not create else None
    if ident and not find_project(ident["keys"]):
        raise FleetError(f"the repository {ident['top']} has no fleet project home yet: `fleet orch claim` (registers "
                         "this pane as its orchestrator) or `fleet board` creates it; or pass --project NAME")
    raise FleetError("git could not tell the project of this directory (a git call failed or timed out); try again, "
                     "or pass --project NAME")


def pane_state(pane: str | None) -> str:
    """`alive` (the pane runs an agent), `dead` (herdr says that the pane is gone, or shows it without an agent),
    or `unknown` (no herdr, a timeout, an error, or an answer that is not about this pane or that it cannot read)."""
    if not pane or not shutil.which("herdr"):
        return "unknown"
    try:
        cp = run(["herdr", "pane", "get", pane], timeout=10)
    except FleetError:
        return "unknown"
    try:
        data = json.loads((cp.stdout or "").strip() or (cp.stderr or "").strip())
    except ValueError:
        return "unknown"
    if not isinstance(data, dict):
        return "unknown"
    if data.get("error") is not None:
        return "dead" if as_dict(data.get("error")).get("code") == "pane_not_found" else "unknown"
    # Valid only for the pane asked about. A shell pane, also one whose agent exited, has no `agent` key.
    info = as_dict(as_dict(data.get("result")).get("pane"))
    if cp.returncode != 0 or info.get("pane_id") != pane:
        return "unknown"
    agent = info.get("agent")
    if agent is None:
        return "dead"
    return "alive" if isinstance(agent, str) and agent else "unknown"


def project_checkouts(home: Path) -> list[str]:
    """Every checkout of the project on this machine: each clone's main checkout and its linked worktrees."""
    out: dict[str, str] = {}
    for key in project_keys(read_json(home / PROJECT_FILE)):
        if not key.startswith("local:"):
            continue
        root = key[len("local:"):]
        if not os.path.isdir(root):
            continue
        listing = run_git(root, "worktree", "list", "--porcelain")
        entries = parse_worktree_porcelain(listing.stdout if listing is not None and listing.returncode == 0 else "")
        for path in [root] + [e["path"] for e in entries]:
            out.setdefault(os.path.realpath(path), path)
    return list(out.values())


def fleet_md_warnings(home: Path, pane: str) -> list[str]:
    """A FLEET.md in a checkout of the project whose `Orchestrator:` line names a pane other than `pane` that is
    alive, or of which herdr cannot tell."""
    warnings = []
    for checkout in project_checkouts(home):
        path = Path(checkout) / FLEET_DIR / ORCHESTRATOR_FILE
        m = ORCHESTRATOR_LINE.search(read_text(path)) if path.is_file() else None
        if not m or m.group(1) == pane:
            continue
        state = pane_state(m.group(1))
        if state != "dead":
            what = "is alive" if state == "alive" else "may be alive (herdr cannot tell)"
            warnings.append(f"{path} names pane {m.group(1)}, which {what}: another orchestrator may still use "
                            "FLEET.md for this project")
    return warnings


def orch_registry(home: Path) -> tuple[dict[str, dict], bool]:
    """(the orchs of the project by name, whether orch.json is in format 2). The legacy shape (one record with its
    pane at the top level, as 0.8.x writes it) reads as the orch `default`; no file, or one that cannot be read,
    holds none. A format that this helper does not know raises: no writer may then replace the file."""
    data = read_json(home / ORCH_FILE)
    if "format" in data:
        if data.get("format") != 2:
            raise FleetError(f"{home / ORCH_FILE} has format {data.get('format')!r}, which this helper does not know; "
                             "upgrade the fleet plugin")
        orchs = as_dict(data.get("orchs"))
        return {k: v for k, v in orchs.items()
                if isinstance(k, str) and ORCH_NAME.fullmatch(k) and isinstance(v, dict)}, True
    return ({DEFAULT_ORCH: data} if data else {}), False


def read_orchs(home: Path) -> dict[str, dict]:
    """The orchs of the project by name, from either shape of orch.json."""
    return orch_registry(home)[0]


def write_orchs(home: Path, orchs: dict[str, dict], root_owner: str | None = None) -> bool:
    """Write the project's orchs; the caller holds the project lock. While the file is legacy (or absent) and the
    only orch is `default`, the legacy shape (no orch: no file), as 0.8.x writes it. Otherwise format 2, and the file
    never goes back. The switch to format 2 moves the root digest.json and board.json into orchs/<root_owner>/ (the
    orch whose files they were: `default`, or the first orch of a project that had none) before it writes, so a
    crash between the two leaves files that a retry finds. Every orch of a format 2 file gets its ORCH.md. Returns
    whether this write switched the format."""
    _, is2 = orch_registry(home)
    if not is2 and set(orchs) <= {DEFAULT_ORCH}:
        if orchs:
            write_json(home / ORCH_FILE, orchs[DEFAULT_ORCH])
        else:
            (home / ORCH_FILE).unlink(missing_ok=True)
        return False
    if not is2 and root_owner:
        dest = home / ORCHS_DIR / root_owner
        dest.mkdir(parents=True, exist_ok=True)
        for name in (DIGEST_FILE, BOARD_FILE):
            if (home / name).exists() and not (dest / name).exists():
                os.replace(home / name, dest / name)
    write_json(home / ORCH_FILE, {"format": 2, "orchs": orchs})
    for name in orchs:
        ensure_orch_md(home, name)
    return not is2


def ensure_orch_md(home: Path, name: str) -> bool:
    """Create orchs/<name>/ORCH.md from the template when it is missing; never overwrite it. Returns whether it did."""
    path = home / ORCHS_DIR / name / ORCH_MD
    if path.exists():
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(ORCH_TEMPLATE.format(name=name, project=home.name))
    return True


def orch_files(home: Path, name: str | None, is2: bool | None = None) -> dict:
    """The files of orch `name`: in format 2 its folder orchs/<name>/ with its digest.json, board.json and ORCH.md;
    in the legacy shape, and for no orch, the root digest.json and board.json, and no ORCH.md."""
    is2 = orch_registry(home)[1] if is2 is None else is2
    own = bool(is2 and name)
    d = home / ORCHS_DIR / name if own else home
    return {"dir": d, "digest": d / DIGEST_FILE, "board": d / BOARD_FILE, "orch_md": d / ORCH_MD if own else None}


def check_orch_name(name: str) -> str:
    if not isinstance(name, str) or not ORCH_NAME.fullmatch(name):
        raise FleetError(f"not an orch name: {name!r}; an orch name is lowercase: use a-z, 0-9, '.', '_' and '-' "
                         "(at most 40, the first a letter or a digit)")
    return name


def current_orch(home: Path, name: str | None = None,
                 orchs: dict[str, dict] | None = None) -> tuple[str | None, dict | None]:
    """The orch that a command acts for: `name` (--orch) when given, which must exist; else the orch whose pane is
    the caller's (HERDR_PANE_ID); else, when the project has exactly one orch, that one; else (None, None)."""
    orchs = read_orchs(home) if orchs is None else orchs
    if name:
        if name not in orchs:
            raise FleetError(f"no orch {name!r} in project {home.name}; its orchs: {', '.join(sorted(orchs)) or 'none'}")
        return name, orchs[name]
    me = os.environ.get("HERDR_PANE_ID") or None
    mine = next((n for n, r in orchs.items() if me and r.get("pane") == me), None)
    if mine:
        return mine, orchs[mine]
    if len(orchs) == 1:
        only = next(iter(orchs))
        return only, orchs[only]
    return None, None


def orch_title(home: Path, name: str, is2: bool = True) -> str:
    """How a refusal names an orch. A legacy orch.json (one orch, `default`) keeps the 0.8.3 text, byte for byte:
    the name shows only in format 2 (and in the re-brief and `orch show`)."""
    return f"orch {name} of project {home.name}" if is2 else f"the orch of project {home.name}"


def as_list(value) -> list:
    return [v for v in value if isinstance(v, str)] if isinstance(value, list) else []


def orch_aliases(orchs: dict[str, dict]) -> dict[str, str]:
    """Each name that an event can carry in its `orch` field, to the orch that has it now: every orch's own name,
    and the names it had before a rename (its record's `former`). A current name wins over a former one."""
    aliases = {old: n for n, r in orchs.items() for old in as_list(r.get("former"))}
    aliases.update({n: n for n in orchs})
    return aliases


def former_owner(orchs: dict[str, dict], name: str) -> str | None:
    """The orch that had `name` before a rename, if any (and does not have it now)."""
    if name in orchs:
        return None
    return next((n for n, r in sorted(orchs.items()) if name in as_list(r.get("former"))), None)


def former_refusal(home: Path, owner: str, name: str) -> str:
    return (f"orch {owner} of project {home.name} was called {name} before, and its events name it so: pick another "
            f"name, or `fleet orch rename {owner} {name}`")


def orch_out(home: Path, name: str | None = None, is2: bool | None = None) -> dict:
    files = orch_files(home, name, is2)
    out = {"project": home.name, "home": str(home), "project_md": str(home / PROJECT_MD), "board": str(files["board"])}
    if files["orch_md"]:
        out["orch_md"] = str(files["orch_md"])
    return out


def refuse(**fields) -> int:
    print(json.dumps({"ok": False, "changed": "nothing", **fields}, indent=2, ensure_ascii=False))
    return 2


ALIVE_WORDS = {"alive": "alive", "dead": "not alive", "unknown": "alive or not: herdr cannot tell"}


def orch_rows(home: Path, orchs: dict[str, dict], is2: bool, states: dict[str, str]) -> list[dict]:
    """One row for each orch, by name: its record's fields, its pane's state and its cached board."""
    me = os.environ.get("HERDR_PANE_ID") or None
    rows = []
    for name, rec in sorted(orchs.items()):
        board = read_json(orch_files(home, name, is2)["board"])
        lanes = [r for r in board.get("lanes") if isinstance(r, dict)] if isinstance(board.get("lanes"), list) else []
        state = states[name]
        rows.append({"name": name, "pane": rec.get("pane"), "state": state,
                     "alive": {"alive": True, "dead": False}.get(state), "self": bool(me and rec.get("pane") == me),
                     "session": rec.get("session"), "checkout": rec.get("checkout"),
                     "claimed_at": rec.get("claimed_at"), "board_made": board.get("made"),
                     "lanes": sum(1 for r in lanes if r.get("phase") != "removed") if board.get("made") else None})
    return rows


def project_lane_stubs(home: Path) -> list[dict]:
    """The lane stubs of the project at `home` (lane_stubs with the project filter): herdr and git, no gh."""
    select = lane_selector(home)
    return [s for s in lane_stubs(others=False)[0] if select(s)]


def cmd_orch(args: argparse.Namespace) -> int:
    action = args.action or "show"
    me = os.environ.get("HERDR_PANE_ID") or None
    if args.names and action != "rename":
        raise FleetError(f"orch {action} takes no names; `fleet orch rename OLD NEW` renames, and --orch NAME names "
                         "the orch of show and release")
    if action in ("show", "list"):
        home = project_home(args, create=False)
        orchs, is2 = orch_registry(home)
        states = {n: pane_state(r.get("pane")) for n, r in orchs.items()}
        rows = orch_rows(home, orchs, is2, states)
        if action == "list":
            if args.json:
                print(json.dumps({"project": home.name, "format": 2 if is2 else 1, "orchs": rows}, indent=2,
                                 ensure_ascii=False))
                return 0
            if not rows:
                print(f"project {home.name}: no orch registered: `fleet orch claim` registers the calling pane")
                return 0
            table = [["NAME", "PANE", "STATE", "SESSION", "CHECKOUT", "CLAIMED", "BOARD"]]
            for r in rows:
                made = r["board_made"]
                board = (f"{plural(r['lanes'], 'lane')}, {age_text(time.time() - event_time({'ts': made}))} old"
                         if made else "none yet")
                table.append([r["name"], (r["pane"] or "-") + (" (this pane)" if r["self"] else ""),
                              {"dead": "not alive", "unknown": "unknown"}.get(r["state"], r["state"]),
                              short_id(r["session"]), short_path(r["checkout"] or "-"),
                              clock({"ts": r["claimed_at"]}) if r["claimed_at"] else "-", board])
            print(f"project {home.name}: {plural(len(rows), 'orch')}")
            widths = [max(len(row[i]) for row in table) for i in range(len(table[0]) - 1)]
            for row in table:
                print("  ".join([c.ljust(widths[i]) for i, c in enumerate(row[:-1])] + [row[-1]]).rstrip())
            return 0
        name, rec = current_orch(home, args.orch, orchs)
        state = states.get(name) if rec else None
        alive = {"alive": True, "dead": False}.get(state) if state else None
        out = {**orch_out(home, name, is2), "name": name, "orch": rec, "alive": alive,
               "self": bool(rec and me and rec.get("pane") == me), "format": 2 if is2 else 1,
               "orchs": [{k: r[k] for k in ("name", "pane", "alive", "self")} for r in rows]}
        board = read_json(orch_files(home, name, is2)["board"])
        out["board_made"] = board.get("made")
        if args.json:
            print(json.dumps(out, indent=2, ensure_ascii=False))
            return 0
        print(f"project     {home.name}  {short_path(str(home))}")
        if rec:
            print(f"orch        {name}: pane {rec.get('pane')}" + (" (this pane)" if out["self"] else "")
                  + f", {ALIVE_WORDS[state]}")
            print(f"            claimed {rec.get('claimed_at') or '-'}, workspace {rec.get('workspace') or '-'}, "
                  f"session {short_id(rec.get('session'))}, checkout {short_path(rec.get('checkout') or '-')}")
        elif orchs:
            print(f"orch        none of the {len(orchs)} orchs is this pane's: pass --orch NAME")
        else:
            print("orch        none registered: `fleet orch claim` registers the calling pane")
        others = [r for r in rows if r["name"] != name]
        for i, r in enumerate(others):
            print(("other orchs " if i == 0 else " " * 12) + f"{r['name']}: pane {r['pane'] or '-'}"
                  + (" (this pane)" if r["self"] else "") + f", {ALIVE_WORDS[r['state']]}")
        print(f"PROJECT.md  {short_path(out['project_md'])}" + ("" if Path(out["project_md"]).is_file() else "  (missing)"))
        if out.get("orch_md"):
            print(f"ORCH.md     {short_path(out['orch_md'])}" + ("" if Path(out["orch_md"]).is_file() else "  (missing)"))
        made = board.get("made")
        age = age_text(time.time() - event_time({"ts": made})) + " old" if made else "none yet"
        print(f"board.json  {short_path(out['board'])}  ({age})")
        return 0
    if action == "claim":
        home = project_home(args)
        pane = args.pane or me
        if not pane:
            raise FleetError("no pane to register: pass --pane P or run inside Herdr")
        if args.name:
            check_orch_name(args.name)
        # Slow lookups first; the check and the write run under the lock.
        warnings = fleet_md_warnings(home, pane)
        workspace = os.environ.get("HERDR_WORKSPACE_ID") if pane == me else None
        if pane != me:
            try:
                workspace = pane_info(pane).get("workspace_id")
            except (FleetError, KeyError, TypeError, AttributeError):
                workspace = None
        with project_lock(home):
            orchs, is2 = orch_registry(home)
            held = next((n for n, r in orchs.items() if r.get("pane") == pane), None)
            mine = next((n for n, r in orchs.items() if me and r.get("pane") == me), None)
            if args.name:
                name = args.name
            elif args.replace and mine:
                name = mine  # a handoff from the caller's orch
            elif held:
                name = held  # a re-claim
            elif not orchs:
                name = DEFAULT_ORCH
            elif len(orchs) == 1:
                name = next(iter(orchs))  # the rules below decide, as with one orch before
            else:
                return refuse(orchs={n: r.get("pane") for n, r in sorted(orchs.items())},
                              refused=f"project {home.name} has {len(orchs)} orchs ({', '.join(sorted(orchs))}); "
                                      "`fleet orch claim --name NEW` opens a theme, `--name NAME` takes an orch whose "
                                      "pane is dead")
            if held and held != name:
                return refuse(orch=orchs[held], refused=f"pane {pane} is already {orch_title(home, held)}; a pane is "
                                                        "the orch of one theme: `fleet orch release` first, or "
                                                        f"`fleet orch rename {held} {name}`")
            former = former_owner(orchs, name)
            if former:
                return refuse(refused=former_refusal(home, former, name))
            current = orchs.get(name, {})
            old = current.get("pane") if isinstance(current.get("pane"), str) else None
            handoff = bool(args.replace and me and me == old)
            title = orch_title(home, name, is2)
            if old and old != pane and not handoff:
                if args.replace:
                    return refuse(orch=current, refused=f"pane {old} is {title}; --replace works only from that "
                                                        "pane")
                state = pane_state(old)
                if state == "alive":
                    return refuse(orch=current, refused=f"pane {old} is {title} and is alive; from that pane, "
                                                        "`fleet orch claim --pane <new pane> --replace` hands it over")
                if state == "unknown" and not args.force:
                    return refuse(orch=current, refused=f"pane {old} is {title}, and herdr cannot tell whether it is "
                                                        "alive; check that pane, then `fleet orch claim --force` "
                                                        "takes over")
            rec = {"pane": pane, "workspace": workspace, "checkout": git_toplevel(os.getcwd()) or os.getcwd(),
                   "session": os.environ.get("CLAUDE_CODE_SESSION_ID") if pane == me else None,
                   "claimed_at": now_iso()}
            rec = {k: v for k, v in rec.items() if v}
            if current.get("former"):
                rec["former"] = current["former"]  # the names that the orch had before: its old events use them
            root_owner = DEFAULT_ORCH if DEFAULT_ORCH in orchs else name
            switched = write_orchs(home, {**orchs, name: rec}, root_owner)
            project_md = home / PROJECT_MD
            created = not project_md.exists()
            if created:
                project_md.write_text(PROJECT_TEMPLATE.format(name=home.name))
            record("orch_claim", None, home=home, orch=name, pane=pane, old=old, workspace=rec.get("workspace"),
                   checkout=rec.get("checkout"), replace=True if args.replace else None,
                   force=True if args.force else None, switched=True if switched else None)
        print(json.dumps({"ok": True, **orch_out(home, name), "name": name, "orch": rec, "previous": old,
                          "project_md_created": created, "format_switched": switched, "warnings": warnings},
                         indent=2, ensure_ascii=False))
        return 0
    if action == "rename":
        if len(args.names) != 2:
            raise FleetError("orch rename takes two names: OLD NEW")
        old_name, new_name = (check_orch_name(n) for n in args.names)
        home = project_home(args, create=False)
        if old_name not in read_orchs(home):
            return refuse(refused=f"no orch {old_name!r} in project {home.name}")
        require_herdr()
        stubs = project_lane_stubs(home)  # herdr and git, before the lock
        with project_lock(home):
            orchs, is2 = orch_registry(home)
            if old_name not in orchs:
                return refuse(refused=f"no orch {old_name!r} in project {home.name}")
            if new_name in orchs:
                return refuse(refused=f"project {home.name} already has an orch {new_name!r}")
            former = former_owner(orchs, new_name)
            if former and former != old_name:
                return refuse(refused=former_refusal(home, former, new_name))
            folder = home / ORCHS_DIR / new_name
            if folder.exists():
                return refuse(refused=f"{folder} exists (the files of an orch that was released); pick another name")
            if is2 and (home / ORCHS_DIR / old_name).exists():
                os.replace(home / ORCHS_DIR / old_name, folder)
            # The orch keeps its old names, so that the events that name one go to it (orch_aliases).
            names = [n for n in [*as_list(orchs[old_name].get("former")), old_name] if n != new_name]
            renamed = {(new_name if n == old_name else n): ({**r, "former": names} if n == old_name else r)
                       for n, r in orchs.items()}
            switched = write_orchs(home, renamed, root_owner=new_name)
            lanes = []
            for s in stubs:
                path = Path(s["path"]) / FLEET_DIR / LANE_FILE
                owner = read_json(path)
                if owner.get("orch") == old_name:
                    write_json(path, {**owner, "orch": new_name})
                    lanes.append(s["path"])
            record("orch_rename", None, home=home, orch=new_name, old=old_name, pane=orchs[old_name].get("pane"),
                   lanes=lanes, switched=True if switched else None)
        print(json.dumps({"ok": True, **orch_out(home, new_name), "name": new_name, "old": old_name,
                          "format_switched": switched, "lanes": lanes}, indent=2, ensure_ascii=False))
        return 0
    home = project_home(args, create=False)
    with project_lock(home):
        orchs, is2 = orch_registry(home)
        if not orchs:
            print(json.dumps({"ok": True, "changed": "nothing", "note": f"project {home.name} has no orch"},
                             indent=2))
            return 0
        name, current = current_orch(home, args.orch, orchs)
        if name is None:
            return refuse(orchs={n: r.get("pane") for n, r in sorted(orchs.items())},
                          refused=f"project {home.name} has {len(orchs)} orchs and this pane is none of them: name "
                                  "the orch: --orch NAME")
        if current.get("pane") != me and not args.force:
            return refuse(orch=current, refused=f"pane {current.get('pane')} is "
                                                + (f"{orch_title(home, name)}, not this pane" if is2 else
                                                   "the orch, not this pane") + "; --force releases it")
        write_orchs(home, {n: r for n, r in orchs.items() if n != name})
        record("orch_release", None, home=home, orch=name, pane=current.get("pane"),
               force=True if args.force else None)
    print(json.dumps({"ok": True, "project": home.name, "name": name, "released": current}, indent=2,
                     ensure_ascii=False))
    return 0


def digest_base(path: Path) -> tuple[float | None, dict[str, dict], dict[str, int]]:
    """The digest's cursor (a timestamp, or None), the lanes it saw then by path, and how far it read each log, from
    the digest.json at `path` (an orch's own, orch_files)."""
    data = read_json(path)
    cursor = event_time({"ts": data.get("cursor")}) or None
    lanes = as_dict(data.get("lanes"))
    read = {k: v for k, v in as_dict(data.get("read")).items()
            if isinstance(k, str) and isinstance(v, int) and not isinstance(v, bool) and v >= 0}
    return cursor, {k: v for k, v in lanes.items() if isinstance(k, str) and isinstance(v, dict)}, read


def read_new_events(home: Path, read: dict[str, int],
                    budget: int | None = None) -> tuple[list[dict], dict[str, int], bool]:
    """The complete lines of each monthly log after the offset in `read` (a file not in it from 0; a file
    shorter than its offset was rewritten, so from 0 too), the offsets after them, and whether `budget` (bytes
    in all) cut the read short. File order is time order: `record` takes the time while it holds the lock."""
    events: list[dict] = []
    offsets: dict[str, int] = {}
    left = budget
    for f in sorted((home / EVENTS_DIR).glob("*.jsonl")):
        start = read.get(f.name, 0)
        try:
            size = f.stat().st_size
            if start > size:
                start = 0
            want = size - start if left is None else min(size - start, left)
            with open(f, "rb") as fh:
                fh.seek(start)
                data = fh.read(want)
        except OSError:
            offsets[f.name] = start
            continue
        end = data.rfind(b"\n") + 1  # a partial last line waits for the next read
        offsets[f.name] = start + end
        events += jsonl_events(data[:end])
        if left is not None:
            left -= len(data)
            if len(data) < size - start:
                return events, offsets, True
    return events, offsets, False


PROJECT_EVENTS = ("orch_claim", "orch_release", "orch_rename") + FOLLOW_UP_EVENTS  # every orch sees them


def under_lane(path, lanes: dict[str, str | None]) -> tuple[bool, str | None]:
    """(whether `path` is at or inside one of `lanes`, real path -> owner; that lane's owner)."""
    if not isinstance(path, str) or not path:
        return False, None
    real = os.path.realpath(path)
    for root, owner in lanes.items():
        if real == root or real.startswith(root.rstrip(os.sep) + os.sep):
            return True, owner
    return False, None


def view_shows(e: dict, view: dict | None) -> bool:
    """Whether an event belongs on the view of an orch (`view`: {name, lanes, branches}, None: every event). A
    project-level event (PROJECT_EVENTS) goes to every orch. An event that names its orch (`orch`: the lane's owner
    when it was recorded, or the orch of a claim, adopt, cleanup ...) goes to that orch, through its former names
    too. An `adopt` also goes to the orch that lost the lane (its `old`, through the former names too). An event
    without one (an unowned lane, a log of 0.8.x) of a lane (its `lane` or `cwd` inside a lane of the project, else
    its `branch` a lane's) shows when that lane is the orch's own or unowned now; any other shows."""
    if not view or e.get("event") in PROJECT_EVENTS:
        return True
    owner = text_or_none(e.get("orch"))
    if owner:
        # The owner at the time of the event (record() puts it there; a rename's old name goes to the orch that has
        # it now): the event goes to that orch, wherever the lane went since; an adopt also to the old owner.
        names = view.get("aliases") or {}
        return view.get("name") in [names.get(n, n) for n in (owner, adopt_old_owner(e)) if n]
    mine = (None, view.get("name"))
    for path in (e.get("lane"), e.get("cwd")):
        hit, owner = under_lane(path, view.get("lanes") or {})
        if hit:
            return owner in mine
    branches = view.get("branches") or {}
    if e.get("branch") in branches:
        return branches[e["branch"]] in mine
    return e.get("orch") in mine


def digest_events(events: list[dict], orch_pane: str | None, lane_paths: list[str],
                  view: dict | None = None) -> list[dict]:
    """Of the unseen events, those for the orch: not its own, no `phase` and no session events, except a
    compaction in a lane pane (that lane can need a reset); with a `view` (view_shows), only the events of its
    lanes and of the project."""
    out = []
    for e in events:
        kind = e.get("event")
        if kind == "phase" or not view_shows(e, view):
            continue
        if orch_pane and orch_pane in (e.get("pane"), (e.get("by") or {}).get("pane")):
            continue
        if kind in ("session_start", "session_end"):
            cwd = e.get("cwd") or ""
            if not (kind == "session_start" and e.get("source") == "compact" and e.get("role") != "orchestrator"
                    and cwd and any(inside(cwd, p) for p in lane_paths)):
                continue
        out.append(e)
    return out


def phase_changes(records: list[dict], base: dict[str, dict]) -> list[dict]:
    """`lane: old -> new` for each lane whose phase moved since the baseline; new lanes and lanes gone too."""
    changes = []
    on_board = set()
    for r in records:
        on_board.add(r["path"])
        old = (base.get(r["path"]) or {}).get("phase")
        if old != r["phase"]:
            changes.append({"lane": r["lane"], "path": r["path"], "branch": r.get("branch"), "old": old,
                            "new": r["phase"]})
    for path, b in base.items():
        if path not in on_board and b.get("phase") != "removed":
            changes.append({"lane": b.get("lane") or os.path.basename(path), "path": path, "branch": b.get("branch"),
                            "old": b.get("phase"), "new": "gone"})
    return changes


def event_line(e: dict) -> str:
    where = e.get("name") or e.get("branch") or e.get("label") or "-"
    return clip(f"{clock(e)}  {e.get('event')}  {e.get('pane') or '-'}  {where}  {describe_event(e)}", 180)


def view_changed(home: Path, view: dict) -> str | None:
    """Why the board that `board` collected for `view` no longer fits the project, under the project lock before
    it saves: the orchs or the shape of orch.json changed (a claim, a rename, a release: its file may have moved),
    or a lane of the view has another owner now. None when it still fits. Reads files only."""
    orchs, is2 = orch_registry(home)
    if is2 != view["is2"] or sorted(orchs) != sorted(view["orchs"]):
        return "the orchs of the project changed while the board was made; run `fleet board` again"
    for path, owner in (view.get("lanes") or {}).items():
        if lane_owner(path) != owner:
            return f"the owner of lane {path} changed while the board was made; run `fleet board` again"
    return None


def board_head(home: Path, view: dict, records: list) -> str:
    who = (" (every orch's lanes)" if view["all"] and view["several"] else " (every lane)" if view["all"]
           else f", orch {view['name']}" if view["several"] else "")
    return f"project {home.name}{who}: {plural(len(records), 'lane')}"


def cmd_board(args: argparse.Namespace) -> int:
    home = project_home(args)
    view = orch_view(home, args.orch, args.all)
    files = view["files"]
    made = precise_now()
    cursor, base, _ = digest_base(files["digest"])
    limit = review_round_limit()
    records = make_board(home, cursor, {p: b.get("lane") for p, b in base.items() if b.get("lane")}, view, limit)
    saved, stale = False, None
    if not view["all"]:
        with project_lock(home):
            stale = view_changed(home, view)
            if not stale:
                saved = save_board(home, records, made, files["board"])
    research = open_research(home)
    if args.json:
        print(json.dumps({"project": home.name, "orch": view["name"], "all": view["all"],
                          "board": str(files["board"]) if not view["all"] else None, "saved": saved,
                          **({"stale": stale} if stale else {}),
                          "review_limit": limit, "lanes": records, "research": research}, indent=2, ensure_ascii=False))
        return 0
    print(board_head(home, view, records) + ("" if saved or view["all"] else
                                             f" (not saved: {stale})" if stale else
                                             " (board.json holds a newer board)"))
    print("\n".join(board_lines(records, owners=view["several"], column=view["all"])))
    if limit.get("error"):
        print(f"\nReview round limit {limit['limit']} (the default): {limit['error']}")
    if research:
        print(f"\nOpen research ({len(research)}, no RESEARCH DONE line yet):")
        for r in research:
            print(f"  {short_path(r['file'])}" + (f"  {clip(r['title'], 80)}" if r["title"] else ""))
    return 0


def cmd_digest(args: argparse.Namespace) -> int:
    """A digest that consumes holds the project lock from its permission check through its commit, so the
    check still holds when it commits, and two digests run one after the other. It reads and moves the cursor of
    the caller's orch (current_orch), and shows that orch's view."""
    home = project_home(args)
    me = os.environ.get("HERDR_PANE_ID") or None
    with ExitStack() as lock:
        read_only = "--peek" if args.peek else None
        if not read_only:
            lock.enter_context(project_lock(home))
        view = orch_view(home, args.orch)
        name, rec, files = view["name"], view["record"], view["files"]
        orch_pane = (rec or {}).get("pane") or None
        if not read_only and name is None and view["several"]:
            read_only = "name the orch: --orch NAME"
            lock.close()
        elif not read_only and orch_pane and orch_pane != me:
            state = pane_state(orch_pane)
            if state != "dead":
                read_only = (f"pane {orch_pane} is " + (f"orch {name}" if view["is2"] else "the orch")
                             + " of this project" + ("; herdr cannot tell whether it is alive" if state == "unknown"
                                                     else ""))
                lock.close()
        made = precise_now()
        cursor, base, read = digest_base(files["digest"])
        records = make_board(home, cursor, {p: b.get("lane") for p, b in base.items() if b.get("lane")}, view)
        changes = phase_changes(records, base)
        events, offsets, _ = read_new_events(home, read)
        shown = digest_events(events, orch_pane, [r["path"] for r in records],
                              view if view["filtered"] else None)
        omitted = max(0, len(shown) - DIGEST_EVENTS_MAX)
        shown = shown[-DIGEST_EVENTS_MAX:]
        if not read_only:
            for c in changes:
                record("phase", None, home=home, lane=c["path"], name=c["lane"], branch=c.get("branch"),
                       old=c["old"], new=c["new"], orch=name)
            save_board(home, records, made, files["board"])
            write_json(files["digest"], {"cursor": now_iso(), "read": offsets, "lanes": {
                r["path"]: {"lane": r["lane"], "branch": r.get("branch"), "phase": r["phase"]} for r in records}})
            session = text_or_none(os.environ.get("CLAUDE_CODE_SESSION_ID"))
            if rec and me and rec.get("pane") == me and session and rec.get("session") != session:
                write_orchs(home, {**view["orchs"], name: {**rec, "session": session}})  # F9: the hook's match
    since = datetime.fromtimestamp(cursor).astimezone().isoformat(timespec="seconds") if cursor else None
    if args.json:
        print(json.dumps({"project": home.name, "orch": name, "since": since, "read_only": bool(read_only),
                          "why": read_only, "changes": changes, "events": shown, "omitted": omitted,
                          "lanes": records}, indent=2, ensure_ascii=False))
        return 0
    head = (f"project {home.name}" + (f", orch {name}" if view["several"] and name else "") + ": digest since "
            + (clock({"ts": since}) if since else "the start (no digest yet)"))
    print(head + (f"; read only ({read_only}), nothing moved" if read_only else ""))
    print("\nPhases" if changes else "\nNo phase changes.")
    for c in changes:
        print(f"  {c['lane']}: {c['old'] or 'new'} -> {c['new']}")
    if shown:
        print(f"\nEvents ({len(shown)}" + (f"; {omitted} earlier not shown: `fleet log`" if omitted else "") + ")")
        for e in shown:
            print("  " + event_line(e))
    else:
        print("\nNo new events.")
    return 0


def helper_command(env) -> str:
    """The helper as the orch runs it from its Bash tool: an absolute path in double quotes. Hooks get
    CLAUDE_PLUGIN_ROOT, the Bash tool does not, so the value is filled in here."""
    root = text_or_none(env.get("CLAUDE_PLUGIN_ROOT"))
    base = root.rstrip("/") if root else str(PLUGIN_ROOT)
    return f'python3 "{base}/scripts/fleet"'


HOOK_BAD_INPUT = "the hook input could not be read"
REBRIEF, ORDINARY, NOTE = "re-brief", "ordinary", "note"  # the outcomes of orch_decide


def orch_candidates(env) -> tuple[str | None, list[tuple[Path, str, dict]]]:
    """(this pane, the orchs that name it: (home, orch name, record) for each). Reads files only, never git, and each
    orch.json alone (read_orchs, either shape): a file that cannot be read or parsed names no pane and drops no other
    file's candidate. No candidate: the pane is no orch, and the hook treats it as any other pane. The hook reads
    this once, as its snapshot. A pane is the orch of at most one theme in a project, so of one candidate in each."""
    pane = text_or_none(env.get("HERDR_PANE_ID"))
    if not pane:
        return None, []
    found = []
    for p in sorted((fleet_home() / PROJECTS_DIR).glob(f"*/{ORCH_FILE}")):
        try:
            found += [(p.parent, name, rec) for name, rec in sorted(read_orchs(p.parent).items())
                      if rec.get("pane") == pane][:1]
        except Exception:
            continue
    return pane, found


def orch_decide(data: dict, cands: list[tuple[Path, str, dict]], run: HookRun) -> tuple[str, object]:
    """The outcome for a pane that the orch candidates `cands` name (the hook's one snapshot), as a value:
    (REBRIEF, candidate): the session match (F9): the input's session_id is not empty and exactly one candidate's
        record holds it (a consuming digest and a claim record it). No git: compaction and resume keep the
        session, and the match also works from another project's checkout. Else the directory rule: git gives the
        identity of the session's directory (top and remotes), and find_project's key rule (pick_project) picks a
        candidate's project;
    (ORDINARY, None): git gives the identity, the rule picks no candidate, and the project.json of every candidate
        was read and has keys: the pane is not this project's orch;
    (NOTE, cause): anything else. That is every failure of git (exit code 128 for any reason, "no repository" too:
        `orch claim` needs a checkout, so a registered pane without one has usually lost it), a timeout, no time
        left, a candidate's project.json that cannot be read or has no keys, and an exception of any type.
    The directory rule runs git (two calls, within the deadline of `run`) and reads each project.json once."""
    try:
        session = text_or_none(data.get("session_id"))
        matched = [c for c in cands if session and c[2].get("session") == session]
        if len(matched) == 1:
            return REBRIEF, matched[0]
        cwd = text_or_none(data.get("cwd")) or os.getcwd()
        if not os.path.isdir(cwd):
            return NOTE, HOOK_NO_REPOSITORY
        keys = run.identity(cwd)["keys"]
        projects = [(d, read_json(d / PROJECT_FILE)) for d in project_dirs()]
        picked = pick_project(keys, projects)
        if picked is not None:
            for c in cands:
                if os.path.realpath(c[0]) == os.path.realpath(picked[0]):
                    return REBRIEF, c
        known = {os.path.realpath(d): project_keys(d_data) for d, d_data in projects}
        unread = [c[0].name for c in cands if not known.get(os.path.realpath(c[0]))]
        if unread:
            return NOTE, f"the project file of {', '.join(unread)} could not be read"
        return ORDINARY, None
    except HookGitFailed as e:
        return NOTE, e.cause
    except Exception as e:
        return NOTE, f"an error in the hook: {type(e).__name__}"


def orch_context(data: dict, env, run: HookRun, pane: str,
                 cands: list[tuple[Path, str, dict]]) -> tuple[str, str | None]:
    """(outcome, text) for a pane that the orch candidates `cands` name: the re-brief, the ordinary path's text (it
    may be None) or the note. A re-brief that fails or is empty gives the note."""
    kind, value = orch_decide(data, cands, run)
    if kind == REBRIEF:
        try:
            text = orch_rebrief(value, pane, data, env)
            if text:
                return REBRIEF, text
            cause = "its re-brief failed: it is empty"
        except Exception as e:
            cause = f"its re-brief failed: {type(e).__name__}"
        return NOTE, orch_note([value], pane, cause, env)
    if kind == ORDINARY:
        try:
            return ORDINARY, lane_context(data, env, run)
        except Exception as e:
            return NOTE, orch_note(cands, pane, f"an error in the hook: {type(e).__name__}", env)
    return NOTE, orch_note(cands, pane, value, env)


def orch_note(cands: list[tuple[Path, str, dict]], pane: str, cause: str, env) -> str:
    """orch_unconfirmed_note; when that fails, a fixed text that calls no helper function."""
    try:
        return orch_unconfirmed_note(cands, pane, cause, env)
    except Exception:
        return orch_fixed_note(cands, pane, cause)


def orch_fixed_note(cands: list[tuple[Path, str, dict]], pane: str, cause: str) -> str:
    """The note when orch_unconfirmed_note cannot be built: the pane, each candidate as <project>/<orch>, the cause
    and the digest command. It calls no helper function."""
    return (f"Fleet orchestrator: this pane ({pane}) is registered as orch "
            f"{', '.join(f'{c[0].name}/{c[1]}' for c in cands)}, but this hook could not confirm that this session "
            f"works in that project ({cause}), so it gives no re-brief. If you orchestrate it, run the fleet "
            f"helper's `digest` command first, then read the project's PROJECT.md.")


def orch_unconfirmed_note(cands: list[tuple[Path, str, dict]], pane: str, cause: str, env) -> str:
    """The note for a pane that orch candidates name, when the hook cannot give it the re-brief: what is known, why
    not, and how to get the re-brief by hand. Never the lane or FLEET.md text: the pane may be the orch."""
    if len(cands) == 1:
        which = f"orch {cands[0][1]} of project {cands[0][0].name}"
    else:
        which = f"an orch of one of the projects {', '.join(f'{c[0].name}/{c[1]}' for c in cands)}"
    digest = f"{helper_command(env)} digest --project {cands[0][0].name if len(cands) == 1 else 'NAME'}"
    files = [str(c[0] / PROJECT_MD) for c in cands]
    if len(cands) == 1 and orch_files(cands[0][0], cands[0][1])["orch_md"]:
        files.append(str(orch_files(cands[0][0], cands[0][1])["orch_md"]))
    return (f"Fleet orchestrator: this pane ({pane}) is registered as {which}, but this hook could not confirm that "
            f"this session works in that project ({cause}), so it gives no re-brief. If you orchestrate it, run "
            f"`{digest}` first, then read {', '.join(files)} and load the fleet:fleet skill.")


def cached_board(path: Path) -> list[dict]:
    """The lane records of a saved board.json; a damaged file holds none."""
    board = read_json(path)
    return [r for r in board.get("lanes") if isinstance(r, dict)] if isinstance(board.get("lanes"), list) else []


def cached_view(home: Path, name: str | None, orchs: dict[str, dict], is2: bool) -> dict | None:
    """The view of orch `name` for the re-brief's event count, from files only: the lanes and branches of every
    orch's cached board, with the owner that each record names, and the former names of the registry (an event of
    a renamed orch, or an adopt from it, goes to the orch that has the name now, as in a digest). None (every
    event) for a project with one orch."""
    if len(orchs) < 2 or not name:
        return None
    lanes: dict[str, str | None] = {}
    branches: dict[str, str | None] = {}
    for n in sorted(orchs, key=lambda n: n != name):  # the orch's own board first
        for r in cached_board(orch_files(home, n, is2)["board"]):
            if "orch" not in r or not isinstance(r.get("path"), str):
                continue  # a record of 0.8.x names no owner
            owner = text_or_none(r.get("orch"))
            lanes.setdefault(os.path.realpath(r["path"]), owner)
            if text_or_none(r.get("branch")):
                branches.setdefault(r["branch"], owner)
    return {"name": name, "lanes": lanes, "branches": branches, "aliases": orch_aliases(orchs)}


def orch_rebrief(cand: tuple[Path, str, dict], pane: str, data: dict, env) -> str:
    """The re-brief for the registered orch pane of candidate `cand` (home, orch name, record), from the project home
    and the orch's own files (orch_files). Reads files only, and at most REBRIEF_READ_BUDGET bytes of unread log:
    never the history that a digest consumed."""
    home, name, _ = cand
    source = data.get("source")
    what = {"clear": "Your context was just cleared.", "compact": "Your context was just compacted.",
            "resume": "This session was resumed.", "startup": "This session just started."}.get(source, "")
    project_md = home / PROJECT_MD
    text = read_text(project_md)
    orchs, is2 = orch_registry(home)
    files = orch_files(home, name, is2)
    orch_md = files["orch_md"] if files["orch_md"] and files["orch_md"].is_file() else None
    memory = (f"Your memory is the project home {home}. Rules, follow-ups and project-wide decisions go to "
              f"{project_md}; the decisions and notes of your theme go to {orch_md}; the board and the event log "
              "keep the lanes." if orch_md else
              f"Your memory is the project home {home}. Decisions, follow-ups and rules go to {project_md}; "
              "the board and the event log keep the lanes.")
    head = [f"Fleet orchestrator: you orchestrate project {home.name} as orch {name} (pane {pane}). {what}".rstrip(),
            memory]
    body: list[str] = []
    sections = [("Rules", "Rules", text, "PROJECT.md", 15), ("Follow-ups", r"Follow-?ups?", text, "PROJECT.md", 15)]
    if orch_md:
        sections.append(("Notes", "Notes", read_text(orch_md), "ORCH.md", 10))
    for title, pattern, source_text, where, cap in sections:
        lines = section_text(source_text, pattern)
        body.append(f"## {title} ({where})")
        body += lines[:cap] or ["- none"]
        if len(lines) > cap:
            body.append(f"- ... {len(lines) - cap} more in {where}")
    records = cached_board(files["board"])
    board = read_json(files["board"])
    if board.get("made"):
        body.append(f"Board from {age_text(time.time() - event_time({'ts': board['made']}))} ago "
                    "(cached; `board` refreshes it):")
        body += ["  " + line for line in board_lines(records, owners=len(orchs) > 1)[:16]]
    else:
        body.append("No board yet.")
    cursor, _, read = digest_base(files["digest"])
    if cursor is None:
        tail = ["No digest yet."]
    else:
        events, _, cut = read_new_events(home, read, REBRIEF_READ_BUDGET)
        paths = [r["path"] for r in records if isinstance(r.get("path"), str)]
        count = len(digest_events(events, pane, paths, cached_view(home, name, orchs, is2)))
        tail = [("More than " if cut else "") + f"{plural(count, 'event')} since the last digest."]
    tail.append(f"Run `{helper_command(env)} digest --project {home.name}` first, then load the fleet:fleet skill.")
    room = REBRIEF_LINES_MAX - len(head) - len(tail)
    if len(body) > room:
        body = body[:room - 1] + ["... (cut; read PROJECT.md and run `board`)"]
    return "\n".join(head + body + tail)


# --------------------------------------------------------------------------
# prep


def prep_dir(path: str) -> dict:
    top = git_toplevel(path)
    base = Path(top or path)
    fleet_dir = base / FLEET_DIR
    fleet_dir.mkdir(parents=True, exist_ok=True)
    excluded = False
    exclude_file = None
    if top:
        cp = run(["git", "-C", top, "rev-parse", "--git-common-dir"], timeout=5)
        common = cp.stdout.strip()
        if cp.returncode == 0 and common:
            common_path = Path(common) if os.path.isabs(common) else Path(top) / common
            exclude = common_path / "info" / "exclude"
            exclude.parent.mkdir(parents=True, exist_ok=True)
            existing = exclude.read_text() if exclude.exists() else ""
            entry = f"/{FLEET_DIR}/"
            if entry not in existing.splitlines():
                with exclude.open("a") as fh:
                    if existing and not existing.endswith("\n"):
                        fh.write("\n")
                    fh.write(f"# fleet plugin lane files\n{entry}\n")
            excluded = True
            exclude_file = str(exclude)
    return {"fleet_dir": str(fleet_dir), "git_toplevel": top, "excluded": excluded, "exclude_file": exclude_file}


def handoff_path(fleet_dir: Path) -> Path:
    """Where a handoff goes: HANDOFF.md in a lane worktree, else a new file under handoffs/.

    Outside a lane, .fleet/HANDOFF.md would make the SessionStart hook brief
    every other session in that checkout as a lane.
    """
    fleet_dir = Path(fleet_dir)
    if (fleet_dir / "BRIEF.md").is_file():
        return fleet_dir / "HANDOFF.md"
    d = fleet_dir / "handoffs"
    d.mkdir(parents=True, exist_ok=True)
    return d / f"{time.strftime('%Y%m%d-%H%M%S')}.md"


def cmd_prep(args: argparse.Namespace) -> int:
    out = prep_dir(os.path.abspath(os.path.expanduser(args.dir or os.getcwd())))
    fleet_dir = Path(out["fleet_dir"])
    out["lane"] = (fleet_dir / "BRIEF.md").is_file()
    out["fleet_md"] = str(fleet_dir / ORCHESTRATOR_FILE) if (fleet_dir / ORCHESTRATOR_FILE).is_file() else None
    out["pane_role"] = (load_panes(fleet_dir).get(os.environ.get("HERDR_PANE_ID") or "") or {}).get("role")
    if args.handoff:
        out["handoff_path"] = str(handoff_path(fleet_dir))
        record("handoff", str(fleet_dir.parent), path=out["handoff_path"], role=out["pane_role"],
               lane=str(fleet_dir.parent) if out["lane"] else None, cwd=str(fleet_dir.parent),
               branch=git_branch(str(fleet_dir.parent)) or None, workspace=os.environ.get("HERDR_WORKSPACE_ID"))
    print(json.dumps(out, indent=2, ensure_ascii=False))
    return 0


# --------------------------------------------------------------------------
# watch


def cmd_watch(args: argparse.Namespace) -> int:
    """Block until a marker shows in a lane file, or the agent stops, blocks or exits.

    Exit codes: 0 marker found, 4 blocked on a dialog, 5 agent exited or pane
    gone, 6 stopped without the marker, 7 timeout.
    """
    require_herdr()
    pane = args.pane
    info = pane_info(pane)
    top = git_toplevel(info.get("cwd") or "") or info.get("cwd") or os.getcwd()
    path = pattern = None
    if args.marker:
        f = Path(args.file or f"{FLEET_DIR}/STATUS.md").expanduser()
        path = f if f.is_absolute() else Path(top) / f
        pattern = re.compile(marker_line(re.escape(args.marker)), re.M)
    start = time.time()
    stopped_since: float | None = None
    blocked_since: float | None = None

    def emit(event: str, code: int, **extra) -> int:
        out = {"event": event, "pane_id": pane, "elapsed_s": int(time.time() - start), **extra}
        if path is not None:
            out.setdefault("file", str(path))
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return code

    while True:
        if path is not None and path.is_file():
            text = path.read_text(errors="replace")
            if pattern.search(text):
                return emit("marker", 0, marker=args.marker, placeholders=text.count("PLACEHOLDER"))
        try:
            info = pane_info(pane)
        except FleetError:
            return emit("pane-gone", 5)
        status = info.get("agent_status")
        if not info.get("agent"):
            return emit("agent-exited", 5, screen=screen_tail(pane))
        now = time.time()
        blocked_since = (blocked_since or now) if status == "blocked" else None
        if blocked_since and now - blocked_since >= args.blocked_grace:
            return emit("blocked", 4, status=status, screen=screen_tail(pane))
        stopped_since = (stopped_since or now) if status in ("idle", "done") else None
        if stopped_since and now - stopped_since >= args.idle_grace:
            return emit("stopped", 6, status=status, screen=screen_tail(pane))
        if args.timeout and now - start >= args.timeout:
            return emit("timeout", 7, status=status)
        time.sleep(args.interval)


# --------------------------------------------------------------------------
# doctor / accounts


def conventions_path() -> Path:
    override = os.environ.get("FLEET_CONVENTIONS")
    if override:
        return Path(override).expanduser()
    base = os.environ.get("XDG_CONFIG_HOME") or "~/.config"
    return Path(base).expanduser() / "fleet" / "conventions.md"


TOML_STRING_KEY = re.compile(r"""^\s*([A-Za-z0-9_-]+)\s*=\s*(?:"([^"]*)"|'([^']*)')\s*(?:#.*)?$""")
HOOK_STATUS_LINE = re.compile(r"^(claude|codex):\s*(.+?)\s*\((/[^()]*)\)\s*$")


def toml_top_level(text: str) -> dict:
    """String keys of a TOML file that sit above its first [table] header."""
    keys: dict = {}
    for line in (text or "").splitlines():
        if line.lstrip().startswith("["):
            break
        m = TOML_STRING_KEY.match(line)
        if m:
            keys[m.group(1)] = m.group(2) if m.group(2) is not None else m.group(3)
    return keys


def agent_defaults(agent: str, home: str) -> dict:
    """The model and effort that an agent's config dir sets (None where it sets none)."""
    base = Path(os.path.expanduser(home))
    try:
        if agent == "claude":
            data = json.loads((base / "settings.json").read_text())
            return {"model": data.get("model"), "effort": data.get("effortLevel")}
        keys = toml_top_level((base / "config.toml").read_text(errors="replace"))
        return {"model": keys.get("model"), "effort": keys.get("model_reasoning_effort")}
    except (OSError, ValueError, AttributeError):
        return {"model": None, "effort": None}


def codex_models(home: str) -> list[dict]:
    """The models that Codex lists, with their effort levels, from its models cache."""
    try:
        data = json.loads((Path(os.path.expanduser(home)) / "models_cache.json").read_text())
    except (OSError, ValueError):
        return []
    rows = data.get("models") if isinstance(data, dict) else data
    models = []
    for m in rows if isinstance(rows, list) else []:
        if not isinstance(m, dict) or m.get("visibility", "list") != "list":
            continue
        slug = m.get("slug") or m.get("id")
        levels = [x.get("effort") if isinstance(x, dict) else x for x in m.get("supported_reasoning_levels") or []]
        if slug:
            models.append({"model": slug, "efforts": [x for x in levels if isinstance(x, str)],
                           "default_effort": m.get("default_reasoning_level")})
    return models


def config_env(agent: str, home: str | None, env: dict) -> dict:
    """`env` with the agent's config-dir variable set to `home` (unset for "default")."""
    out = dict(env)
    var = HOME_VAR[agent]
    if not home or home == "default":
        out.pop(var, None)
    else:
        out[var] = os.path.expanduser(home)
    return out


def parse_integration_status(text: str) -> dict:
    """The claude and codex lines of `herdr integration status`, as {agent: {"status", "path"}}."""
    found = {}
    for line in (text or "").splitlines():
        m = HOOK_STATUS_LINE.match(line.strip())
        if m:
            found[m.group(1)] = {"status": m.group(2), "path": m.group(3)}
    return found


def codex_hook_trusted(home: str) -> bool | None:
    """Whether Codex runs Herdr's SessionStart hook in this home (None: no such hook found).

    Codex runs a hook from hooks.json only after the user trusts it once; the trust
    is a `[hooks.state."<hooks.json>:session_start:<group>:<index>"]` table in config.toml.
    """
    base = Path(os.path.expanduser(home))
    hooks_file = base / "hooks.json"
    try:
        groups = (json.loads(hooks_file.read_text()).get("hooks") or {}).get("SessionStart") or []
        config = (base / "config.toml").read_text(errors="replace")
    except (OSError, ValueError, AttributeError):
        return None
    for i, group in enumerate(groups if isinstance(groups, list) else []):
        for j, hook in enumerate((group or {}).get("hooks") or []):
            if "herdr-agent-state" not in str((hook or {}).get("command", "")):
                continue
            parts = config.split(f'[hooks.state."{hooks_file}:session_start:{i}:{j}"]', 1)
            if len(parts) < 2:
                return False
            table = parts[1].split("\n[", 1)[0]
            return "trusted_hash" in table and not re.search(r"^\s*enabled\s*=\s*false", table, re.M)
    return None


def hook_install_command(agent: str, home: str | None) -> str:
    command = f"herdr integration install {agent}"
    if home and home != "default":
        return f"{HOME_VAR[agent]}={shlex.quote(os.path.expanduser(home))} {command}"
    return command


def hook_report(herdr_bin: str, homes: list[dict], env: dict) -> list[dict]:
    """Herdr's agent state hook in each config dir that a lane can run with.

    Each remuda account has its own config dir, and the hook must be installed in
    each one: `herdr integration status` checks only the dir that its environment names.
    """
    report = []
    for h in homes:
        try:
            cp = run([herdr_bin, "integration", "status"], timeout=15, env=config_env(h["agent"], h["home"], env))
            found = parse_integration_status(cp.stdout).get(h["agent"]) or {}
        except FleetError:
            found = {}
        status = found.get("status")
        ok = bool(status and status.startswith("current"))
        fix = None if ok else hook_install_command(h["agent"], h["home"])
        if ok and h["agent"] == "codex" and codex_hook_trusted(account_home("codex", {"home": h["home"]})) is False:
            ok = False
            status = f"{status}, not trusted by Codex"
            fix = "start Codex on this account and trust the Herdr hook in its hooks review (t: trust all)"
        report.append({**h, "status": status, "path": found.get("path"), "ok": ok, "fix": fix})
    return report


def cmd_doctor(args: argparse.Namespace) -> int:
    herdr_bin = shutil.which("herdr")
    remuda = remuda_path()
    env = dict(os.environ)
    accounts: list[dict] = []
    remuda_error = None
    if remuda:
        try:
            accounts = remuda_accounts(remuda)
        except FleetError as e:
            remuda_error = str(e)
    accounts = [{**a, **agent_defaults(a["provider"], account_home(a["provider"], a))} if a["provider"] in AGENTS else a
                for a in accounts]
    installed = {agent: shutil.which(agent) for agent in AGENTS}
    claude_home = env.get("CLAUDE_CONFIG_DIR") or DEFAULT_HOME["claude"]
    codex_home = env.get("CODEX_HOME") or DEFAULT_HOME["codex"]
    if accounts:
        homes = [{"agent": a["provider"], "account": a["account"], "home": a["home"]}
                 for a in accounts if a["provider"] in AGENTS]
    else:
        homes = [{"agent": agent, "account": None, "home": env.get(HOME_VAR[agent]) or "default"}
                 for agent in AGENTS if installed[agent]]
    conv = conventions_path()
    report = {
        "fleet": VERSION,
        "python": sys.version.split()[0],
        "mode": "remuda" if remuda else "plain",
        "herdr": {"path": herdr_bin, "version": tool_version(herdr_bin), "inside_herdr": env.get("HERDR_ENV") == "1",
                  "pane": env.get("HERDR_PANE_ID")},
        "remuda": {"path": remuda, "version": tool_version(remuda), "accounts": accounts, "error": remuda_error,
                   "disabled_by_env": env.get("FLEET_NO_REMUDA") == "1"},
        "claude": {"path": installed["claude"], "version": tool_version(installed["claude"]),
                   "config_dir": env.get("CLAUDE_CONFIG_DIR"), **agent_defaults("claude", claude_home)},
        "codex": {"path": installed["codex"], "version": tool_version(installed["codex"]), "home": env.get("CODEX_HOME"),
                  **agent_defaults("codex", codex_home),
                  "models": codex_models(codex_home) if installed["codex"] else []},
        "hooks": hook_report(herdr_bin, homes, env) if herdr_bin else [],
        "git": shutil.which("git"),
        "conventions": {"path": str(conv), "exists": conv.is_file()},
        "home": {"path": str(fleet_home()), "projects": [p.name for p in project_dirs()]},
    }
    if args.json:
        print(json.dumps(report, indent=2, ensure_ascii=False))
        return 0
    def show(label: str, value: str) -> None:
        print(f"{label:<12} {value}")
    def settings(row: dict) -> str:
        parts = [f"{key} {row[key]}" for key in ("model", "effort") if row.get(key)]
        return ("  " + ", ".join(parts)) if parts else ""
    show("fleet", VERSION)
    show("mode", "remuda (account switching on)" if remuda else "plain (no remuda: one login per agent, no account switching)")
    show("herdr", f"{report['herdr']['version'] or 'missing'}" + ("" if report["herdr"]["inside_herdr"] else "  (this shell is not inside Herdr)"))
    if remuda:
        show("remuda", f"{report['remuda']['version']}  {len(accounts)} accounts" + (f"  error: {remuda_error}" if remuda_error else ""))
        for a in accounts:
            show("", f"{a['account']:<16} {a['plan'] or '-':<6} {a['home']}{settings(a)}")
    elif report["remuda"]["disabled_by_env"]:
        show("remuda", "disabled by FLEET_NO_REMUDA=1")
    else:
        show("remuda", "not installed (optional)")
    show("claude", (report["claude"]["version"] or "missing") + settings(report["claude"]))
    show("codex", (report["codex"]["version"] or "missing") + settings(report["codex"]))
    for i, h in enumerate(report["hooks"]):
        who = h["account"] or f"{h['agent']} ({h['home']})"
        state = h["status"] or "unknown"
        show("herdr hooks" if i == 0 else "", f"{who:<16} {state}" + ("" if h["ok"] else f"  fix: {h['fix']}"))
    show("conventions", f"{conv}" + ("" if conv.is_file() else "  (missing: run /fleet:onboard)"))
    projects = report["home"]["projects"]
    show("home", short_path(str(fleet_home())) + (f"  projects: {', '.join(projects)}" if projects else
                                                  "  (no project yet: the first lane event creates one)"))
    return 0


def cmd_conventions(args: argparse.Namespace) -> int:
    path = conventions_path()
    if args.path:
        print(path)
        return 0
    remuda = remuda_path()
    if remuda:
        print("mode: remuda (account switching on)")
    else:
        print("mode: plain (no remuda: every lane uses the agent's own login; ignore any account rules below)")
    print(f"conventions file: {path}")
    if path.is_file():
        print("source: the user's file\n")
        text = path.read_text(errors="replace")
    else:
        print("source: plugin defaults (no user file yet: suggest /fleet:onboard)\n")
        text = (PLUGIN_ROOT / "defaults" / "conventions.md").read_text()
    sys.stdout.write(text if text.endswith("\n") else text + "\n")
    return 0


def cmd_accounts(args: argparse.Namespace) -> int:
    remuda = remuda_path()
    if not remuda:
        print("plain mode: remuda is not installed (or FLEET_NO_REMUDA=1).")
        print("Every lane uses the agent's own login. There is no account switching.")
        return 0
    for cmd in ([remuda, "list"], [remuda, "usage", *(["--live"] if args.live else [])]):
        cp = run(cmd, timeout=60)
        sys.stdout.write(cp.stdout)
        if cp.returncode != 0:
            sys.stderr.write(cp.stderr)
            return cp.returncode
        print()
    return 0


# --------------------------------------------------------------------------
# high-risk paths: the patterns of a project, and the paths that match them


def glob_regex(pattern: str) -> re.Pattern:
    """A regex for a path pattern, matched against a path relative to the git top. `*` and `?` stay inside one
    directory, `**` crosses directories, `[...]` is a character class (`[!...]` negates). A pattern without `/`
    (a trailing `/` aside) matches at any depth; a pattern that ends in `/` means `<pattern>**`; a pattern also
    matches everything under the directory it names. Case-sensitive. Raises re.error on a bad pattern."""
    p = pattern.strip()
    while p.startswith("./"):
        p = p[2:]
    if not p.strip("/"):
        raise re.error("an empty pattern")
    anchored = "/" in p.rstrip("/")
    p = p.lstrip("/")
    if p.endswith("/"):
        p += "**"
    if not anchored:
        p = "**/" + p
    out: list[str] = []
    i, n = 0, len(p)
    while i < n:
        c = p[i]
        if p.startswith("**", i):
            j = i + 2
            after_slash = i == 0 or p[i - 1] == "/"
            if after_slash and p.startswith("/", j):  # `**/`: no directory or any number of them
                out.append("(?:.*/)?")
                i = j + 1
            elif after_slash and j == n and out and out[-1] == "/":  # a final `/**`: the directory and all in it
                out[-1] = "(?:/.*)?"
                i = j
            else:
                out.append(".*")
                i = j
            continue
        if c == "*":
            out.append("[^/]*")
        elif c == "?":
            out.append("[^/]")
        elif c == "[":
            j = i + 1
            if j < n and p[j] in "!^":
                j += 1
            if j < n and p[j] == "]":
                j += 1
            while j < n and p[j] != "]":
                j += 1
            if j >= n:  # no closing bracket: a plain `[`
                out.append(re.escape(c))
                i += 1
                continue
            body = p[i + 1:j]
            negate = body[:1] in ("!", "^")
            body = body[1:] if negate else body
            for ch in "\\[&~|":
                body = body.replace(ch, "\\" + ch)
            out.append("(?!/)[" + ("^" if negate else "") + body + "]")
            i = j + 1
            continue
        else:
            out.append(re.escape(c))
        i += 1
    return re.compile("(?:" + "".join(out) + r")(?:/.*)?\Z", re.S)


def risk_patterns(home: Path | None) -> tuple[list[dict], str | None]:
    """(the high-risk path patterns of the project at `home`, why they cannot be read). The built-ins always
    apply; PROJECT.md adds the lines of its `## High-risk paths` section, `- <category>: <pattern>`. No home, no
    PROJECT.md or no section: the built-ins only. A line of another form, an unknown category, a pattern that
    does not compile or a PROJECT.md that cannot be read is an error: the caller fails closed."""
    patterns = [{"category": c, "pattern": g, "source": "builtin", "regex": glob_regex(g)}
                for c, g in BUILTIN_RISK_PATTERNS]
    if home is None:
        return patterns, None
    path = Path(home) / PROJECT_MD
    if not path.exists():
        return patterns, None
    try:
        text = path.read_text(errors="replace")
    except OSError as e:
        return patterns, f"{path} cannot be read: {e.strerror or e}"
    for line in section_text(text, re.escape(RISK_SECTION)):
        m = RISK_PATTERN_LINE.match(line.strip())
        category = m.group(1).lower() if m else None
        glob_text = m.group(2).strip("`").strip() if m else ""
        if category not in RISK_CATEGORIES or not glob_text:
            return patterns, (f"{PROJECT_MD}, ## {RISK_SECTION}: {line.strip()!r} is not "
                              f"'- <category>: <pattern>' with a category of {', '.join(RISK_CATEGORIES)}")
        try:
            regex = glob_regex(glob_text)
        except re.error as e:
            return patterns, f"{PROJECT_MD}, ## {RISK_SECTION}: the pattern {glob_text!r} is not valid: {e}"
        patterns.append({"category": category, "pattern": glob_text, "source": PROJECT_MD, "regex": regex})
    return patterns, None


def match_risk(paths: list[str], patterns: list[dict]) -> list[dict]:
    """One `{path, category, pattern, source}` per path that a pattern matches, in the order of the paths; the
    first pattern that matches a path wins."""
    found = []
    for path in paths:
        for pat in patterns:
            if pat["regex"].match(path):
                found.append({"path": path, "category": pat["category"], "pattern": pat["pattern"],
                              "source": pat["source"]})
                break
    return found


# --------------------------------------------------------------------------
# approve-plan: the gate between a planner and the implementer


def git_text(path: str, *args: str, timeout: float = 15, errors: str = "replace",
             options: tuple[str, ...] = ()) -> str | None:
    """stdout of a git command run in `path`, decoded with replacement (a path need not be UTF-8); None when git
    fails or cannot run. errors="surrogateescape" keeps a name that goes back to git as an argument exact.
    `options`: global options that go before the command (SCAN_OPTIONS), so `args` always starts with it."""
    try:
        cp = subprocess.run(["git", "-C", path, *options, *args], capture_output=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return cp.stdout.decode("utf-8", errors=errors) if cp.returncode == 0 else None


def status_entries(path: str, untracked: str, scan: bool = False) -> list[list[str]] | None:
    """The entries of `git status` in the checkout at `path`, one list of paths each: `[<to>, <from>]` for a rename
    or copy, `[<path>]` otherwise. Untracked files show in the mode `untracked` (`all`: each file; `normal`: an
    untracked directory as one entry), and each submodule change shows, whatever the user's git settings say.
    -z never quotes a path. With `scan`, git also scans the worktree whatever the file system monitor and the
    untracked cache say (SCAN_OPTIONS). None when git fails."""
    out = git_text(path, "status", "--porcelain", "-z", f"--untracked-files={untracked}", "--ignore-submodules=none",
                   options=SCAN_OPTIONS if scan else ())
    if out is None:
        return None
    fields = out.split("\0")
    entries: list[list[str]] = []
    i = 0
    while i < len(fields):
        entry = fields[i]
        i += 1
        if len(entry) < 4:
            continue
        paths = [entry[3:]]
        if "R" in entry[:2] or "C" in entry[:2]:  # `XY <to>`, then `<from>` as the next field
            if i < len(fields) and fields[i]:
                paths.append(fields[i])
            i += 1
        entries.append(paths)
    return entries


def status_paths(path: str) -> list[str] | None:
    """Every path that `git status` reports in the checkout at `path`, both sides of a rename or copy, with each
    untracked file listed, whatever the file system monitor and the untracked cache say (`status_entries` at
    `all` with `scan`, flattened). Paths that the index marks assume-unchanged or skip-worktree are not among
    them: git status does not look at those (`flagged_count`). None when git fails."""
    entries = status_entries(path, "all", scan=True)
    return None if entries is None else [p for paths in entries for p in paths]


def outside_fleet(paths: list[str]) -> list[str]:
    """The paths that are not in the lane's .fleet/."""
    return [p for p in paths if not (p == FLEET_DIR or p.startswith(FLEET_DIR + "/"))]


def lane_revs(path: str, base: str | None = None) -> tuple[list[str] | None, str | None]:
    """(the `git log` revision arguments for the commits that only this lane holds; why they cannot be told).

    With `base`: `<base>..HEAD`. Without it: HEAD minus every other local branch, every remote branch other than
    `<remote>/<branch>` and every tag. That needs no stored state: a fresh lane has no commit of its own, and a
    lane on a local feature branch neither. It needs a branch: a detached HEAD needs `base`."""
    if base is not None:
        sha = None if base.startswith("-") else git_text(path, "rev-parse", "--verify", "--quiet", f"{base}^{{commit}}")
        if not sha or not sha.strip():
            return None, f"--base {base} does not name a commit"
        revs = [f"{sha.strip()}..HEAD"]
    else:
        # The full ref: `--short` can say `heads/<branch>` (a tag of the same name), and strip() would cut
        # whitespace that a branch name can end with. Only the prefix and the line end go.
        ref = git_text(path, "symbolic-ref", "--quiet", "HEAD", errors="surrogateescape")
        ref = ref[:-1] if ref and ref.endswith("\n") else ref
        if not ref or not ref.startswith("refs/heads/") or len(ref) == len("refs/heads/"):
            return None, "HEAD is detached, so the lane's own commits cannot be told; pass --base <ref>"
        branch = ref[len("refs/heads/"):]
        remotes = git_text(path, "remote", errors="surrogateescape")
        if remotes is None:
            return None, "git remote failed, so the lane's own commits cannot be told"
        # Each --exclude applies to the next --branches or --remotes only. A glob such as */<branch> would also
        # match <remote>/team/<branch>, so each remote gets its own exact exclusion.
        revs = ["HEAD", "--not", f"--exclude={branch}", "--branches",
                *[f"--exclude={r}/{branch}" for r in remotes.split("\n") if r], "--remotes", "--tags"]
    return revs, None


def lane_commits(path: str, base: str | None = None) -> tuple[list[str] | None, str | None]:
    """(the commits that only this lane holds, newest first, as `<short sha> <subject>`; why they cannot be told).
    `lane_revs` says which commits those are."""
    revs, why = lane_revs(path, base)
    if revs is None:
        return None, why
    out = git_text(path, "log", "--format=%h %s", *revs, "--")
    if out is None:
        return None, "git log failed, so the lane's own commits cannot be told"
    return out.splitlines(), None


def lane_changed_paths(path: str, base: str | None = None) -> tuple[list[str] | None, str | None]:
    """(every path that the lane changed, sorted; why that cannot be told): the paths that the lane's own commits
    touched (the commits of `lane_revs`, both sides of a rename) and the paths of `git status` (`status_paths`,
    which scans whatever the file system monitor and the untracked cache say), outside .fleet/.

    No check of the paths that the index marks assume-unchanged or skip-worktree, unlike approve-plan: the risk
    gate gates what the lane commits, and `git log` reads commits without the index.

    A merge commit lists nothing, so a merge from the default branch brings none of its files. Known gaps: an
    edit made while resolving a conflict inside a merge commit is not listed; with `base`, a lane that merged
    (not rebased) the default branch lists that branch's files too."""
    revs, why = lane_revs(path, base)
    if revs is None:
        return None, why.replace("own commits", "changes")
    out = git_text(path, "log", "--format=", "--name-only", "-z", "--no-renames", "--no-show-signature",
                   "--ignore-submodules=none", "--root", *revs, "--")
    if out is None:
        return None, "git log failed, so the lane's changes cannot be told"
    status = status_paths(path)
    if status is None:
        return None, "git status failed, so the lane's changes cannot be told"
    return sorted(set(outside_fleet([p for p in out.split("\0") if p] + status))), None


def plan_rounds(text: str) -> tuple[list[int], set[int]]:
    """The rounds of a PLAN.md: those with a `PLAN READY: <n>` line, and those with a `PLAN APPROVED: <n>` line."""
    return ([int(n) for n in PLAN_READY_LINE.findall(text)], {int(n) for n in PLAN_APPROVED_LINE.findall(text)})


def plan_risk(text: str) -> tuple[str | None, bool]:
    """(the value of the `Risk:` lines, low risk). Low risk only when every `Risk:` line says exactly `none`; a
    missing line, the template's list of values, or an unknown or second value needs the user."""
    values = []
    for raw in RISK_LINE.findall(text):
        value = re.sub(r"[*_`]", "", raw).strip().rstrip(".").strip().lower()
        if value not in values:
            values.append(value)
    if not values:
        return None, False
    return ", ".join(values), values == ["none"]


LIST_MARK = re.compile(r"^\s*(?:[-*+]|\d+[.)])\s+")


def plan_files(text: str, every_line: bool = False) -> list[str]:
    """The paths under `## Files` in a PLAN.md, one per list item: the first token after the list mark, `**` and
    backticks, up to the first `:` or whitespace. An item that is `-`, `none` or a template `<...>` names no
    path. With `every_line`, the first token of a line that is no list item counts too (the high-risk match
    reads those, to fail closed); a marker line such as `PLAN READY: 1` never counts."""
    found: list[str] = []
    for line in section_lines(text, "Files", every=True):
        if PLAN_READY_LINE.search(line) or PLAN_APPROVED_LINE.search(line) or READY_LINE.search(line):
            continue
        item = LIST_MARK.match(line + " ")
        if not item and not every_line:
            continue
        token = (line + " ")[item.end():] if item else line
        token = token.replace("**", "").replace("`", "")
        token = re.split(r"[:\s]", token.strip(), maxsplit=1)[0]
        while token.startswith("./"):
            token = token[2:]
        if not token or token in ("-", "*", "+") or EMPTY_NOTE.match(token):
            continue
        if token not in found:
            found.append(token)
    return found


def plan_approver(text: str, n: int) -> str | None:
    """Who approved round n of a PLAN.md: `user` when every `PLAN APPROVED: <n>` line says `by user`, else `orch`
    (also for a line that names no one); None when no line approves round n."""
    who = [(by or "").lower() for m, by in PLAN_APPROVED_BY.findall(text) if int(m) == n]
    if not who:
        return None
    return "user" if all(w == "user" for w in who) else "orch"


def plan_categories(text: str, patterns: list[dict]) -> set[str]:
    """The high-risk categories that a PLAN.md shows: the values of its `Risk:` lines that are categories (a list
    split by commas or `and`; `none` adds nothing), and the categories that its `## Files` paths match."""
    found = set()
    for raw in RISK_LINE.findall(text):
        for value in re.split(r",|;|\band\b", re.sub(r"[*_`]", "", raw)):
            value = value.strip().rstrip(".").strip().lower()
            if value in RISK_CATEGORIES:
                found.add(value)
    found.update(m["category"] for m in match_risk(plan_files(text, every_line=True), patterns))
    return found


def high_risk_text(matches: list[dict], limit: int = 5) -> str:
    """`migration db/migrate/1.sql, auth-payments app/auth/x.py (+2)`."""
    text = ", ".join(f"{m['category']} {m['path']}" for m in matches[:limit])
    return text + (f" (+{len(matches) - limit})" if len(matches) > limit else "")


def cmd_approve_plan(args: argparse.Namespace) -> int:
    """Append `PLAN APPROVED: <n> by <who> <date>` to the lane's PLAN.md. It refuses, and writes nothing, unless
    round n is ready and not yet approved, the worktree has no change outside .fleet/ (`status_paths`, which
    scans whatever the file system monitor and the untracked cache say) and no path outside it that the index
    marks assume-unchanged or skip-worktree (`flagged_count`: git status does not look at those), the lane has
    no commit of its own, the project's high-risk patterns can be read, and either the user approves or the plan is low
    risk: `Risk: none`, at least one path under `## Files`, and no such path that a high-risk pattern matches.
    `--by user` overrides only the risk and the missing files."""
    start = os.path.abspath(os.path.expanduser(args.dir or os.getcwd()))
    top = git_toplevel(start) if os.path.isdir(start) else None
    if not top:
        return refuse(reason=f"{start} is not in a git worktree")
    plan = Path(top) / FLEET_DIR / PLAN_FILE
    out = {"plan": str(plan), "by": args.by}
    if not plan.is_file():
        return refuse(**out, reason=f"no {FLEET_DIR}/{PLAN_FILE} in {top}")
    text = read_text(plan)
    ready, approved = plan_rounds(text)
    if args.round is not None:
        if args.round not in ready:
            return refuse(**out, reason=f"{PLAN_FILE} has no PLAN READY: {args.round} line")
        n = args.round
    elif ready:
        n = max(ready)
    else:
        return refuse(**out, reason=f"{PLAN_FILE} has no PLAN READY line: the planner has not finished")
    out["round"] = n
    if n in approved:
        return refuse(**out, reason=f"round {n} of the plan is already approved")
    paths = status_paths(top)
    if paths is None:
        return refuse(**out, reason="git status failed, so the worktree cannot be checked")
    changed = outside_fleet(paths)
    if changed:
        return refuse(**out, reason=f"the worktree has {plural(len(changed), 'changed path')} outside {FLEET_DIR}/: "
                                    f"a planner changes no file except {PLAN_FILE}",
                      changes=len(changed), paths=changed[:5])
    flagged = flagged_count(top)
    if flagged is None:
        return refuse(**out, reason="git ls-files failed, so the worktree cannot be checked")
    if flagged:
        return refuse(**out, reason=f"the worktree has {flagged_reason(flagged)} outside {FLEET_DIR}/: git status "
                                    "does not look at them, so a change there cannot be seen. Clear the flags "
                                    "(git update-index --no-assume-unchanged / --no-skip-worktree)",
                      flagged=flagged)
    if args.base is not None:
        out["base"] = args.base
    commits, why = lane_commits(top, args.base)
    if commits is None:
        return refuse(**out, reason=why)
    if commits:
        return refuse(**out, reason=f"the lane has {plural(len(commits), 'commit')} of its own: a planner commits "
                                    "nothing. When a commit predates the plan, or no branch, remote or tag holds the "
                                    "lane's base, name the base with --base <ref>",
                      lane_commits=len(commits), commits=commits[:5])
    home, error = project_lookup(top)
    patterns, error = (risk_patterns(home) if not error else ([], error))
    if error:
        return refuse(**out, reason=f"the project's high-risk paths cannot be read ({error}); fix {PROJECT_MD} "
                                    "in the project home")
    risk, low = plan_risk(text)
    files = plan_files(text)
    high_risk = match_risk(plan_files(text, every_line=True), patterns)
    out.update(risk=risk, files=len(files), high_risk=high_risk)
    if args.by != "user":
        if high_risk:
            return refuse(**out, reason=f"{PLAN_FILE} names high-risk paths under ## Files "
                                        f"({high_risk_text(high_risk)}); only the user can approve. Ask the user, "
                                        "then pass --by user")
        if not low:
            why = "has no Risk: line" if risk is None else f"says Risk: {risk}"
            return refuse(**out, reason=f"{PLAN_FILE} {why}; only Risk: none can be approved by the orch. Ask the "
                                        "user, then pass --by user")
        if not files:
            return refuse(**out, reason=f"{PLAN_FILE} lists no files under ## Files: list them, or ask the user")
    line = f"PLAN APPROVED: {n} by {args.by} {now_iso()}"
    with plan.open("a") as fh:
        fh.write(("" if not text or text.endswith("\n") else "\n") + line + "\n")
    branch = git_branch(top) or None
    record("plan_approved", top, lane=top, cwd=top, branch=branch, workspace=os.environ.get("HERDR_WORKSPACE_ID"),
           round=n, approved_by=args.by, risk=risk, base=args.base, files=len(files),
           high_risk=[{"category": m["category"], "path": m["path"]} for m in high_risk])
    print(json.dumps({"ok": True, **out, "lane": top, "branch": branch, "line": line}, indent=2, ensure_ascii=False))
    return 0


# --------------------------------------------------------------------------
# risk: the lane's real changes against the high-risk patterns, and the user's yes for them

RISK_FILE = "RISK.md"
LOSSY_MARK = "\ufffd"  # what git_text puts for bytes that are not UTF-8: such a path is not told exactly
RISK_APPROVED_LINE = re.compile(marker_line(rf"RISK APPROVED: ({'|'.join(RISK_CATEGORIES)}) (.+?) by user (\S+)")
                                + r"[ \t]*$", re.M)


def risk_approvals(fleet_dir: Path) -> set[tuple[str, str]]:
    """The (category, path) pairs that the lane's .fleet/RISK.md approves, one `RISK APPROVED:` line each."""
    return {(c, p) for c, p, _ in RISK_APPROVED_LINE.findall(read_text(Path(fleet_dir) / RISK_FILE))}


def risk_state(top: str, home: Path | None, base: str | None = None, home_error: str | None = None) -> dict:
    """The lane's changed paths matched against the project's high-risk patterns, and who covers each match.

    A match is covered by the newest plan round when the user approved it and the plan shows the match's
    category (`plan_categories`), else by a `RISK APPROVED` line in RISK.md for the same category and path. The
    rest needs the user. A path that git's bytes do not decode to exactly (it holds U+FFFD) is never covered by
    a RISK.md line: two such paths can decode alike. `error` says why the changes or the patterns cannot be told
    (also `home_error`, a failed project lookup); the lane then needs the user as well (fail closed)."""
    d = Path(top) / FLEET_DIR
    out = {"lane": top, "base": base, "paths": None, "matches": [], "covered": [], "needs_user": [],
           "plan_round": None, "plan_approved_by": None, "plan_categories": [], "error": None}
    patterns, error = risk_patterns(home) if not home_error else ([], home_error)
    if error:
        out["error"] = f"the project's high-risk paths cannot be read ({error})"
        return out
    paths, why = lane_changed_paths(top, base)
    if paths is None:
        out["error"] = why
        return out
    out["paths"] = len(paths)
    text = read_text(d / PLAN_FILE) if (d / PLAN_FILE).is_file() else ""
    ready, _ = plan_rounds(text)
    if ready:
        out["plan_round"] = max(ready)
        out["plan_approved_by"] = plan_approver(text, max(ready))
    categories = plan_categories(text, patterns) if out["plan_approved_by"] == "user" else set()
    out["plan_categories"] = sorted(categories)
    approved = risk_approvals(d)
    for m in match_risk(paths, patterns):
        if m["category"] in categories:
            m["covered_by"] = f"plan round {out['plan_round']}, approved by the user"
        elif (m["category"], m["path"]) in approved and LOSSY_MARK not in m["path"]:
            m["covered_by"] = RISK_FILE
        else:
            m["covered_by"] = None
        out["matches"].append(m)
        (out["covered"] if m["covered_by"] else out["needs_user"]).append(m)
    return out


def needs_user(state: dict) -> bool:
    """True when the lane's changes need the user's yes before merge: a match nobody covers, or no answer."""
    return bool(state.get("needs_user") or state.get("error"))


def lane_top(args: argparse.Namespace) -> tuple[str, str | None]:
    """(the directory that DIR names, default the current one; its git top, or None)."""
    start = os.path.abspath(os.path.expanduser(args.dir or os.getcwd()))
    return start, git_toplevel(start) if os.path.isdir(start) else None


def risk_lines(state: dict) -> list[str]:
    """`fleet risk` as text: a line per high-risk match, then what to do."""
    branch = state.get("branch") or "detached HEAD"
    if state["error"]:
        return [f"lane {short_path(state['lane'])} ({branch}): the changes cannot be told: {state['error']}",
                "It needs the user before merge: show the user the diff and ask."]
    lines = [f"lane {short_path(state['lane'])} ({branch}): {plural(state['paths'], 'changed path')}, "
             f"{len(state['matches'])} high-risk"]
    rows = [[m["category"], m["path"], f"{m['source']} {m['pattern']}",
             f"covered by {m['covered_by']}" if m["covered_by"] else "needs the user"] for m in state["matches"]]
    widths = [max(len(r[i]) for r in rows) for i in range(3)] if rows else []
    lines += ["  " + "  ".join(r[i].ljust(widths[i]) for i in range(3)) + "  " + r[3] for r in rows]
    if state["needs_user"]:
        count = len(state["needs_user"])
        lines.append(f"{plural(count, 'path')} {'needs' if count == 1 else 'need'} the user: show the user the diff "
                     "and ask; after the yes, run approve-risk --by user")
    else:
        lines.append("Nothing needs the user.")
    return lines


def cmd_risk(args: argparse.Namespace) -> int:
    start, top = lane_top(args)
    if not top:
        raise FleetError(f"{start} is not in a git worktree")
    home, home_error = project_lookup(top)
    state = risk_state(top, home, args.base, home_error=home_error)
    state["branch"] = git_branch(top) or None
    if args.json:
        print(json.dumps({**state, "needs_the_user": needs_user(state)}, indent=2, ensure_ascii=False))
    else:
        print("\n".join(risk_lines(state)))
    return 0


def cmd_approve_risk(args: argparse.Namespace) -> int:
    """Append one `RISK APPROVED: <category> <path> by user <date>` line to the lane's .fleet/RISK.md for each
    high-risk path that nothing covers, and record risk_approved. Only after the user said yes."""
    start, top = lane_top(args)
    if not top:
        return refuse(reason=f"{start} is not in a git worktree")
    out = {"lane": top, "by": args.by, **({"base": args.base} if args.base is not None else {})}
    home, home_error = project_lookup(top)
    state = risk_state(top, home, args.base, home_error=home_error)
    if state["error"]:
        return refuse(**out, reason=f"the lane's changes cannot be told ({state['error']}), so there is no path "
                                    "to approve: fix that first (a detached HEAD needs --base <ref>)")
    todo = state["needs_user"]
    if not todo:
        return refuse(**out, reason=f"nothing needs the user: {len(state['matches'])} high-risk "
                                    f"{'match is' if len(state['matches']) == 1 else 'matches are'} covered")
    odd = [m["path"] for m in todo if re.search(r"[\x00-\x1f\x7f]", m["path"])]
    if odd:
        return refuse(**out, reason=f"{plural(len(odd), 'path')} with a control character cannot be written to "
                                    f"{RISK_FILE}", paths=odd[:5])
    lossy = [m["path"] for m in todo if LOSSY_MARK in m["path"]]
    if lossy:
        return refuse(**out, reason=f"{plural(len(lossy), 'path')} with bytes that are not UTF-8 cannot be told "
                                    f"exactly, so {RISK_FILE} cannot record them: rename the file, or cover its "
                                    "category with a plan that the user approved", paths=lossy[:5])
    head = git_text(top, "rev-parse", "--verify", "--quiet", "HEAD")
    if not head or not head.strip():
        return refuse(**out, reason="git cannot resolve HEAD, so the approval cannot name its commit")
    d = Path(prep_dir(top)["fleet_dir"])
    risk_md = d / RISK_FILE
    branch = git_branch(top) or None
    when = now_iso()
    lines = [f"RISK APPROVED: {m['category']} {m['path']} by user {when}" for m in todo]
    if risk_md.is_file():
        old = read_text(risk_md)
        head_text = "" if not old or old.endswith("\n") else "\n"
    else:
        head_text = f"# Risk approvals: {branch or 'detached HEAD'}\n\n"
    with risk_md.open("a") as fh:
        fh.write(head_text + "\n".join(lines) + "\n")
    matches = [{"category": m["category"], "path": m["path"]} for m in todo]
    record("risk_approved", top, lane=top, cwd=top, branch=branch, workspace=os.environ.get("HERDR_WORKSPACE_ID"),
           head=head.strip(), matches=matches, base=args.base)
    print(json.dumps({"ok": True, **out, "branch": branch, "file": str(risk_md), "approved": matches,
                      "lines": lines}, indent=2, ensure_ascii=False))
    return 0


# --------------------------------------------------------------------------
# hook session-start


def latest_review_request(d: Path) -> Path | None:
    def number(p: Path) -> int:
        m = re.search(r"(\d+)", p.stem)
        return int(m.group(1)) if m else -1
    found = sorted(d.glob("REVIEW-REQUEST*.md"), key=number)
    return found[-1] if found else None


def task_rebrief(role: str | None, entry: dict, d: Path, pane: str, what: str) -> str | None:
    """The re-brief of a planner, and of a researcher or helper with a task file; None for any other pane, which
    gets the text it got before these roles existed. It names files and reads none: a researcher's task file
    lives in the project home, and a researcher can work in a checkout without lane files."""
    if role == "planner":
        return (f"Fleet lane: your context was just {what}. You plan this lane (pane {pane}); you do not implement "
                f"it. Re-read {d / 'BRIEF.md'} and your {d / 'PLAN.md'}, change no file except PLAN.md, and continue "
                "the plan. When it is done, end PLAN.md with the next PLAN READY line and stop.")
    task = entry.get("task") if role in TASK_ROLES and isinstance(entry, dict) else None
    if not isinstance(task, str) or not task:
        return None
    if role == "researcher":
        return (f"Fleet research: your context was just {what}. You research one question (pane {pane}); you do "
                f"not implement anything. Re-read your task file {task} and continue it. Write only to that file, "
                "and end it with the line RESEARCH DONE once the answer is complete.")
    return (f"Fleet helper: your context was just {what}. You are a helper (pane {pane}). Re-read your task file "
            f"{task} and continue that task.")


def session_start_context(data: dict, env: dict | None = None, run: HookRun | None = None) -> str | None:
    """Text for a session that starts, was resumed, cleared or compacted: what the hook entry prints for this input
    (one candidate read, then the same decision; cmd_hook takes the candidates before it reads its input).

    A pane that orch candidates name gets one of orch_context's outcomes: the re-brief from the project home on
    every source, the ordinary path, or a short note. Any other pane gets lane_context.
    """
    env = os.environ if env is None else env
    run = run or HookRun()
    try:
        pane, cands = orch_candidates(env)
    except Exception:
        pane, cands = None, []
    if cands:
        return orch_context(data, env, run, pane, cands)[1]
    return lane_context(data, env, run)


def lane_context(data: dict, env, run: HookRun) -> str | None:
    """The ordinary path: text for a session that was just cleared or compacted in a fleet checkout.

    The pane's role comes from .fleet/panes.json (written by `fleet spawn --role`), so a critic or an unrelated
    session in the same checkout is not told that it implements the lane. The checkout's top is the one that git
    confirmed (HookRun.top), else the session's directory; its git calls share the deadline of `run`.
    """
    source = data.get("source")
    if source not in ("clear", "compact"):
        return None
    cwd = data.get("cwd") or os.getcwd()
    top = (run.top(cwd) if isinstance(cwd, str) and os.path.isdir(cwd) else None) or cwd
    d = Path(top) / FLEET_DIR
    if not d.is_dir():
        return None
    present = [f for f in LANE_FILES if (d / f).is_file()]
    pane = env.get("HERDR_PANE_ID") or ""
    panes = load_panes(d)
    role = (panes.get(pane) or {}).get("role") if pane else None
    what = "cleared" if source == "clear" else "compacted"
    parts = []
    rebrief = task_rebrief(role, panes.get(pane) or {}, d, pane, what)
    if rebrief:
        parts.append(rebrief)
    elif present:
        files = ", ".join(str(d / f) for f in present)
        other_impl = any((r or {}).get("role") == "impl" for p, r in panes.items() if p != pane)
        if role == "impl":
            parts.append(
                f"Fleet lane: your context was just {what}. You implement this lane (pane {pane}). Before you act, "
                f"read {files}, then run `git status` and `git log --oneline -15`. Continue from the next step in "
                "STATUS.md; HANDOFF.md, when present, is newer than STATUS.md. Keep STATUS.md current: the next "
                "session resumes from it."
            )
        elif role == "critic":
            request = latest_review_request(d)
            task = (f"re-read your review request {request} and {d / 'BRIEF.md'}, then continue that review"
                    if request else f"re-read {d / 'BRIEF.md'} and wait for a review request")
            parts.append(
                f"Fleet lane: your context was just {what}. You review this lane (pane {pane}); you do not "
                f"implement it. Before you act, {task}. Write findings only to the review file the request "
                "names, and do not edit code."
            )
        elif role:
            parts.append(f"Fleet lane: your context was just {what}. You are this lane's {role} (pane {pane}). "
                         f"Its files are {files}; re-read the ones your task needs before you act.")
        elif not other_impl:
            parts.append(
                f"Fleet lane: your context was just {what}. This worktree has fleet lane files: {files}. If you "
                "implement this lane, read them, run `git status` and `git log --oneline -15`, and continue from "
                "the next step in STATUS.md. If you have another role here, re-read the file that defines your "
                "task before you act."
            )
    fleet_md = d / ORCHESTRATOR_FILE
    if fleet_md.is_file():
        try:
            m = ORCHESTRATOR_LINE.search(fleet_md.read_text(errors="replace"))
        except OSError:
            m = None
        named = m.group(1) if m else None
        if role == "orchestrator" or (named and named == pane):
            parts.append(
                f"Fleet orchestrator: your context was just {what}. Before you act, read {fleet_md} for the lane "
                "table, decisions and next actions. Load the fleet:fleet skill, check the lanes with its status "
                "command, and keep FLEET.md current."
            )
        elif not named:
            parts.append(
                f"This checkout has a fleet record at {fleet_md}. If you orchestrate that fleet, read it before "
                "you act and load the fleet:fleet skill."
            )
    return "\n\n".join(parts) or None


def read_hook_input() -> dict | None:
    """The hook's input: the JSON object on stdin ({} for none, or a terminal). None when stdin cannot be read, is not
    UTF-8, not JSON or not an object."""
    try:
        if sys.stdin is None or sys.stdin.isatty():
            return {}
        buffer = getattr(sys.stdin, "buffer", None)
        raw = buffer.read().decode("utf-8") if buffer is not None else sys.stdin.read()
        data = json.loads(raw) if raw.strip() else {}
    except Exception:
        return None
    return data if isinstance(data, dict) else None


def print_session_start(text: str) -> None:
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": text}}))
    sys.stdout.flush()


def orch_session_start(run: HookRun, pane: str, cands: list[tuple[Path, str, dict]], env) -> dict | None:
    """SessionStart for a pane that the orch candidates `cands` name (the snapshot): it prints the output of one of
    orch_context's outcomes, or the note when the input cannot be read. From here to the output (print and flush
    included), an Exception, SystemExit or KeyboardInterrupt gives the note and no record. Not BaseException: the
    test harness's FakeClockLimit must still end the process. Returns the input to record, or None."""
    try:
        data = read_hook_input()
        if data is None:
            text = orch_note(cands, pane, HOOK_BAD_INPUT, env)
        else:
            text = orch_context(data, env, run, pane, cands)[1]
        if text:
            print_session_start(text)
        return data
    except (Exception, SystemExit, KeyboardInterrupt) as e:
        try:
            print_session_start(orch_note(cands, pane, f"an error in the hook: {type(e).__name__}", env))
        except (Exception, SystemExit, KeyboardInterrupt):
            pass  # the output itself fails: nothing more can reach the session
        return None


def cmd_hook(args: argparse.Namespace) -> int:
    """SessionStart: record the session, and re-brief after /clear or compaction. SessionEnd: record the end.
    All git calls share one deadline, counted from HOOK_STARTED (see HOOK_BUDGET); the re-brief comes first.
    SessionStart reads the orch candidates first, once, before its input (orch_session_start); a pane that none
    names keeps the ordinary behaviour, where an input that cannot be read gives no output."""
    run = HookRun(args.event, start=HOOK_STARTED)
    cands: list[tuple[Path, str, dict]] = []
    if args.event == "session-start":
        try:
            pane, cands = orch_candidates(os.environ)
        except Exception:
            pane, cands = None, []  # no candidate known: the ordinary behaviour
    if cands:
        data = orch_session_start(run, pane, cands, os.environ)
    else:
        data = read_hook_input()
        if data is not None and args.event == "session-start":
            try:
                context = lane_context(data, os.environ, run)
            except Exception:
                context = None
            if context:
                print_session_start(context)
    if data is None:
        return 0
    try:
        hook_session_event("session_start" if args.event == "session-start" else "session_end", data, run=run)
    except Exception:
        pass
    return 0


