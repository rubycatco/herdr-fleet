# CLI


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="fleet", description="Herdr fleet helper (remuda optional).")
    p.add_argument("--version", action="version", version=f"fleet {VERSION}")
    sub = p.add_subparsers(dest="command", required=True)

    d = sub.add_parser("doctor", help="check the environment")
    d.add_argument("--json", action="store_true")
    d.set_defaults(func=cmd_doctor)

    c = sub.add_parser("conventions", help="print the user's fleet conventions (or the plugin defaults)")
    c.add_argument("--path", action="store_true", help="print only the conventions file path")
    c.set_defaults(func=cmd_conventions)

    a = sub.add_parser("accounts", help="remuda accounts and usage")
    a.add_argument("--live", action="store_true", help="query usage live instead of the cache")
    a.set_defaults(func=cmd_accounts)

    pr = sub.add_parser("prep", help="create <git top>/.fleet and keep it out of git")
    pr.add_argument("dir", nargs="?")
    pr.add_argument("--handoff", action="store_true", help="also return the path for a new handoff file")
    pr.set_defaults(func=cmd_prep)

    wa = sub.add_parser("watch", help="wait for a marker in a lane file, or for the agent to stop or block",
                        description="Exit codes: 0 marker found, 4 blocked on a dialog, 5 agent exited or pane gone, "
                                    "6 stopped without the marker, 7 timeout.")
    wa.add_argument("pane")
    wa.add_argument("--marker", help="text to wait for at the start of a line (after list or bold marks), "
                                     "e.g. 'READY FOR REVIEW: round 2'; a mention inside a sentence does not count")
    wa.add_argument("--file", help="file to search, relative to the pane's worktree (default .fleet/STATUS.md)")
    wa.add_argument("--interval", type=float, default=15, help="seconds between checks (default 15)")
    wa.add_argument("--idle-grace", type=float, default=180,
                    help="seconds the agent may sit idle or done without the marker (default 180)")
    wa.add_argument("--blocked-grace", type=float, default=30, help="seconds blocked before reporting (default 30)")
    wa.add_argument("--timeout", type=float, default=14400, help="give up after this many seconds (default 4 h)")
    wa.set_defaults(func=cmd_watch)

    w = sub.add_parser("worktree", help="herdr worktree + workspace for a lane, with .fleet/ ready")
    w.add_argument("branch")
    w.add_argument("--base", help="base ref, e.g. origin/main")
    w.add_argument("--repo", help="repository (default: git top of cwd)")
    w.add_argument("--name", help="workspace label")
    w.add_argument("--orch", help="the orch that owns the lane, in .fleet/lane.json (default: the caller's orch)")
    w.set_defaults(func=cmd_worktree)

    rs = sub.add_parser("reset", help="/clear (or /compact) a claude lane, then make it resume from .fleet/")
    rs.add_argument("pane")
    rs.add_argument("--compact", nargs="?", const="", metavar="FOCUS", help="/compact [FOCUS] instead of /clear")
    rs.add_argument("--message", help="resume prompt (default: read .fleet/ files and continue)")
    rs.add_argument("--no-resume", action="store_true", help="do not send a resume prompt")
    rs.add_argument("--timeout", type=float, default=600, help="seconds to wait for the agent (default 600)")
    rs.set_defaults(func=cmd_reset)

    s = sub.add_parser("spawn", help="open a pane and start an agent in it")
    s.add_argument("--agent", choices=AGENTS, help="default: claude, or the account's provider")
    s.add_argument("--account", help="remuda account (name or provider:name); needs remuda")
    s.add_argument("--model")
    s.add_argument("--effort", help="reasoning effort, e.g. high or max (claude --effort; codex model_reasoning_effort)")
    s.add_argument("--permission-mode", help="claude --permission-mode")
    s.add_argument("--name", help="pane label, and the claude session name")
    s.add_argument("--role", choices=ROLES,
                   help="record the pane's role in .fleet/panes.json (the hook reads it). With impl, or with no "
                        "role, spawn refuses while the lane's .fleet/PLAN.md has no approved newest round")
    s.add_argument("--task", metavar="FILE",
                   help="the pane's task file, kept as an absolute path with its role; after /clear or compaction "
                        "the hook tells a researcher or helper to re-read it (needs --role)")
    s.add_argument("--resume", metavar="SESSION_ID",
                   help="claude only: resume (fork) this session, e.g. on another account that can see it")
    s.add_argument("--prompt", help=f"one-line first prompt (max {PROMPT_MAX} chars), passed as argv")
    where = s.add_mutually_exclusive_group()
    where.add_argument("--split", choices=("auto", "right", "down"), default="auto", help="split a pane (default)")
    where.add_argument("--tab", action="store_true", help="new tab in the workspace")
    where.add_argument("--new-workspace", action="store_true", help="new workspace")
    where.add_argument("--worktree", metavar="BRANCH", help="herdr worktree create for BRANCH (own workspace)")
    where.add_argument("--pane", help="start in this existing shell pane")
    s.add_argument("--from", dest="from_pane", help="pane to split (default: the calling pane)")
    s.add_argument("--workspace", help="workspace for --tab (default: the calling pane's)")
    s.add_argument("--repo", help="repository for --worktree (default: git top of cwd)")
    s.add_argument("--base", help="base ref for --worktree, e.g. origin/main")
    s.add_argument("--orch", help="the orch that owns a new or unowned lane (default: the caller's orch)")
    s.add_argument("--cwd", help="working directory for split/tab/workspace "
                                 "(default: the split pane's directory, else the current one)")
    s.add_argument("--accept-trust", action="store_true", help="accept the agent's folder trust dialog")
    s.add_argument("--no-wait", action="store_true", help="return right after launching")
    s.add_argument("--timeout", type=float, default=120, help="seconds to wait for the agent (default 120)")
    s.add_argument("--dry-run", action="store_true", help="print the launch command only")
    s.add_argument("agent_args", nargs="*", help="arguments after -- go to the agent")
    s.set_defaults(func=cmd_spawn)

    se = sub.add_parser("send", help="submit a prompt to an agent pane and verify it")
    se.add_argument("pane")
    what = se.add_mutually_exclusive_group(required=True)
    what.add_argument("--text", help=f"prompt text; longer than {PROMPT_MAX} chars or multi-line goes via a file")
    what.add_argument("--file", help="send 'Read <file> and follow it.'")
    se.add_argument("--queue", action="store_true", help="send even while the agent works")
    se.add_argument("--timeout", type=float, default=600, help="seconds to wait for a busy agent (default 600)")
    se.set_defaults(func=cmd_send)

    st = sub.add_parser("status", help="agent panes with branch, account and lane files")
    st.add_argument("--workspace")
    st.add_argument("--json", action="store_true")
    st.set_defaults(func=cmd_status)

    r = sub.add_parser("retire", help="exit the agent in a pane")
    r.add_argument("pane")
    r.add_argument("--close", action="store_true", help="close the pane after the agent exits")
    r.add_argument("--force", action="store_true", help="interrupt a working agent before exiting it")
    r.add_argument("--timeout", type=float, default=30)
    r.set_defaults(func=cmd_retire)

    sw = sub.add_parser("sweep", help="every lane with a cleanup verdict: ready, waiting or keep (reads only)")
    sw.add_argument("--json", action="store_true")
    sw.set_defaults(func=cmd_sweep)

    cl = sub.add_parser("cleanup", help="remove lanes: exit agents, archive .fleet/, remove the worktree, "
                                        "delete the merged local branch")
    cl.add_argument("targets", nargs="+", metavar="TARGET", help="a workspace id or a lane path, as fleet sweep prints it")
    cl.add_argument("--unmerged", action="store_true",
                    help="also remove a clean lane whose branch is not merged; the branch stays")
    cl.add_argument("--dry-run", action="store_true", help="print the plan and change nothing")
    cl.add_argument("--timeout", type=float, default=30, help="seconds to wait for each agent to exit")
    cl.add_argument("--orch", help="act as this orch (default: the caller's orch)")
    cl.add_argument("--other-orch", action="store_true",
                    help="also remove a lane whose lane.json names another orch (only for a lane the user picked)")
    cl.set_defaults(func=cmd_cleanup)

    ad = sub.add_parser("adopt", help="set or move the orch that owns a lane (.fleet/lane.json)",
                        description="Each target becomes a lane of the caller's orch (or --orch NAME). A lane of "
                                    "another orch needs --other-orch. A refusal exits 2 and changes nothing.")
    ad.add_argument("targets", nargs="+", metavar="TARGET",
                    help="a workspace id or a lane path, as fleet sweep prints it, or the top of a linked worktree")
    ad.add_argument("--orch", help="the orch that adopts (default: the caller's orch)")
    ad.add_argument("--other-orch", action="store_true", help="move a lane that another orch owns")
    ad.set_defaults(func=cmd_adopt)

    lg = sub.add_parser("log", help="the project's event log, or its agent sessions with transcripts (reads only)")
    lg.add_argument("project", nargs="?", help="a project name (default: the project of this directory)")
    lg.add_argument("--all", action="store_true", help="every project, and the events outside a project")
    lg.add_argument("--lane", help="a branch, workspace id or label, or a path at or above the lane's checkout")
    lg.add_argument("--pane", help="events of this pane, or run from it")
    lg.add_argument("--orch", help="events that name this orch, and the events of its lanes")
    lg.add_argument("--event", help="event kinds, comma-separated: " + ",".join(LOG_EVENTS))
    lg.add_argument("--since", help="30m, 12h, 7d, 2w, or a date such as 2026-11-01")
    lg.add_argument("--limit", type=int, default=50, help="the newest N rows (default 50; 0 for all)")
    lg.add_argument("--sessions", action="store_true", help="one row per agent session, with its transcript")
    lg.add_argument("--json", action="store_true")
    lg.set_defaults(func=cmd_log)

    o = sub.add_parser("orch", help="the project's orchestrators: show, list, claim, rename or release one",
                       description="A project has one orch for each theme, each with a name ('default' for the "
                                   "first). show (the default) prints the caller's orch (the one whose pane is the "
                                   "caller's, else the only one) and the others; list prints them all. claim "
                                   "registers a pane as an orch: --name NEW opens a theme; rename OLD NEW renames one "
                                   "and its lanes; release removes the caller's record.")
    o.add_argument("action", nargs="?", choices=("show", "list", "claim", "rename", "release"), default="show")
    o.add_argument("names", nargs="*", metavar="NAME", help="rename: OLD NEW")
    o.add_argument("--project", help="a project name (default: the project of this directory)")
    o.add_argument("--name", help="claim: the orch's name (default: the caller's own orch, else 'default' in a "
                                  "project with none, else the only orch)")
    o.add_argument("--orch", help="show, release: the orch by name (default: the caller's)")
    o.add_argument("--pane", help="claim: the pane to register (default: the calling pane)")
    o.add_argument("--replace", action="store_true",
                   help="claim: hand the orch over from the registered pane, which must be the caller")
    o.add_argument("--force", action="store_true",
                   help="claim: take over when herdr cannot tell whether the registered pane is alive; "
                        "release: remove the record of another pane")
    o.add_argument("--json", action="store_true", help="show, list: print JSON")
    o.set_defaults(func=cmd_orch)

    b = sub.add_parser("board", help="one row per lane of this project: phase, pull request, panes, newest event",
                       description="Reads herdr, git and gh like sweep, and saves the board to the orch's "
                                   "board.json in the project home. It never moves the digest. In a project with "
                                   "several orchs, an orch's board holds its own lanes and the unowned ones; --all "
                                   "(and a caller that is no orch) shows every lane with an ORCH column. Two signals: "
                                   "a lane whose implementer or planner compacted since its last reset or spawn "
                                   "(`compacted <n>x: fleet reset <pane> at the next commit`), and a lane whose "
                                   "review round numbers reach the conventions' `- Review round limit: <n>` "
                                   "(default 4: `<n> review rounds (limit <m>): ask the user first`). The board never "
                                   "resets a lane and never stops a review.")
    b.add_argument("--project", help="a project name (default: the project of this directory)")
    b.add_argument("--orch", help="the orch whose board this is (default: the caller's orch)")
    b.add_argument("--all", action="store_true", help="every lane of the project, with its orch; saves nothing")
    b.add_argument("--json", action="store_true")
    b.set_defaults(func=cmd_board)

    dg = sub.add_parser("digest", help="phase changes and events since the last digest, then move the cursor",
                        description="Only reads with --peek, when the orch's pane is alive and the caller is "
                                    "another pane, or when the project has several orchs and none is resolved (pass "
                                    "--orch NAME). Each orch has its own cursor; a consuming digest from the orch's "
                                    "pane also records its session for the SessionStart hook.")
    dg.add_argument("--peek", action="store_true", help="read only: record nothing, move nothing")
    dg.add_argument("--project", help="a project name (default: the project of this directory)")
    dg.add_argument("--orch", help="the orch whose digest this is (default: the caller's orch)")
    dg.add_argument("--json", action="store_true")
    dg.set_defaults(func=cmd_digest)

    fu = sub.add_parser("follow-up", help="the project's follow-ups in PROJECT.md: list, add, take, release, done",
                        description="Follow-ups are the list items under ## Follow-ups in the project's PROJECT.md: "
                                    "'- [F7] <text>', and ' (lane: <branch>)' once a lane took one. IDs come from "
                                    "the counter in follow-ups.json in the project home, which only goes up, so an "
                                    "ID is never used twice. Every write runs under the project lock, first gives "
                                    "the lines without an ID their IDs, keeps every other byte of the file, and "
                                    "records an event (follow_up_added, _taken, _released, _done; best effort, as "
                                    "every event, so the history of a removed follow-up can miss a step). A refusal "
                                    "exits 2 and changes nothing. After it removes a lane, `fleet cleanup` closes "
                                    "its follow-ups when its pull request merged, or it is merged and its branch "
                                    "moved since the lane was created (a rebase counts); otherwise, or when git "
                                    "cannot tell (reflog expiry), it releases them.")
    fus = fu.add_subparsers(dest="action", required=True)
    fu_project = argparse.ArgumentParser(add_help=False)
    fu_project.add_argument("--project", help="a project name (default: the project of this directory)")
    ful = fus.add_parser("list", parents=[fu_project], help="ID, text and lane of each follow-up (gives the lines "
                                                            "without an ID their IDs)")
    ful.add_argument("--json", action="store_true")
    fua = fus.add_parser("add", parents=[fu_project], help="add '- [Fn] TEXT' and print its ID")
    fua.add_argument("text")
    fua.add_argument("--source", help="where it comes from, e.g. 'feat/a REVIEW-1.md': adds ' (from SOURCE)'")
    fut = fus.add_parser("take", parents=[fu_project], help="mark the follow-up as taken by a lane")
    fut.add_argument("id", help="F7, f7 or 7")
    fut.add_argument("--lane", required=True, metavar="BRANCH", help="the lane's branch")
    fur = fus.add_parser("release", parents=[fu_project], help="remove the follow-up's lane mark")
    fur.add_argument("id", help="F7, f7 or 7")
    fud = fus.add_parser("done", parents=[fu_project], help="remove the follow-up; its event keeps the text")
    fud.add_argument("id", help="F7, f7 or 7")
    fud.add_argument("--reason", help="why it is done")
    fu.set_defaults(func=cmd_follow_up)

    ap = sub.add_parser("approve-plan", help="approve the newest round of the lane's .fleet/PLAN.md (the plan gate)",
                        description="Appends 'PLAN APPROVED: <n> by <who> <date>' and records plan_approved. It "
                                    "refuses, changing nothing, when PLAN.md is missing, has no 'PLAN READY: <n>' "
                                    "line (for --round N), already approves round n, the worktree has changes "
                                    "outside .fleet/ or existing paths outside it marked assume-unchanged or "
                                    "skip-worktree (an absent skip-worktree path does not count), "
                                    "the lane has commits of its own (or a detached HEAD without "
                                    "--base), or the project's high-risk paths in PROJECT.md cannot be read. With "
                                    "--by orch it also refuses when the Risk: line is not 'none', when ## Files "
                                    "lists no path, or when a path under ## Files matches a high-risk pattern (the "
                                    "built-in migration directories, or the project's ## High-risk paths): such a "
                                    "plan is high risk whatever its Risk: line says. --by user overrides only the "
                                    "risk and the missing files.")
    ap.add_argument("dir", nargs="?", help="the lane's worktree (default: the git top of the current directory)")
    ap.add_argument("--by", choices=("orch", "user"), required=True,
                    help="who approves: user only after the user said yes; a high-risk plan needs it")
    ap.add_argument("--round", type=int, metavar="N", help="the round to approve (default: the newest)")
    ap.add_argument("--base", metavar="REF",
                    help="the lane's base: its own commits are REF..HEAD (default: the commits of HEAD that no tag "
                         "and no branch holds, leaving out the current branch and <remote>/<current branch> on "
                         "each remote); also allows a detached HEAD")
    ap.set_defaults(func=cmd_approve_plan)

    rk = sub.add_parser("risk", help="the lane's changed paths that match a high-risk pattern, and who approved "
                                     "them (reads only)",
                        description="Matches the paths of the lane's own commits and of git status against the "
                                    "built-in migration directories and the project's ## High-risk paths. A match "
                                    "is covered by a plan round that the user approved and that shows its category, "
                                    "or by a RISK APPROVED line in .fleet/RISK.md; the rest needs the user before "
                                    "merge. When the changes cannot be told, the lane needs the user.")
    rk.add_argument("dir", nargs="?", help="the lane's worktree (default: the git top of the current directory)")
    rk.add_argument("--base", metavar="REF", help="the lane's base: its own commits are REF..HEAD (see approve-plan)")
    rk.add_argument("--json", action="store_true")
    rk.set_defaults(func=cmd_risk)

    ar = sub.add_parser("approve-risk", help="record the user's yes for the lane's high-risk paths in .fleet/RISK.md",
                        description="Appends 'RISK APPROVED: <category> <path> by user <date>' for each high-risk "
                                    "path that `risk` says needs the user, and records risk_approved. It refuses, "
                                    "changing nothing, outside a git worktree, when the changes cannot be told, "
                                    "when nothing needs the user, when git cannot resolve HEAD, and when a path that "
                                    "needs the user has a control character or bytes that are not UTF-8. Run it "
                                    "only after the user said yes.")
    ar.add_argument("dir", nargs="?", help="the lane's worktree (default: the git top of the current directory)")
    ar.add_argument("--by", choices=("user",), required=True, help="who approves: only the user can")
    ar.add_argument("--base", metavar="REF", help="the lane's base: its own commits are REF..HEAD (see approve-plan)")
    ar.set_defaults(func=cmd_approve_risk)

    h = sub.add_parser("hook", help="hook handlers")
    h.add_argument("event", choices=("session-start", "session-end"))
    h.set_defaults(func=cmd_hook)
    return p


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    extra: list[str] = []
    if "--" in argv:
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]
    args = build_parser().parse_args(argv)
    if hasattr(args, "agent_args"):
        args.agent_args = list(args.agent_args or []) + extra
    try:
        return args.func(args)
    except FleetError as e:
        print(f"fleet: {e}", file=sys.stderr)
        return e.code


if __name__ == "__main__":
    sys.exit(main())
