{
  "description": "Record fleet sessions in the project's event log, and re-brief a fleet lane or orchestrator from its .fleet/ files after /clear or compaction.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/fleet\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/fleet\" hook session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
