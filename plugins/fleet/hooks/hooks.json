{
  "description": "Re-brief the registered orchestrator pane of a project from its project home at every session start, re-brief a fleet lane or an old FLEET.md orchestrator from its .fleet/ files after /clear or compaction, and record the Claude sessions of Herdr panes in the project's event log.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/fleet\" hook session-start",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$HERDR_PANE_ID\" ] || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/fleet\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$HERDR_PANE_ID\" ] || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/fleet\" hook session-end",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
